<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <%- include('partials/seo-head') %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="stylesheet" href="/css/assistant-widget.css">
</head>
<body class="<%= authorized ? 'portal-app-body' : '' %>">
  <% if (!authorized) { %>
    <%- include('partials/nav') %>
  <% } %>

  <% if (!authorized) { %>
  <main class="portal-shell portal-login">
    <section class="portal-card portal-login-card">
      <div class="hero-badge">Client Portal</div>
      <h1>See what Autovyne is doing for your business.</h1>
      <p class="portal-muted">Log in with your email and the portal password you created during signup, or the access code Autovyne gave you. This gives you a simple customer view, not the internal operations dashboard.</p>
      <% if (error) { %><p class="portal-error"><%= error %></p><% } %>
      <form method="POST" action="/portal/login" class="portal-form">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" required>
        <label for="access_code">Portal Password or Access Code</label>
        <input id="access_code" name="access_code" type="password" required>
        <button class="btn-primary btn-full" type="submit">Open My Dashboard</button>
      </form>
    </section>
  </main>
  <% } else {
    const services = account.services || {};
    const metrics = account.metrics || {};
    const serviceRows = [
      ['AI Calling', services.ai_calling, 'Helps answer missed calls and collect what the customer needs.'],
      ['SMS Follow-up', services.sms_followup, 'Follows up by text only when SMS consent is recorded.'],
      ['CRM Sync', services.crm_sync, 'Moves qualified leads and account updates into your CRM.'],
      ['Automation Workflows', services.n8n_workflows, 'Runs the behind-the-scenes handoffs and notifications.'],
      ['AI Lead Review', services.openai_qualification, 'Summarizes leads and recommends the next best action.'],
    ];
    const automationRows = [
      {
        title: 'Call Activity',
        active: services.ai_calling,
        system: 'Phone + AI routing',
        doing: 'Tracks missed calls, answered calls, caller needs, and handoff notes.',
        controls: 'Request call review, block a caller, or pause follow-up.'
      },
      {
        title: 'Text Follow-up',
        active: services.sms_followup,
        system: 'Consent-based messaging',
        doing: 'Sends approved account or lead follow-up messages only when consent records allow it.',
        controls: 'Request opt-out review, pause texts, or update message rules.'
      },
      {
        title: 'Lead Pipeline',
        active: services.crm_sync,
        system: 'CRM sync',
        doing: 'Keeps lead status, owner follow-up, and customer handoff notes organized.',
        controls: 'Request correction, review a lead, or update routing rules.'
      },
      {
        title: 'Workflow Engine',
        active: services.n8n_workflows,
        system: 'Automation handoffs',
        doing: 'Moves updates between the call system, AI, CRM, notifications, and this portal.',
        controls: 'Request a workflow change without logging into another app.'
      },
      {
        title: 'AI Review',
        active: services.openai_qualification,
        system: 'AI summary layer',
        doing: 'Summarizes activity and helps Autovyne decide what needs attention next.',
        controls: 'Request review if an AI summary or lead outcome looks wrong.'
      },
    ];
    const complianceRows = [
      ['Consent-aware follow-up', 'Texts and automated follow-up should only run where consent or another appropriate basis is recorded.'],
      ['Do-not-contact handling', 'Block and opt-out requests are logged so Autovyne can review and stop follow-up where required.'],
      ['Privacy/data requests', 'Owners can request access, correction, deletion review, or data-handling help from the portal.'],
      ['Sensitive information caution', 'Autovyne should avoid exposing unnecessary call transcripts, payment details, health details, or private customer data in this portal.'],
    ];
    const activeServices = serviceRows.filter(row => row[1]).length;
    const completion = Math.round((activeServices / serviceRows.length) * 100);
    const checklist = onboardingChecklist || { rows: [], doneCount: 0, totalCount: 0, manualCount: 0, statusLabel: status => status };
    const statusLabel = String(account.status || 'setup').replace(/_/g, ' ');
    const billingMethod = account.billing_method || 'automatic';
    const paidAt = account.paid_at ? new Date(account.paid_at).toLocaleDateString() : null;
    const activatedAt = account.activated_at ? new Date(account.activated_at).toLocaleDateString() : null;
    const automationSummary = activeServices
      ? `${activeServices} automation area${activeServices === 1 ? '' : 's'} active`
      : 'Automation setup has not started yet';
    const nextStep = account.status === 'active'
      ? 'Your account is active. Autovyne will keep tracking activity and improving follow-up.'
      : account.status === 'needs_attention'
        ? 'Autovyne is reviewing this account before the next customer-facing update.'
        : account.status === 'paused'
          ? 'This account is paused. Automation will resume after Autovyne reactivates it.'
          : 'Your account is in setup. Autovyne is connecting the tools before activation.';
  %>
  <header class="portal-app-nav" aria-label="Client portal navigation">
    <a href="/portal" class="portal-app-brand">
      <span class="portal-brand-mark">A</span>
      <span>
        <strong>Autovyne</strong>
        <small>Client Portal</small>
      </span>
    </a>
    <div class="portal-app-actions">
      <a class="portal-secondary-btn" href="/questions">Support</a>
      <form method="POST" action="/portal/logout"><button class="portal-secondary-btn" type="submit">Log Out</button></form>
    </div>
  </header>

  <main class="portal-shell portal-shell-app">
    <section class="portal-hero-panel">
      <div>
        <div class="hero-badge">Client Dashboard</div>
        <h1><%= account.business_name %></h1>
        <p class="portal-muted">A simple view of what Autovyne is setting up, what is active, and what has happened recently.</p>
      </div>
      <div class="portal-hero-summary">
        <span><%= completion %>% setup</span>
        <strong><%= activeServices %>/<%= serviceRows.length %></strong>
        <small>Automation areas active</small>
      </div>
    </section>

    <section class="portal-status-strip">
      <article class="portal-card portal-status-card">
        <span>Account Status</span>
        <strong><%= statusLabel %></strong>
        <p><%= nextStep %></p>
      </article>
      <article class="portal-card portal-status-card">
        <span>Plan</span>
        <strong><%= account.plan %></strong>
        <p><%= billingMethod === 'manual' ? 'Manual monthly billing' : 'Automatic monthly billing' %><%= paidAt ? ` - paid ${paidAt}` : '' %></p>
        <% if (billingMethod === 'automatic' && account.stripe_customer_id) { %>
          <form method="POST" action="/portal/billing" style="margin-top:12px"><button class="portal-secondary-btn" type="submit">Manage Billing</button></form>
        <% } %>
      </article>
      <article class="portal-card portal-status-card">
        <span>Setup Progress</span>
        <strong><%= completion %>%</strong>
        <p><%= automationSummary %>.</p>
      </article>
    </section>

    <section class="portal-grid">
      <article class="portal-card portal-metric"><span>Calls Helped</span><strong><%= Number(metrics.calls_handled || 0).toLocaleString() %></strong><p>Calls Autovyne has handled or assisted.</p></article>
      <article class="portal-card portal-metric"><span>Texts Sent</span><strong><%= Number(metrics.sms_sent || 0).toLocaleString() %></strong><p>Approved SMS follow-up messages.</p></article>
      <article class="portal-card portal-metric"><span>Leads Moved</span><strong><%= Number(metrics.crm_leads_synced || 0).toLocaleString() %></strong><p>Leads sent into your CRM workflow.</p></article>
      <article class="portal-card portal-metric"><span>Estimated Recovery</span><strong>$<%= Number(metrics.estimated_revenue_recovered || 0).toLocaleString() %></strong><p>Estimated revenue preserved by follow-up.</p></article>
    </section>

    <section class="portal-card portal-help-card">
      <div>
        <h2>Automation Command Center</h2>
        <p class="portal-muted">You do not need to download or manage the technical apps. This portal shows what each system is doing in plain English and gives you a safe place to request changes.</p>
      </div>
      <div class="portal-help-grid">
        <div><strong>1. Watch</strong><p>See calls, texts, lead movement, and recovered value without logging into separate tools.</p></div>
        <div><strong>2. Control</strong><p>Use Action Center to block callers, pause follow-up, request reviews, or update rules.</p></div>
        <div><strong>3. Prove</strong><p>Requests are logged with dates so there is a clear account history.</p></div>
      </div>
    </section>

    <section class="portal-card">
      <h2>What Is Running Behind the Scenes</h2>
      <p class="portal-muted">These are the jobs Autovyne is handling for your account. The outside apps stay behind the curtain; this is the business-owner version.</p>
      <div class="portal-automation-grid">
        <% automationRows.forEach(function(row) { %>
          <article class="portal-automation-card">
            <div class="portal-automation-top">
              <div>
                <span><%= row.system %></span>
                <strong><%= row.title %></strong>
              </div>
              <span class="portal-pill <%= row.active ? 'portal-pill-on' : 'portal-pill-off' %>"><%= row.active ? 'Active' : 'Setup' %></span>
            </div>
            <p><%= row.doing %></p>
            <small>Owner control: <%= row.controls %></small>
          </article>
        <% }); %>
      </div>
    </section>

    <section class="portal-two-col">
      <article class="portal-card">
        <h2>Action Center</h2>
        <p class="portal-muted">Send Autovyne a safe control request without touching the technical apps. Blocking a caller, pausing follow-up, or changing rules requires review so your account stays compliant.</p>
        <% if (actionError) { %><p class="portal-error"><%= actionError %></p><% } %>
        <% if (actionSuccess) { %><p class="portal-success"><%= actionSuccess %></p><% } %>
        <form method="POST" action="/portal/actions" class="portal-form">
          <label for="request_type">What do you want to do?</label>
          <select id="request_type" name="request_type" required>
            <% (actionOptions || []).forEach(function(option) { %>
              <option value="<%= option.key %>"><%= option.label %></option>
            <% }); %>
          </select>
          <label for="subject_phone">Caller / customer phone number, if this is about one person</label>
          <input id="subject_phone" name="subject_phone" type="tel" placeholder="Example: 555-010-0199">
          <label for="subject_name">Caller / customer name, if known</label>
          <input id="subject_name" name="subject_name" placeholder="Example: Jordan Smith">
          <label for="priority">Priority</label>
          <select id="priority" name="priority">
            <option value="normal">Normal</option>
            <option value="high">High</option>
            <option value="urgent">Urgent - stop/review quickly</option>
          </select>
          <label for="reason">What should Autovyne know?</label>
          <textarea id="reason" name="reason" rows="4" required placeholder="Example: This customer already booked, so do not send follow-up texts or calls."></textarea>
          <button class="btn-primary" type="submit">Submit Control Request</button>
        </form>
        <p class="portal-muted" style="margin-top:14px">Important: submitting a request records it immediately. Autovyne still reviews requests before changing outreach, billing, privacy, or automation settings.</p>
      </article>

      <article class="portal-card">
        <h2>Your Control Requests</h2>
        <p class="portal-muted">A simple history of changes, blocks, reviews, and privacy requests you sent from this portal.</p>
        <% if ((actionRequests || []).length) { %>
          <div class="portal-service-list">
            <% actionRequests.forEach(function(request) { %>
              <div class="portal-service">
                <div>
                  <strong><%= customerActionLabel(request.request_type) %></strong>
                  <p><%= request.reason || 'No note provided.' %></p>
                  <small><%= request.subject_phone ? `Phone: ${request.subject_phone} - ` : '' %><%= new Date(request.created_at).toLocaleString() %></small>
                </div>
                <span class="portal-pill <%= request.priority === 'urgent' || request.priority === 'high' ? 'portal-pill-off' : 'portal-pill-on' %>"><%= request.status %></span>
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <div class="portal-empty">No control requests yet. Use Action Center when something needs to be blocked, reviewed, paused, corrected, or updated.</div>
        <% } %>
      </article>
    </section>

    <section class="portal-two-col">
      <article class="portal-card">
        <h2>Your Automation Setup</h2>
        <p class="portal-muted">Plain-English status for each piece of the system.</p>
        <div class="portal-service-list">
          <% serviceRows.forEach(function(row) { %>
          <div class="portal-service">
            <div>
              <strong><%= row[0] %></strong>
              <p><%= row[2] %></p>
            </div>
            <span class="portal-pill <%= row[1] ? 'portal-pill-on' : 'portal-pill-off' %>"><%= row[1] ? 'Active' : 'Setup' %></span>
          </div>
          <% }); %>
        </div>
      </article>

      <article class="portal-card">
        <h2>Onboarding Checklist</h2>
        <p class="portal-muted"><%= checklist.doneCount %> of <%= checklist.totalCount %> launch steps complete. <%= checklist.manualCount ? `${checklist.manualCount} item(s) need Autovyne review or outside setup.` : 'No manual-review items are currently open in this view.' %></p>
        <div class="portal-service-list">
          <% checklist.rows.forEach(function(row) { %>
            <div class="portal-service">
              <div>
                <strong><%= row.title %></strong>
                <p><%= row.detail %></p>
                <small>Owner: <%= row.owner %><%= row.manual && row.status !== 'done' ? ' - manual review' : '' %></small>
              </div>
              <span class="portal-pill <%= row.status === 'done' ? 'portal-pill-on' : 'portal-pill-off' %>"><%= checklist.statusLabel(row.status) %></span>
            </div>
          <% }); %>
        </div>
      </article>
    </section>

    <section class="portal-two-col">
      <article class="portal-card">
        <h2>Recent Autovyne Updates</h2>
        <p class="portal-muted">Updates Autovyne has marked visible for your account.</p>
        <% if (events.length) { %>
        <div class="portal-timeline">
          <% events.forEach(function(event) { %>
          <div class="portal-event">
            <span></span>
            <div>
              <strong><%= event.title %></strong>
              <p><%= event.detail || event.event_type %></p>
              <small><%= new Date(event.created_at).toLocaleString() %></small>
            </div>
          </div>
          <% }); %>
        </div>
        <% } else { %>
        <div class="portal-empty">No visible activity yet. Once setup work starts, updates will appear here.</div>
        <% } %>
      </article>

      <article class="portal-card">
        <h2>Autovyne Helper</h2>
        <p class="portal-muted">Ask simple questions about your account status, setup progress, control requests, billing visibility, or recent updates. This helper cannot change settings or send messages.</p>
        <form method="POST" action="/portal/assistant" class="portal-form">
          <label for="assistant_question">Question</label>
          <select onchange="this.form.assistant_question.value=this.value">
            <option value="">Choose a common question</option>
            <option value="What is my current account status?">What is my current account status?</option>
            <option value="What has Autovyne finished so far?">What has Autovyne finished so far?</option>
            <option value="What is still being set up?">What is still being set up?</option>
            <option value="Which Action Center request should I submit?">Which Action Center request should I submit?</option>
            <option value="Who do I contact if something needs to change?">Who do I contact if something needs to change?</option>
          </select>
          <textarea id="assistant_question" name="assistant_question" rows="3" placeholder="Example: What is still being set up?"><%= assistantQuestion || '' %></textarea>
          <button class="btn-primary" type="submit">Ask Helper</button>
        </form>
        <% if (assistantResponse) { %>
          <div class="portal-empty" style="white-space:pre-wrap;text-align:left;margin-top:14px"><%= assistantResponse %></div>
        <% } %>
      </article>
    </section>

    <section class="portal-two-col">
      <article class="portal-card">
        <h2>Need Autovyne?</h2>
        <p class="portal-muted">Use this if something looks wrong, your phone number changes, or you want Autovyne to update the automation.</p>
        <div class="portal-help-grid">
          <div><strong>Questions</strong><p>Send setup or support questions through the site.</p><a class="portal-secondary-btn" href="/questions" style="display:inline-block;text-decoration:none;margin-top:8px">Submit a Question</a></div>
          <div><strong>Email</strong><p>Reach Autovyne directly for billing or onboarding help.</p><a class="portal-secondary-btn" href="mailto:kwaun.autovyne@gmail.com" style="display:inline-block;text-decoration:none;margin-top:8px">Email Support</a></div>
        </div>
        <p class="portal-muted" style="margin-top:16px">For privacy and SMS compliance, phone/SMS updates only happen when the right consent records are in place.</p>
      </article>

      <article class="portal-card">
        <h2>Helper Limits</h2>
        <p class="portal-muted">For safety, the customer helper only explains what is visible in this portal. It cannot update billing, change SMS consent, edit workflows, or start/stop automation by itself. Use Action Center for account control requests and Autovyne will review them.</p>
      </article>
    </section>

    <section class="portal-card portal-help-card">
      <div>
        <h2>Compliance-Minded Controls</h2>
        <p class="portal-muted">Autovyne keeps technical and sensitive details in the background. This portal gives you the useful version: status, activity, owner requests, and results.</p>
      </div>
      <div class="portal-help-grid">
        <% complianceRows.slice(0, 3).forEach(function(row) { %>
          <div><strong><%= row[0] %></strong><p><%= row[1] %></p></div>
        <% }); %>
      </div>
      <p class="portal-muted" style="margin-top:16px"><%= complianceRows[3][1] %></p>
    </section>
  </main>
  <% } %>

  <% if (authorized) { %>
    <footer class="portal-app-footer">
      <span>Autovyne client portal</span>
      <a href="mailto:kwaun.autovyne@gmail.com">kwaun.autovyne@gmail.com</a>
      <a href="/privacy">Privacy</a>
      <a href="/sms-terms">SMS Terms</a>
    </footer>
  <% } else { %>
    <%- include('partials/footer') %>
  <% } %>
  <% if (authorized) { %>
    <%- include('partials/assistant-widget', {
      widgetId: 'customer-ai-widget',
      widgetTitle: 'Autovyne Helper',
      widgetSubtitle: 'Customer-level help for this account.',
      widgetEndpoint: '/portal/assistant.json',
      widgetLevel: 'customer',
      widgetPrompts: [
        'What is my current account status?',
        'What has Autovyne finished so far?',
        'Which Action Center request should I submit?',
        'What activity happened recently?'
      ]
    }) %>
    <script src="/js/assistant-widget.js"></script>
  <% } %>
</body>
</html>
