<%
  const reviews = typeof customerReviews !== 'undefined' ? customerReviews : [];
%>
<section class="testimonials-section">
  <div class="testimonials-inner">
    <div class="testimonials-header">
      <div class="testimonials-label">Verified Customer Proof</div>
      <h2>Real customer reviews will live here after customers use Autovyne.</h2>
      <p>Autovyne only shows approved reviews from signed-up users or customers with real service activity. No canned quotes, no pretend case studies.</p>
    </div>

    <% if (reviews.length) { %>
      <div class="testimonials-grid">
        <% reviews.forEach(function(review) { %>
          <article class="testimonial-card">
            <div class="testimonial-proof-row">
              <span>Verified review</span>
              <% if (review.rating) { %><strong><%= review.rating %>/5</strong><% } %>
            </div>
            <div class="testimonial-quote">"<%= review.quote %>"</div>
            <% if (review.outcome_summary) { %><p class="testimonial-outcome"><%= review.outcome_summary %></p><% } %>
            <div class="testimonial-attr">
              <span class="testimonial-name"><%= review.reviewer_name || review.business_name %></span>
              <span class="testimonial-sep">-</span>
              <span class="testimonial-role"><%= review.reviewer_role || review.business_name %></span>
            </div>
          </article>
        <% }); %>
      </div>
    <% } else { %>
      <div class="proof-empty-grid">
        <article class="testimonial-card proof-card">
          <div class="testimonial-proof-row"><span>What shows here</span><strong>Live</strong></div>
          <h3>Approved customer reviews</h3>
          <p>Once a real customer signs up, uses the service, and gives permission, their review can be approved from the admin side and shown here.</p>
        </article>
        <article class="testimonial-card proof-card">
          <div class="testimonial-proof-row"><span>Tracked inside portal</span><strong>Clear</strong></div>
          <h3>Calls, texts, leads, bookings</h3>
          <p>The portal is built to show business owners what activity Autovyne is handling without forcing them to manage technical apps.</p>
        </article>
        <article class="testimonial-card proof-card">
          <div class="testimonial-proof-row"><span>Owner promise</span><strong>Honest</strong></div>
          <h3>No fake social proof</h3>
          <p>This space is reserved for current, past, or present users with real Autovyne history. Until then, the site says exactly that.</p>
        </article>
      </div>
    <% } %>
  </div>
</section>

<style>
.testimonials-section {
  padding: 94px 24px;
  background:
    radial-gradient(circle at 18% 12%, rgba(0,232,123,0.12), transparent 32%),
    linear-gradient(180deg, var(--bg-subtle), #08080d);
}
.testimonials-inner {
  max-width: var(--max-w);
  margin: 0 auto;
}
.testimonials-header {
  max-width: 760px;
  margin: 0 auto 44px;
  text-align: center;
}
.testimonials-label {
  display: inline-block;
  font-family: var(--font-display);
  font-size: 0.76rem;
  font-weight: 700;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: var(--accent);
  margin-bottom: 14px;
}
.testimonials-header h2 {
  font-family: var(--font-display);
  font-size: clamp(1.8rem, 3.5vw, 2.7rem);
  line-height: 1.08;
  font-weight: 700;
  letter-spacing: -0.03em;
  margin: 0;
}
.testimonials-header p {
  color: var(--fg-muted);
  line-height: 1.65;
  margin: 16px auto 0;
}
.testimonials-grid,
.proof-empty-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}
.testimonial-card {
  background: rgba(18,20,28,0.86);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 18px;
  padding: 26px;
  display: flex;
  flex-direction: column;
  gap: 16px;
  box-shadow: 0 24px 80px rgba(0,0,0,0.24);
}
.testimonial-proof-row {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  align-items: center;
}
.testimonial-proof-row span {
  color: var(--fg-muted);
  font-size: .72rem;
  font-weight: 800;
  letter-spacing: .08em;
  text-transform: uppercase;
}
.testimonial-proof-row strong {
  color: var(--accent);
  font-size: .8rem;
}
.testimonial-quote {
  color: var(--fg);
  font-size: 1rem;
  line-height: 1.65;
}
.testimonial-outcome,
.proof-card p {
  color: var(--fg-muted);
  line-height: 1.6;
  margin: 0;
}
.proof-card h3 {
  font-family: var(--font-display);
  font-size: 1.2rem;
  margin: 0;
  letter-spacing: -0.02em;
}
.testimonial-attr {
  display: flex;
  align-items: center;
  gap: 6px;
  flex-wrap: wrap;
  padding-top: 14px;
  border-top: 1px solid rgba(255,255,255,0.07);
  margin-top: auto;
}
.testimonial-name {
  font-family: var(--font-display);
  font-size: 0.9rem;
  font-weight: 700;
  color: var(--fg);
}
.testimonial-sep,
.testimonial-role {
  color: var(--fg-muted);
  font-size: 0.85rem;
}
@media (max-width: 900px) {
  .testimonials-grid,
  .proof-empty-grid { grid-template-columns: 1fr; }
  .testimonials-section { padding: 72px 20px; }
}
</style>
