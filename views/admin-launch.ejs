<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Launch Checklist - Autovyne</title>
  <style>
    *{box-sizing:border-box}body{margin:0;background:#08080d;color:#eff2f7;font:14px 'Space Grotesk',system-ui,sans-serif}.wrap{max-width:1240px;margin:0 auto;padding:32px}.top{display:flex;justify-content:space-between;gap:16px;align-items:flex-start;margin-bottom:22px}.badge{display:inline-block;color:#00e87b;background:rgba(0,232,123,.1);border:1px solid rgba(0,232,123,.22);border-radius:999px;padding:5px 12px;font-size:12px;font-weight:900;text-transform:uppercase;letter-spacing:.08em}h1{font-size:clamp(2rem,4vw,3.3rem);line-height:1.05;margin:14px 0 10px;letter-spacing:-.05em}h2{margin:0 0 14px}.sub,.mini{color:#8a8f9e;line-height:1.6}.actions{display:flex;gap:10px;flex-wrap:wrap}.btn{display:inline-block;border:0;border-radius:11px;padding:11px 14px;background:#00e87b;color:#05070a;font-weight:900;text-decoration:none}.btn-dark{background:#202432;color:#eff2f7}.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin:18px 0}.card{background:#12141c;border:1px solid rgba(255,255,255,.08);border-radius:18px;padding:20px;box-shadow:0 20px 70px rgba(0,0,0,.24)}.stat span{display:block;color:#8a8f9e;font-size:11px;text-transform:uppercase;letter-spacing:.08em;font-weight:800}.stat strong{display:block;font-size:34px;margin-top:6px}.accent{color:#00e87b}.warn{color:#ffd166}.danger{color:#ff6b6b}.table{width:100%;border-collapse:collapse}.table th{color:#8a8f9e;text-align:left;text-transform:uppercase;font-size:11px;letter-spacing:.08em;border-bottom:1px solid rgba(255,255,255,.08);padding:10px}.table td{border-bottom:1px solid rgba(255,255,255,.05);padding:14px 10px;vertical-align:top}.pill{display:inline-block;border-radius:999px;padding:5px 10px;background:#202432;color:#cdd3df;font-weight:800;font-size:12px}.pill-on{background:rgba(0,232,123,.12);color:#00e87b}.pill-warn{background:rgba(255,209,102,.12);color:#ffd166}.two-col{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:18px}.event{padding:10px 0;border-bottom:1px solid rgba(255,255,255,.06)}.event:last-child{border-bottom:0}.checklist{display:grid;gap:10px}.check{padding:12px 14px;border-radius:14px;background:#0a0c12;border:1px solid rgba(255,255,255,.08)}.bar{height:10px;background:#202432;border-radius:999px;overflow:hidden;margin-top:10px}.bar span{display:block;height:100%;background:#00e87b;border-radius:999px}@media(max-width:900px){.grid,.two-col{grid-template-columns:1fr 1fr}.top{flex-direction:column}}@media(max-width:640px){.grid,.two-col{grid-template-columns:1fr}.wrap{padding:18px}.actions .btn{width:100%;text-align:center}}
  </style>
</head>
<body>
  <main class="wrap">
    <section class="top">
      <div>
        <span class="badge">Owner Launch Board</span>
        <h1>Know what is ready before you promote.</h1>
        <p class="sub">A plain-English checklist for payment, AI stack, CRM, SMS compliance, support queue, and customer account readiness.</p>
      </div>
      <div class="actions">
        <a class="btn" href="/admin/accounts">Accounts</a>
        <a class="btn btn-dark" href="/admin/outreach">Outreach</a>
        <a class="btn btn-dark" href="/admin/integrations">Integration Health</a>
        <a class="btn btn-dark" href="/admin/questions">Support Queue</a>
        <a class="btn btn-dark" href="/admin">Admin Hub</a>
      </div>
    </section>

    <% if (typeof error !== 'undefined' && error) { %><div class="card danger"><%= error %></div><% } %>

    <section class="grid">
      <div class="card stat"><span>Ready Checks</span><strong class="accent"><%= readyCount %></strong></div>
      <div class="card stat"><span>Total Checks</span><strong><%= totalCount %></strong></div>
      <div class="card stat"><span>Launch Score</span><strong class="<%= readyCount === totalCount ? 'accent' : 'warn' %>"><%= totalCount ? Math.round((readyCount / totalCount) * 100) : 0 %>%</strong><div class="bar"><span style="width:<%= totalCount ? Math.round((readyCount / totalCount) * 100) : 0 %>%"></span></div></div>
      <div class="card stat"><span>Open Alerts</span><strong class="<%= (incidents || []).length ? 'warn' : 'accent' %>"><%= (incidents || []).length %></strong><p class="mini">Integration failures needing review.</p></div>
    </section>

    <section class="card">
      <h2>Launch Checklist</h2>
      <table class="table">
        <thead><tr><th>Area</th><th>Check</th><th>Status</th><th>What It Means</th><th>Next Move</th></tr></thead>
        <tbody>
          <% rows.forEach(function(row) { %>
            <tr>
              <td><%= row.area %></td>
              <td><strong><%= row.label %></strong></td>
              <td><span class="pill <%= row.ready ? 'pill-on' : 'pill-warn' %>"><%= row.ready ? 'Ready' : 'Review' %></span></td>
              <td class="mini"><%= row.detail %></td>
              <td class="mini"><%= row.next %></td>
            </tr>
          <% }); %>
          <% if (!rows.length) { %><tr><td colspan="5" class="mini">Checklist is not available right now.</td></tr><% } %>
        </tbody>
      </table>
    </section>

    <section class="card">
      <h2>Recent Automation Alerts</h2>
      <% if ((incidents || []).length) { %>
        <table class="table">
          <thead><tr><th>Provider</th><th>Operation</th><th>Severity</th><th>Message</th><th>When</th></tr></thead>
          <tbody>
            <% incidents.forEach(function(incident) { %>
              <tr>
                <td><strong><%= incident.provider %></strong></td>
                <td><%= String(incident.operation || '').replace(/_/g, ' ') %></td>
                <td><span class="pill <%= incident.severity === 'critical' ? 'pill-warn' : '' %>"><%= incident.severity %></span></td>
                <td class="mini"><%= incident.message %></td>
                <td class="mini"><%= new Date(incident.created_at).toLocaleString() %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } else { %>
        <p class="mini">No recent OpenAI, HubSpot, n8n, Stripe, or Twilio failures have been logged. Keep checking this before and after outreach.</p>
      <% } %>
    </section>

    <section class="two-col">
      <div class="card">
        <h2>Daily Owner Routine</h2>
        <div class="checklist">
          <div class="check"><strong>1. Check Launch Score</strong><br><span class="mini">If anything is yellow, open Integration Health or SMS Proof first.</span></div>
          <div class="check"><strong>2. Review Accounts</strong><br><span class="mini">Move setup accounts forward with one-click operations.</span></div>
          <div class="check"><strong>3. Answer Questions</strong><br><span class="mini">Use Support Queue so customer questions do not get lost.</span></div>
          <div class="check"><strong>4. Promote Carefully</strong><br><span class="mini">Start outreach when payments, portal, SMS consent, and core integrations are ready.</span></div>
        </div>
      </div>

      <div class="card">
        <h2>Recent Signals</h2>
        <% (snapshot.leads || []).slice(0,3).forEach(function(lead) { %>
          <div class="event"><strong><%= lead.business_name %></strong><p class="mini">Lead: <%= lead.industry %> - $<%= Number(lead.estimated_monthly_loss || 0).toLocaleString() %> estimated monthly loss</p></div>
        <% }); %>
        <% (snapshot.questions || []).slice(0,3).forEach(function(q) { %>
          <div class="event"><strong><%= q.business_name || q.name %></strong><p class="mini">Question: <%= q.status || 'new' %> - <%= q.category || 'general' %></p></div>
        <% }); %>
        <% if (!(snapshot.leads || []).length && !(snapshot.questions || []).length) { %><p class="mini">No recent leads or questions yet.</p><% } %>
      </div>
    </section>
  </main>
</body>
</html>
