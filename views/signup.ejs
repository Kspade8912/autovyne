<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <%- include('partials/seo-head') %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/theme.css">
</head>
<body>
  <%- include('partials/nav') %>
  <main class="portal-shell">
    <section class="portal-hero-panel">
      <div>
        <div class="hero-badge">Signup + Payment + Onboarding</div>
        <h1>Start Autovyne and activate your portal.</h1>
        <p class="portal-muted">Create your account, pay securely, and Autovyne will automatically approve your portal and start onboarding workflows.</p>
      </div>
      <a class="portal-secondary-btn" href="/demo" style="text-decoration:none">View ROI Demo</a>
    </section>

    <section class="portal-card">
      <h2>What happens after you sign up?</h2>
      <div class="portal-help-grid">
        <div><strong>1. Secure checkout</strong><p>Automatic billing goes through Stripe. Manual billing creates a review request for Autovyne.</p></div>
        <div><strong>2. Portal activation</strong><p>After payment or approval, your client portal opens with your setup status and account activity.</p></div>
        <div><strong>3. AI setup starts</strong><p>Autovyne connects the CLEAR Stack: Calls, Leads, Engagement, Appointments, and Reporting, then updates your portal as each area is ready.</p></div>
      </div>
      <p class="portal-muted" style="margin-top:14px">Text follow-up only starts for contacts with proper consent records. The portal shows progress, not private internal controls.</p>
    </section>

    <section class="portal-card">
      <h2>Choose the monthly plan that matches the setup you want.</h2>
      <p class="portal-muted">All plans are monthly subscriptions. After payment, Autovyne activates the portal, reviews your onboarding details, and starts setup in stages.</p>
      <div class="portal-automation-grid">
        <% Object.keys(planDetails || {}).forEach(function(key) { const detail = planDetails[key]; %>
          <article class="portal-automation-card">
            <div class="portal-automation-top">
              <div>
                <span><%= detail.price %></span>
                <strong><%= plans[key] %></strong>
              </div>
              <span class="portal-pill <%= selectedPlan === key ? 'portal-pill-on' : 'portal-pill-off' %>"><%= selectedPlan === key ? 'Selected' : 'Option' %></span>
            </div>
            <p><%= detail.bestFor %></p>
            <small><%= detail.includes %></small>
          </article>
        <% }); %>
      </div>
    </section>

    <section class="portal-card">
      <% if (error) { %><p class="portal-error"><%= error %></p><% } %>
      <% if (!stripeConfigured) { %>
        <p class="portal-error">Automatic card payments are not live yet. Manual monthly billing requests can still be submitted.</p>
      <% } %>
      <form method="POST" class="portal-form">
        <input type="text" name="_honey" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px;">
        <input type="hidden" name="_form_loaded_at" id="form-loaded-at" value="0">

        <div class="form-row two-col">
          <div class="form-group"><label for="business_name">Business Name</label><input id="business_name" name="business_name" required></div>
          <div class="form-group"><label for="contact_name">Your Name</label><input id="contact_name" name="contact_name" required></div>
        </div>
        <div class="form-row two-col">
          <div class="form-group"><label for="email">Email</label><input type="email" id="email" name="email" required></div>
          <div class="form-group"><label for="phone">Phone</label><input type="tel" id="phone" name="phone"></div>
        </div>
        <div class="form-row two-col">
          <div class="form-group">
            <label for="industry">Industry</label>
            <select id="industry" name="industry" required>
              <option value="" disabled selected>Select industry</option>
              <option value="hvac">HVAC / Plumbing / Electric</option>
              <option value="contractors">Contractors</option>
              <option value="auto">Towing / Automotive</option>
              <option value="restaurant">Restaurant / Hospitality</option>
              <option value="medical">Medical / Dental</option>
              <option value="beauty">Hair / Beauty</option>
              <option value="other">Other</option>
            </select>
          </div>
          <div class="form-group">
            <label for="plan">Plan</label>
            <select id="plan" name="plan" required>
              <% Object.keys(plans).forEach(function(key) { %>
                <option value="<%= key %>" <%= selectedPlan === key ? 'selected' : '' %>><%= plans[key] %></option>
              <% }); %>
            </select>
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="billing_method">Monthly Billing Method</label>
            <select id="billing_method" name="billing_method" required>
              <option value="automatic" <%= selectedBillingMethod !== 'manual' ? 'selected' : '' %>>Automatic monthly card payments</option>
              <option value="manual" <%= selectedBillingMethod === 'manual' ? 'selected' : '' %>>Manual monthly billing</option>
            </select>
            <span class="form-hint">Automatic uses Stripe recurring monthly billing. Manual lets Autovyne follow up and run billing manually.</span>
          </div>
        </div>
        <div class="form-row two-col">
          <div class="form-group"><label for="website_url">Website</label><input id="website_url" name="website_url" placeholder="https://yourbusiness.com"></div>
          <div class="form-group"><label for="current_tools">Current lead, booking, or phone tools</label><input id="current_tools" name="current_tools" placeholder="Example: Jobber, Square, Google Calendar, none"></div>
        </div>
        <div class="portal-card" style="margin:18px 0;background:rgba(255,255,255,.035)">
          <div class="hero-badge">Optional Consultation Builder</div>
          <h2>Tell Autovyne what your business needs most.</h2>
          <p class="portal-muted">Pick what applies, or leave it simple and type your own notes below. Autovyne will use this to recommend the best starting setup and push the details into your portal.</p>

          <div class="sms-consent" style="margin-top:14px">
            <input type="checkbox" id="consultation_requested" name="consultation_requested" value="true">
            <label for="consultation_requested">I want Autovyne to review this with me before setup.</label>
          </div>

          <div class="form-group">
            <label>What do you need help with?</label>
            <div class="portal-help-grid">
              <% (serviceNeeds || []).forEach(function(need) { %>
                <label class="sms-consent" style="align-items:flex-start;margin:0">
                  <input type="checkbox" name="service_needs" value="<%= need.key %>" data-need-label="<%= need.label %>">
                  <span><strong><%= need.label %></strong><br><small><%= need.description %></small></span>
                </label>
              <% }); %>
            </div>
          </div>

          <div id="signup-recommendation" class="portal-empty" style="text-align:left;margin:16px 0">
            Select one or more needs to see Autovyne's recommended starting setup.
          </div>

          <div class="form-row two-col">
            <div class="form-group">
              <label>Where should account updates go?</label>
              <div class="portal-help-grid" style="grid-template-columns:repeat(auto-fit,minmax(150px,1fr))">
                <% (updateChannels || []).forEach(function(channel) { %>
                  <label class="sms-consent" style="margin:0">
                    <input type="checkbox" name="update_channels" value="<%= channel.key %>" <%= channel.key === 'portal' ? 'checked' : '' %>>
                    <span><%= channel.label %></span>
                  </label>
                <% }); %>
              </div>
            </div>
            <div class="form-group">
              <label>Where should new lead updates go?</label>
              <div class="portal-help-grid" style="grid-template-columns:repeat(auto-fit,minmax(150px,1fr))">
                <% (updateChannels || []).forEach(function(channel) { %>
                  <label class="sms-consent" style="margin:0">
                    <input type="checkbox" name="lead_channels" value="<%= channel.key %>" <%= channel.key === 'portal' ? 'checked' : '' %>>
                    <span><%= channel.label %></span>
                  </label>
                <% }); %>
              </div>
            </div>
          </div>

          <div class="form-row two-col">
            <div class="form-group">
              <label>Where should booking updates go?</label>
              <div class="portal-help-grid" style="grid-template-columns:repeat(auto-fit,minmax(150px,1fr))">
                <% (updateChannels || []).forEach(function(channel) { %>
                  <label class="sms-consent" style="margin:0">
                    <input type="checkbox" name="booking_channels" value="<%= channel.key %>" <%= channel.key === 'portal' ? 'checked' : '' %>>
                    <span><%= channel.label %></span>
                  </label>
                <% }); %>
                <label class="sms-consent" style="margin:0">
                  <input type="checkbox" name="booking_channels" value="calendar">
                  <span>Calendar</span>
                </label>
              </div>
            </div>
            <div class="form-group">
              <label for="calendar_provider">Preferred calendar</label>
              <select id="calendar_provider" name="calendar_provider">
                <% (calendarProviders || []).forEach(function(provider) { %>
                  <option value="<%= provider.key %>"><%= provider.label %></option>
                <% }); %>
              </select>
              <span class="form-hint">Autovyne can show appointments in your portal first, then connect Google, Microsoft, Apple, or another calendar during onboarding.</span>
            </div>
          </div>

          <div class="form-row two-col">
            <div class="form-group">
              <label for="calendar_sync_preference">Calendar handling</label>
              <select id="calendar_sync_preference" name="calendar_sync_preference">
                <option value="portal_only">Show bookings in my portal first</option>
                <option value="send_invites">Send calendar invites when ready</option>
                <option value="connect_later">Help me connect my calendar later</option>
              </select>
            </div>
            <div class="form-group">
              <label for="followup_style">Follow-up style</label>
              <select id="followup_style" name="followup_style">
                <% (followupStyles || []).forEach(function(style) { %>
                  <option value="<%= style.key %>"><%= style.label %></option>
                <% }); %>
              </select>
            </div>
          </div>

          <div class="form-row two-col">
            <div class="form-group">
              <label for="followup_approval_mode">Before Autovyne changes follow-up rules</label>
              <select id="followup_approval_mode" name="followup_approval_mode">
                <option value="review_first">Ask me to review first</option>
                <option value="approved_rules">Use the rules I already approved</option>
              </select>
            </div>
            <div class="form-group">
              <label for="followup_stop_when">Stop lead follow-up when</label>
              <select id="followup_stop_when" name="followup_stop_when">
                <option value="booked">The customer books or requests no more contact</option>
                <option value="owner_review">I ask Autovyne to review it</option>
                <option value="after_three_attempts">After three follow-up attempts</option>
              </select>
            </div>
          </div>

          <div class="form-row two-col">
            <div class="form-group">
              <label for="summary_frequency">How often should Autovyne summarize activity?</label>
              <select id="summary_frequency" name="summary_frequency">
                <option value="instant">As soon as something important happens</option>
                <option value="daily" selected>Daily summary</option>
                <option value="weekly">Weekly summary</option>
              </select>
            </div>
            <div class="form-group"><label for="calendar_timezone">Business time zone</label><input id="calendar_timezone" name="calendar_timezone" placeholder="Example: Central Time"></div>
          </div>

          <div class="form-row two-col">
            <div class="form-group"><label for="consultation_best_time">Best time for consultation</label><input id="consultation_best_time" name="consultation_best_time" placeholder="Example: weekdays after 3 PM"></div>
            <div class="form-group"><label for="consultation_notes">Anything Autovyne should know?</label><textarea id="consultation_notes" name="consultation_notes" rows="3" placeholder="Example: I want calls pushed to my phone, bookings on Google Calendar, and no follow-up after someone books."></textarea></div>
          </div>
        </div>
        <div class="form-row">
          <div class="form-group"><label for="onboarding_goal">What should Autovyne automate first?</label><textarea id="onboarding_goal" name="onboarding_goal" rows="5" placeholder="Example: missed calls, text follow-up, booking reminders, lead updates"></textarea></div>
        </div>
        <div class="form-row">
          <div class="form-group"><label for="portal_password">Create Portal Password</label><input type="password" id="portal_password" name="portal_password" minlength="8" required><span class="form-hint">You will use this with your email to log into the client portal after payment.</span></div>
        </div>

        <div class="sms-consent">
          <input type="checkbox" id="sms_consent" name="sms_consent" value="true">
          <label for="sms_consent">By checking this box, I consent to receive SMS messages from Autovyne related to my account, audit request, onboarding, missed-call automation, and service updates. Message frequency varies. Message and data rates may apply. Reply STOP to opt out and HELP for help. Consent is not a condition of purchase. View our <a href="/privacy" target="_blank">Privacy Policy</a> and <a href="/sms-terms" target="_blank">SMS Terms</a>.</label>
        </div>

        <div class="sms-consent">
          <input type="checkbox" id="accept_terms" name="accept_terms" value="true" required>
          <label for="accept_terms">I agree to Autovyne's <a href="/terms" target="_blank">Terms of Service</a>, including the initial one-month minimum service period after payment or manual billing approval. After the first month, service may be canceled before the next billing period according to the posted terms.</label>
        </div>

        <button class="btn-primary btn-large btn-full" type="submit">Continue</button>
        <p class="form-disclaimer">Automatic billing is handled by Stripe as a monthly subscription. Manual billing requests create an account for Autovyne review.</p>
      </form>
    </section>
  </main>
  <%- include('partials/footer') %>
  <script>
    document.getElementById('form-loaded-at')?.setAttribute('value', Date.now());
    (function() {
      const box = document.getElementById('signup-recommendation');
      const planSelect = document.getElementById('plan');
      const needInputs = Array.from(document.querySelectorAll('input[name="service_needs"]'));
      if (!box || !needInputs.length) return;

      function recommendedPlan(needs) {
        const set = new Set(needs);
        if (set.size >= 5 || set.has('calendar_updates') || set.has('review_followup')) return 'Professional';
        if (set.has('lead_tracker') && set.has('appointment_booking')) return 'Professional';
        if (set.has('missed_calls') || set.has('text_updates') || set.has('lead_tracker')) return 'Starter';
        return 'SMB Bundle';
      }

      function renderRecommendation() {
        const selected = needInputs.filter(input => input.checked);
        if (!selected.length) {
          box.textContent = "Select one or more needs to see Autovyne's recommended starting setup.";
          return;
        }
        const labels = selected.map(input => input.getAttribute('data-need-label'));
        const keys = selected.map(input => input.value);
        const selectedPlan = planSelect?.selectedOptions?.[0]?.textContent || recommendedPlan(keys);
        box.innerHTML = '<strong>Recommended starting setup:</strong> ' + recommendedPlan(keys) +
          '<br><span class="portal-muted">You selected ' + labels.join(', ') + '. Autovyne will use this to shape your ' +
          'Calls, Leads, Engagement, Appointments, and Reporting setup. Current plan selection: ' + selectedPlan + '.</span>';
      }

      needInputs.forEach(input => input.addEventListener('change', renderRecommendation));
      planSelect?.addEventListener('change', renderRecommendation);
      renderRecommendation();
    })();
  </script>
</body>
</html>
