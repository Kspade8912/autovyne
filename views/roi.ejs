<script>
// ── INDUSTRY PRESETS ─────────────────────────────────────────────────────────
const PRESETS = {
  'hair-and-beauty':    { leadsMin:10,  leadsMax:300,  leadsDefault:80,  ticketMin:25,  ticketMax:400,  ticketDefault:120,  missedDefault:35, conversionDefault:30 },
  'contractors':        { leadsMin:5,   leadsMax:200,  leadsDefault:25,  ticketMin:100, ticketMax:8000, ticketDefault:400,  missedDefault:40, conversionDefault:25 },
  'towing-and-automotive': { leadsMin:10, leadsMax:300, leadsDefault:60,  ticketMin:75,  ticketMax:1000, ticketDefault:250,  missedDefault:45, conversionDefault:35 },
  'restaurants-and-hospitality': { leadsMin:20, leadsMax:500, leadsDefault:150, ticketMin:20, ticketMax:200, ticketDefault:45, missedDefault:30, conversionDefault:20 },
  'medical-and-dental': { leadsMin:10,  leadsMax:300,  leadsDefault:50,  ticketMin:50,  ticketMax:800,  ticketDefault:150,  missedDefault:35, conversionDefault:40 },
  'hvac':               { leadsMin:5,   leadsMax:400,  leadsDefault:45,  ticketMin:100, ticketMax:5000, ticketDefault:350,  missedDefault:35, conversionDefault:30 },
};

const PLAN_PRICES = [149, 299, 599, 1199];
const PLAN_NAMES   = { 149: 'SMB Bundle', 299: 'Starter', 599: 'Professional', 1199: 'Enterprise' };
const RECOVERY_RATE = 0.35; // 35% of missed leads are recovered by automation

// ── STATE ────────────────────────────────────────────────────────────────────
let state = {
  leads:      80,
  ticket:     120,
  missed:     35,
  conversion: 30,
  planPrice:  299,
  industry:   'hair-and-beauty',
};

// ── HELPERS ─────────────────────────────────────────────────────────────────
function fmt(n) {
  if (n >= 1000) return '$' + (n / 1000).toFixed(n >= 10000 ? 0 : 1) + 'K';
  return '$' + Math.round(n).toLocaleString();
}
function fmtFull(n) { return '$' + Math.round(n).toLocaleString(); }
function fmtPct(n)  { return Math.round(n) + '%'; }

function compute() {
  const missedLeads = state.leads * (state.missed / 100);
  const recovered   = missedLeads * RECOVERY_RATE;
  const monthlyRecovered = recovered * state.ticket * (state.conversion / 100);
  const monthlyCost      = state.planPrice;
  const monthlyNet       = monthlyRecovered - monthlyCost;

  const months = Array.from({ length: 12 }, (_, i) => i + 1);
  const cumulativeCost     = months.map(m => m * monthlyCost);
  const cumulativeRecovered = months.map(m => m * monthlyRecovered);
  const cumulativeNet     = months.map(m => m * monthlyNet);

  // Breakeven: first month where cumulativeNet >= 0
  let breakevenMonth = null;
  for (let i = 0; i < 12; i++) {
    if (cumulativeNet[i] >= 0) { breakevenMonth = i + 1; break; }
  }

  const totalRecovered = monthlyRecovered * 12;
  const totalCost       = monthlyCost * 12;
  const totalSavings    = totalRecovered - totalCost;
  const roi             = totalCost > 0 ? (totalSavings / totalCost) * 100 : 0;

  return { monthlyRecovered, monthlyCost, monthlyNet, totalRecovered, totalCost, totalSavings, roi, breakevenMonth, cumulativeCost, cumulativeRecovered, cumulativeNet };
}

// ── SLIDER DRAG ─────────────────────────────────────────────────────────────
let dragging = null;

function startDrag(e, key) {
  e.preventDefault();
  dragging = key;
  document.addEventListener('mousemove', onMouseMove);
  document.addEventListener('mouseup', stopDrag);
  document.addEventListener('touchmove', onTouchMove, { passive: false });
  document.addEventListener('touchend', stopDrag);
  updateSliderFromEvent(e, key);
}

function onMouseMove(e) {
  if (!dragging) return;
  updateSliderFromEvent(e, dragging);
}

function onTouchMove(e) {
  if (!dragging) return;
  e.preventDefault();
  updateSliderFromEvent(e.touches[0], dragging);
}

function stopDrag() {
  dragging = null;
  document.removeEventListener('mousemove', onMouseMove);
  document.removeEventListener('mouseup', stopDrag);
  document.removeEventListener('touchmove', onTouchMove);
  document.removeEventListener('touchend', stopDrag);
  pushURL();
}

function updateSliderFromEvent(e, key) {
  const track = document.getElementById('track-' + key);
  const rect   = track.getBoundingClientRect();
  // clientX is at top level for both MouseEvent (passed via onmousedown)
  // and Touch objects (passed via onTouchMove as e.touches[0])
  const clientX = e.clientX;
  let pct = (clientX - rect.left) / rect.width;
  pct = Math.max(0, Math.min(1, pct));

  const p = PRESETS[state.industry];
  let val, display;
  if (key === 'leads') {
    val = Math.round(pct * (p.leadsMax - p.leadsMin) + p.leadsMin);
    display = val.toString();
  } else if (key === 'ticket') {
    val = Math.round(p * (p.ticketMax - p.ticketMin) * pct + p.ticketMin);
    display = fmtFull(val);
  } else if (key === 'missed') {
    val = Math.round(p * (80 - 5) * pct + 5);
    display = fmtPct(val);
  } else if (key === 'conversion') {
    val = Math.round(p * (80 - 10) * pct + 10);
    display = fmtPct(val);
  }

  state[key] = val;
  document.getElementById('val-' + key).textContent = display;
  updateSliderUI(key, pct);
  recalc();
}

function updateSliderUI(key, pct) {
  document.getElementById('fill-' + key).style.width = (pct * 100) + '%';
  document.getElementById('thumb-' + key).style.left  = (pct * 100) + '%';
}

function setSliderTo(key, val) {
  const p = PRESETS[state.industry];
  let pct, display;
  if (key === 'leads') {
    pct = (val - p.leadsMin) / (p.leadsMax - p.leadsMin);
    display = val.toString();
  } else if (key === 'ticket') {
    pct = (val - p.ticketMin) / (p.ticketMax - p.ticketMin);
    display = fmtFull(val);
  } else if (key === 'missed') {
    pct = (val - 5) / (80 - 5);
    display = fmtPct(val);
  } else if (key === 'conversion') {
    pct = (val - 10) / (80 - 10);
    display = fmtPct(val);
  }
  document.getElementById('val-' + key).textContent = display;
  updateSliderUI(key, Math.max(0, Math.min(1, pct)));
}

// ── RECALCULATE & RENDER ─────────────────────────────────────────────────────
function recalc() {
  try {
    const r = compute();

    document.getElementById('stat-recovered').textContent = fmtFull(r.totalRecovered);
    document.getElementById('stat-cost').textContent      = fmtFull(r.totalCost);
    document.getElementById('stat-savings').textContent   = fmtFull(Math.max(0, r.totalSavings));
    document.getElementById('stat-roi').textContent      = Math.round(r.roi) + '%';

    const beEl = document.getElementById('stat-breakeven');
    if (r.breakevenMonth) {
      beEl.textContent = 'Month ' + r.breakevenMonth;
      beEl.style.color = 'var(--accent)';
    } else {
      beEl.textContent = 'Not reached in 12mo';
      beEl.style.color = 'var(--danger)';
    }

    drawChart(r);
  } catch(err) {
    console.error('[ROI] recalc error:', err);
  }
}

function drawChart(r) {
  try {
    const canvas = document.getElementById('roi-chart');
    if (!canvas) { console.error('[ROI] canvas not found'); return; }
    const ctx    = canvas.getContext('2d');

    // Use getBoundingClientRect for reliable dimensions — works regardless of width attr vs CSS
    const rect = canvas.getBoundingClientRect();
    const dpr  = window.devicePixelRatio || 1;
    const W = Math.round(rect.width);
    const H = 200;

    if (!W || !H) {
      // Schedule retry after layout settles
      requestAnimationFrame(() => {
        const r2 = canvas.getBoundingClientRect();
        if (r2.width > 0) {
          const dpr2 = window.devicePixelRatio || 1;
          const W2 = Math.round(r2.width);
          canvas.width  = W2 * dpr2;
          canvas.height = 200 * dpr2;
          canvas.style.width  = W2 + 'px';
          canvas.style.height = '200px';
          ctx.scale(dpr2, dpr2);
          drawChartData(ctx, W2, 200, r);
        }
      });
      return;
    }

    canvas.width  = W * dpr;
    canvas.height = H * dpr;
    canvas.style.width  = W + 'px';
    canvas.style.height = H + 'px';
    ctx.scale(dpr, dpr);

    drawChartData(ctx, W, H, r);
  } catch(err) {
    console.error('[ROI] drawChart error:', err);
  }
}

function drawChartData(ctx, W, H, r) {
    const PAD = { top: 16, right: 16, bottom: 32, left: 56 };
    const cw  = W - PAD.left - PAD.right;
    const ch  = H - PAD.top  - PAD.bottom;

    ctx.clearRect(0, 0, W, H);

    // Compute max for Y axis
    const allVals = [
      ...r.cumulativeCost,
      ...r.cumulativeRecovered,
      ...r.cumulativeNet,
    ].map(Math.abs);
    const maxVal = Math.max(...allVals, 1);

    function xPos(m) { return PAD.left + ((m - 1) / 11) * cw; }
    function yPos(v) { return PAD.top + ch - (v / maxVal) * ch; }

    // Grid lines
    ctx.strokeStyle = 'rgba(255,255,255,0.04)';
    ctx.lineWidth   = 1;
    const gridSteps = 4;
    for (let i = 0; i <= gridSteps; i++) {
      const y = PAD.top + (i / gridSteps) * ch;
      ctx.beginPath();
      ctx.moveTo(PAD.left, y);
      ctx.lineTo(PAD.left + cw, y);
      ctx.stroke();
    }
    // X axis grid
    for (let m = 1; m <= 12; m++) {
      const x = xPos(m);
      ctx.beginPath();
      ctx.moveTo(x, PAD.top);
      ctx.lineTo(x, PAD.top + ch);
      ctx.strokeStyle = 'rgba(255,255,255,0.03)';
      ctx.stroke();
    }

    // Y axis labels
    ctx.fillStyle  = 'rgba(138,143,158,0.8)';
    ctx.font       = '11px Space Grotesk, system-ui';
    ctx.textAlign  = 'right';
    ctx.textBaseline = 'middle';
    for (let i = 0; i <= gridSteps; i++) {
      const v = (maxVal * (gridSteps - i) / gridSteps);
      const y = PAD.top + (i / gridSteps) * ch;
      ctx.fillText(fmt(v), PAD.left - 8, y);
    }

    // X axis labels
    ctx.textAlign   = 'center';
    ctx.textBaseline = 'top';
    for (let m = 1; m <= 12; m++) {
      const x = xPos(m);
      ctx.fillText('M' + m, x, PAD.top + ch + 6);
    }

    // Draw net area fill
    function drawArea(data, color) {
      ctx.beginPath();
      ctx.moveTo(xPos(1), yPos(0));
      for (let m = 1; m <= 12; m++) {
        const v = Math.max(0, data[m - 1]);
        ctx.lineTo(xPos(m), yPos(v));
      }
      ctx.lineTo(xPos(12), yPos(0));
      ctx.closePath();
      ctx.fillStyle = color;
      ctx.fill();
    }

    // Net area (green)
    drawArea(r.cumulativeNet, 'rgba(0,232,123,0.12)');

    // Cost line (red)
    ctx.beginPath();
    ctx.moveTo(xPos(1), yPos(r.cumulativeCost[0]));
    for (let m = 2; m <= 12; m++) {
      ctx.lineTo(xPos(m), yPos(r.cumulativeCost[m - 1]));
    }
    ctx.strokeStyle = '#ff4f4f';
    ctx.lineWidth   = 2;
    ctx.setLineDash([]);
    ctx.stroke();

    // Recovered line (green)
    ctx.beginPath();
    ctx.moveTo(xPos(1), yPos(r.cumulativeRecovered[0]));
    for (let m = 2; m <= 12; m++) {
      ctx.lineTo(xPos(m), yPos(r.cumulativeRecovered[m - 1]));
    }
    ctx.strokeStyle = '#00e87b';
    ctx.lineWidth   = 2.5;
    ctx.stroke();

    // Net line (purple)
    ctx.beginPath();
    ctx.moveTo(xPos(1), yPos(Math.max(0, r.cumulativeNet[0])));
    for (let m = 2; m <= 12; m++) {
      ctx.lineTo(xPos(m), yPos(Math.max(0, r.cumulativeNet[m - 1])));
    }
    ctx.strokeStyle = '#a78bfa';
    ctx.lineWidth   = 2;
    ctx.setLineDash([5, 4]);
    ctx.stroke();
    ctx.setLineDash([]);

    // Breakeven marker
    const be = r.breakevenMonth;
    if (be) {
      const bx = xPos(be);
      const by = yPos(0);
      ctx.beginPath();
      ctx.moveTo(bx, PAD.top + ch);
      ctx.lineTo(bx, PAD.top);
      ctx.strokeStyle = 'rgba(0,232,123,0.5)';
      ctx.lineWidth   = 1;
      ctx.setLineDash([4, 3]);
      ctx.stroke();
      ctx.setLineDash([]);

      ctx.fillStyle   = '#00e87b';
      ctx.font        = 'bold 11px Space Grotesk, system-ui';
      ctx.textAlign   = be <= 6 ? 'left' : 'right';
      ctx.textBaseline = 'bottom';
      const labelX = be <= 6 ? bx + 6 : bx - 6;
      ctx.fillText('Breakeven (M' + be + ')', labelX, PAD.top + 4);
    }
}

// ── PLAN CHANGE ─────────────────────────────────────────────────────────────
function onPlanChange() {
  state.planPrice = parseInt(document.getElementById('plan-select').value, 10);
  recalc();
  pushURL();
}

// ── INDUSTRY CHANGE ─────────────────────────────────────────────────────────
function onIndustryChange() {
  const industry = document.getElementById('industry-select').value;
  state.industry = industry;
  const p = PRESETS[industry];

  state.leads      = p.leadsDefault;
  state.ticket     = p.ticketDefault;
  state.missed     = p.missedDefault;
  state.conversion = p.conversionDefault;

  setSliderTo('leads',      p.leadsDefault);
  setSliderTo('ticket',     p.ticketDefault);
  setSliderTo('missed',     p.missedDefault);
  setSliderTo('conversion', p.conversionDefault);

  recalc();
  pushURL();
}

// ── URL ENCODE / DECODE ─────────────────────────────────────────────────────
function pushURL() {
  const params = new URLSearchParams({
    i: state.industry,
    l: state.leads,
    t: state.ticket,
    m: state.missed,
    c: state.conversion,
    p: state.planPrice,
  });
  const url = '/roi?' + params.toString();
  history.replaceState(null, '', url);
  const urlEl = document.getElementById('share-url');
      urlEl.textContent = 'autovyne.com' + url;
  urlEl.title = 'Click to copy — URL is already updated';
}

function copyShareUrl() {
  const url = window.location.href;
  navigator.clipboard.writeText(url).then(function() {
    var btn = document.getElementById('copy-btn');
    btn.textContent = 'Copied!';
    btn.classList.add('copied');
    var urlEl = document.getElementById('share-url');
    urlEl.classList.add('copied');
    setTimeout(function() {
      btn.textContent = 'Copy Link';
      btn.classList.remove('copied');
      urlEl.classList.remove('copied');
    }, 2000);
  });
}

// Click on share URL to copy
document.getElementById('share-url').addEventListener('click', copyShareUrl);

// ── INIT FROM URL ───────────────────────────────────────────────────────────
(function init() {
  const params = new URLSearchParams(window.location.search);
  const p = PRESETS[params.get('i')] || PRESETS['hair-and-beauty'];

  const industry = params.get('i') || 'hair-and-beauty';
  state.industry = industry;
  state.leads    = parseInt(params.get('l'), 10) || p.leadsDefault;
  state.ticket   = parseInt(params.get('t'), 10) || p.ticketDefault;
  state.missed   = parseInt(params.get('m'), 10) || p.missedDefault;
  state.conversion = parseInt(params.get('c'), 10) || p.conversionDefault;
  state.planPrice  = parseInt(params.get('p'), 10) || 299;

  // Set industry select
  var sel = document.getElementById('industry-select');
  sel.value = industry;

  // Set plan select
  var planSel = document.getElementById('plan-select');
  planSel.value = state.planPrice;

  // Set slider UIs
  setSliderTo('leads',      state.leads);
  setSliderTo('ticket',     state.ticket);
  setSliderTo('missed',     state.missed);
  setSliderTo('conversion', state.conversion);

  // Initialize share URL display
  pushURL();

  recalc();
})();

// Responsive chart resize
window.addEventListener('resize', function() {
  recalc();
});
</script>

