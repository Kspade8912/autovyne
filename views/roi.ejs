<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <%- include('partials/seo-head') %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <%- themeCSS %>
  <style>
    /* ---- ROI CALCULATOR PAGE ---- */
    :root {
      --accent: #00e87b;
      --accent-dim: rgba(0, 232, 123, 0.1);
      --accent-glow: rgba(0, 232, 123, 0.25);
      --bg: #09090e;
      --bg-card: #111318;
      --bg-subtle: #0d1017;
      --danger: #ff4f4f;
      --danger-dim: rgba(255, 74, 74, 0.08);
      --fg: #f0f2f7;
      --fg-muted: #8a8f9e;
      --font-display: 'Space Grotesk', system-ui, sans-serif;
      --font-body: 'DM Sans', system-ui, sans-serif;
      --max-w: 1080px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      background: var(--bg);
      color: var(--fg);
      font-family: var(--font-body);
      -webkit-font-smoothing: antialiased;
    }

    /* ---- NAV ---- */
    .roi-nav {
      padding: 20px 32px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid rgba(255,255,255,0.06);
      background: rgba(9,9,14,0.95);
      backdrop-filter: blur(12px);
      position: sticky;
      top: 0;
      z-index: 100;
    }
    .roi-nav-brand {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 1.25rem;
      color: var(--fg);
      text-decoration: none;
    }
    .roi-nav-links {
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .roi-nav-link {
      font-family: var(--font-display);
      font-size: 0.88rem;
      font-weight: 600;
      color: var(--fg-muted);
      text-decoration: none;
      padding: 8px 16px;
      border-radius: 8px;
      transition: color 0.15s, background 0.15s;
    }
    .roi-nav-link:hover { color: var(--fg); background: rgba(255,255,255,0.04); }
    .roi-nav-link--active { color: var(--accent); background: var(--accent-dim); }
    .roi-nav-link--cta {
      background: var(--accent);
      color: #09090e;
      font-weight: 700;
    }
    .roi-nav-link--cta:hover { opacity: 0.85; }

    /* ---- HERO ---- */
    .roi-hero {
      padding: 80px 24px 60px;
      text-align: center;
      background: linear-gradient(170deg, var(--bg) 0%, #0d1117 60%, var(--bg-subtle) 100%);
      position: relative;
      overflow: hidden;
    }
    .roi-hero::before {
      content: '';
      position: absolute;
      top: -180px;
      left: 50%;
      transform: translateX(-50%);
      width: 600px;
      height: 600px;
      background: radial-gradient(circle, rgba(0,232,123,0.12) 0%, transparent 70%);
      pointer-events: none;
    }
    .roi-hero-inner { max-width: 700px; margin: 0 auto; position: relative; }
    .roi-badge {
      display: inline-block;
      font-family: var(--font-display);
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: var(--accent);
      background: var(--accent-dim);
      padding: 5px 16px;
      border-radius: 100px;
      margin-bottom: 24px;
    }
    .roi-hero h1 {
      font-family: var(--font-display);
      font-size: clamp(2rem, 5vw, 3.2rem);
      font-weight: 700;
      line-height: 1.12;
      letter-spacing: -0.025em;
      margin-bottom: 18px;
    }
    .roi-hero h1 .accent { color: var(--accent); }
    .roi-hero-sub {
      font-size: 1.05rem;
      color: var(--fg-muted);
      line-height: 1.7;
      max-width: 560px;
      margin: 0 auto;
    }
    .roi-share-row {
      margin-top: 20px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
    }
    .roi-share-url {
      font-size: 0.82rem;
      color: var(--fg-muted);
      font-family: var(--font-display);
      background: var(--bg-card);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 8px;
      padding: 8px 14px;
      max-width: 340px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      cursor: pointer;
      transition: border-color 0.2s;
    }
    .roi-share-url:hover { border-color: var(--accent); }
    .roi-share-url.copied { border-color: var(--accent); color: var(--accent); }
    .roi-copy-btn {
      background: var(--bg-card);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 8px;
      color: var(--fg-muted);
      font-family: var(--font-display);
      font-size: 0.82rem;
      font-weight: 600;
      padding: 8px 14px;
      cursor: pointer;
      transition: all 0.2s;
    }
    .roi-copy-btn:hover { border-color: var(--accent); color: var(--accent); }
    .roi-copy-btn.copied { border-color: var(--accent); color: var(--accent); }

    /* ---- CALCULATOR SECTION ---- */
    .roi-calc-section {
      padding: 60px 24px;
      background: var(--bg-subtle);
    }
    .roi-calc-inner { max-width: var(--max-w); margin: 0 auto; }

    /* Industry Selector */
    .roi-industry-selector {
      display: flex;
      align-items: center;
      gap: 16px;
      margin-bottom: 40px;
      flex-wrap: wrap;
      justify-content: center;
    }
    .roi-industry-label {
      font-family: var(--font-display);
      font-size: 0.88rem;
      font-weight: 600;
      color: var(--fg-muted);
    }
    .roi-industry-select {
      background: var(--bg-card);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 10px;
      color: var(--fg);
      font-family: var(--font-display);
      font-size: 0.92rem;
      font-weight: 600;
      padding: 10px 16px;
      cursor: pointer;
      outline: none;
      transition: border-color 0.2s;
      min-width: 260px;
    }
    .roi-industry-select:focus { border-color: var(--accent); }
    .roi-industry-select option { background: var(--bg-card); }

    /* Main Grid */
    .roi-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 28px;
      align-items: start;
    }

    /* Sliders Card */
    .roi-sliders-card {
      background: var(--bg-card);
      border: 1px solid rgba(255,255,255,0.07);
      border-radius: 16px;
      padding: 36px 32px;
    }
    .roi-sliders-card h3 {
      font-family: var(--font-display);
      font-size: 0.82rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 1.2px;
      color: var(--fg-muted);
      margin-bottom: 28px;
    }

    /* Slider Row */
    .roi-slider-row {
      margin-bottom: 28px;
    }
    .roi-slider-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 10px;
    }
    .roi-slider-name {
      font-family: var(--font-display);
      font-size: 0.88rem;
      font-weight: 600;
      color: var(--fg);
    }
    .roi-slider-val {
      font-family: var(--font-display);
      font-size: 1rem;
      font-weight: 700;
      color: var(--accent);
      min-width: 60px;
      text-align: right;
    }

    /* Slider Track */
    .roi-slider-track {
      position: relative;
      height: 6px;
      background: rgba(255,255,255,0.06);
      border-radius: 3px;
      cursor: pointer;
      margin-bottom: 8px;
    }
    .roi-slider-fill {
      position: absolute;
      left: 0;
      top: 0;
      height: 100%;
      background: linear-gradient(90deg, rgba(0,232,123,0.5), var(--accent));
      border-radius: 3px;
      pointer-events: none;
      transition: width 0.1s;
    }
    .roi-slider-thumb {
      position: absolute;
      top: 50%;
      transform: translate(-50%, -50%);
      width: 18px;
      height: 18px;
      background: var(--accent);
      border-radius: 50%;
      box-shadow: 0 0 0 3px rgba(0,232,123,0.2);
      cursor: grab;
      transition: box-shadow 0.15s;
    }
    .roi-slider-thumb:hover {
      box-shadow: 0 0 0 5px rgba(0,232,123,0.3);
    }
    .roi-slider-thumb:active { cursor: grabbing; }

    .roi-slider-range {
      display: flex;
      justify-content: space-between;
    }
    .roi-slider-range span {
      font-size: 0.72rem;
      color: var(--fg-muted);
    }

    /* Results Card */
    .roi-results-card {
      background: linear-gradient(160deg, var(--bg-card) 0%, rgba(0,232,123,0.06) 100%);
      border: 1px solid var(--accent-glow);
      border-radius: 16px;
      padding: 36px 32px;
      display: flex;
      flex-direction: column;
      gap: 0;
    }
    .roi-results-card h3 {
      font-family: var(--font-display);
      font-size: 0.82rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 1.2px;
      color: var(--fg-muted);
      margin-bottom: 24px;
      text-align: center;
    }

    /* Summary Stats */
    .roi-stat-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
      margin-bottom: 24px;
    }
    .roi-stat-box {
      background: var(--bg-card);
      border: 1px solid rgba(255,255,255,0.06);
      border-radius: 12px;
      padding: 18px 16px;
      text-align: center;
    }
    .roi-stat-box--highlight {
      border-color: var(--accent-glow);
      background: rgba(0,232,123,0.05);
    }
    .roi-stat-label {
      font-size: 0.72rem;
      font-family: var(--font-display);
      text-transform: uppercase;
      letter-spacing: 0.8px;
      color: var(--fg-muted);
      margin-bottom: 6px;
    }
    .roi-stat-val {
      font-family: var(--font-display);
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--fg);
      line-height: 1;
    }
    .roi-stat-val--accent { color: var(--accent); }
    .roi-stat-val--danger { color: var(--danger); }

    /* Chart Canvas */
    .roi-chart-wrap {
      margin: 0 0 20px;
      background: var(--bg-card);
      border-radius: 12px;
      padding: 16px 12px 8px;
      position: relative;
    }
    .roi-chart-title {
      font-family: var(--font-display);
      font-size: 0.78rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      color: var(--fg-muted);
      text-align: center;
      margin-bottom: 12px;
    }
    #roi-chart { display: block; width: 100%; }
    .roi-chart-legend {
      display: flex;
      justify-content: center;
      gap: 20px;
      margin-top: 8px;
      flex-wrap: wrap;
    }
    .roi-legend-item {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 0.75rem;
      color: var(--fg-muted);
      font-family: var(--font-display);
    }
    .roi-legend-dot {
      width: 10px;
      height: 3px;
      border-radius: 2px;
    }
    .roi-legend-dot--cost { background: #ff4f4f; }
    .roi-legend-dot--recovered { background: var(--accent); }
    .roi-legend-dot--net { background: #a78bfa; }

    /* Breakeven callout */
    .roi-breakeven-callout {
      background: rgba(0,232,123,0.06);
      border: 1px solid var(--accent-glow);
      border-radius: 10px;
      padding: 14px 16px;
      text-align: center;
    }
    .roi-breakeven-callout .label {
      font-size: 0.72rem;
      font-family: var(--font-display);
      text-transform: uppercase;
      letter-spacing: 0.8px;
      color: var(--fg-muted);
      margin-bottom: 4px;
    }
    .roi-breakeven-callout .value {
      font-family: var(--font-display);
      font-size: 1.2rem;
      font-weight: 700;
      color: var(--accent);
    }

    /* Plan Selector in results */
    .roi-plan-selector {
      margin-top: 20px;
    }
    .roi-plan-selector label {
      font-size: 0.82rem;
      font-family: var(--font-display);
      font-weight: 600;
      color: var(--fg-muted);
      display: block;
      margin-bottom: 8px;
    }
    .roi-plan-select {
      width: 100%;
      background: var(--bg-card);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 8px;
      color: var(--fg);
      font-family: var(--font-display);
      font-size: 0.88rem;
      font-weight: 600;
      padding: 10px 14px;
      cursor: pointer;
      outline: none;
      transition: border-color 0.2s;
    }
    .roi-plan-select:focus { border-color: var(--accent); }
    .roi-plan-select option { background: var(--bg-card); }

    /* ---- TIERS SECTION ---- */
    .roi-tiers-section {
      padding: 80px 24px;
      background: var(--bg);
    }
    .roi-tiers-inner { max-width: var(--max-w); margin: 0 auto; }
    .roi-tiers-header { text-align: center; margin-bottom: 48px; }
    .roi-tiers-header h2 {
      font-family: var(--font-display);
      font-size: clamp(1.6rem, 3vw, 2.2rem);
      font-weight: 700;
      letter-spacing: -0.01em;
      margin-bottom: 12px;
    }
    .roi-tiers-header p { font-size: 1rem; color: var(--fg-muted); }
    .roi-packages-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }
    .roi-package-card {
      background: var(--bg-card);
      border: 1px solid rgba(255,255,255,0.07);
      border-radius: 14px;
      padding: 32px 28px;
      display: flex;
      flex-direction: column;
      gap: 12px;
      transition: border-color 0.2s;
    }
    .roi-package-card:hover { border-color: rgba(255,255,255,0.14); }
    .roi-package-card--featured {
      border-color: var(--accent-glow);
      background: linear-gradient(160deg, var(--bg-card) 0%, rgba(0,232,123,0.05) 100%);
    }
    .roi-package-badge {
      position: absolute;
      top: -12px;
      left: 50%;
      transform: translateX(-50%);
      background: var(--accent);
      color: #09090e;
      font-family: var(--font-display);
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.8px;
      text-transform: uppercase;
      padding: 4px 14px;
      border-radius: 100px;
      white-space: nowrap;
    }
    .roi-package-tier {
      font-family: var(--font-display);
      font-size: 0.8rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: var(--fg-muted);
    }
    .roi-package-price {
      font-family: var(--font-display);
      font-size: 1.7rem;
      font-weight: 700;
      color: var(--fg);
    }
    .roi-package-monthly {
      font-size: 0.88rem;
      color: var(--accent);
      font-weight: 600;
      margin-top: -4px;
    }
    .roi-package-desc {
      font-size: 0.88rem;
      color: var(--fg-muted);
      line-height: 1.5;
    }
    .roi-package-features {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 7px;
      flex: 1;
      padding: 0;
      margin: 0;
    }
    .roi-package-features li {
      font-size: 0.84rem;
      color: var(--fg-muted);
      padding-left: 18px;
      position: relative;
    }
    .roi-package-features li::before {
      content: '✓';
      position: absolute;
      left: 0;
      color: var(--accent);
      font-weight: 700;
      font-size: 0.72rem;
    }
    .roi-package-cta {
      display: block;
      text-align: center;
      padding: 12px;
      border-radius: 10px;
      text-decoration: none;
      font-family: var(--font-display);
      font-size: 0.92rem;
      font-weight: 700;
      transition: opacity 0.2s, transform 0.15s;
      margin-top: 4px;
    }
    .roi-package-cta:hover { opacity: 0.85; transform: translateY(-1px); }
    .roi-package-cta--primary { background: var(--accent); color: #09090e; }
    .roi-package-cta--outline {
      background: transparent;
      color: var(--accent);
      border: 1px solid var(--accent-glow);
    }

    /* ---- FINAL CTA ---- */
    .roi-cta-section {
      padding: 100px 24px;
      background: linear-gradient(180deg, var(--bg) 0%, #0d1117 100%);
      text-align: center;
      position: relative;
      overflow: hidden;
    }
    .roi-cta-section::before {
      content: '';
      position: absolute;
      bottom: 60px;
      left: 50%;
      transform: translateX(-50%);
      width: 500px;
      height: 500px;
      background: radial-gradient(circle, var(--accent-glow) 0%, transparent 70%);
      opacity: 0.3;
      pointer-events: none;
    }
    .roi-cta-inner { max-width: 580px; margin: 0 auto; position: relative; }
    .roi-cta-section h2 {
      font-family: var(--font-display);
      font-size: clamp(1.8rem, 3vw, 2.4rem);
      font-weight: 700;
      line-height: 1.2;
      margin-bottom: 16px;
      letter-spacing: -0.01em;
    }
    .roi-cta-section p {
      font-size: 1rem;
      color: var(--fg-muted);
      margin-bottom: 32px;
      line-height: 1.7;
    }
    .roi-cta-btn {
      display: inline-block;
      background: var(--accent);
      color: #09090e;
      font-family: var(--font-display);
      font-size: 1rem;
      font-weight: 700;
      padding: 16px 36px;
      border-radius: 12px;
      text-decoration: none;
      transition: opacity 0.2s, transform 0.15s;
    }
    .roi-cta-btn:hover { opacity: 0.88; transform: translateY(-1px); }
    .roi-cta-note {
      margin-top: 14px;
      font-size: 0.82rem;
      color: var(--fg-muted);
    }
    .roi-cta-trust {
      margin-top: 28px;
      display: flex;
      gap: 24px;
      justify-content: center;
      flex-wrap: wrap;
    }
    .roi-trust-item {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 0.84rem;
      color: var(--fg-muted);
    }
    .roi-trust-dot {
      width: 8px;
      height: 8px;
      background: var(--accent);
      border-radius: 50%;
    }

    /* ---- FOOTER ---- */
    .site-footer {
      padding: 32px 24px;
      border-top: 1px solid rgba(255,255,255,0.06);
    }
    .footer-inner {
      max-width: var(--max-w);
      margin: 0 auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 16px;
    }
    .footer-brand {
      font-family: var(--font-display);
      font-size: 1.1rem;
      font-weight: 700;
      color: var(--fg);
    }
    .footer-tagline { font-size: 0.82rem; color: var(--fg-muted); margin-top: 2px; }
    .footer-contact { display: flex; gap: 20px; }
    .footer-contact-item { font-size: 0.82rem; color: var(--fg-muted); }

    /* ---- RESPONSIVE ---- */
    @media (max-width: 768px) {
      .roi-nav { padding: 14px 20px; }
      .roi-nav-links { gap: 4px; }
      .roi-nav-link { font-size: 0.8rem; padding: 6px 10px; }
      .roi-hero { padding: 60px 20px 48px; }
      .roi-calc-section { padding: 48px 20px; }
      .roi-grid { grid-template-columns: 1fr; }
      .roi-sliders-card, .roi-results-card { padding: 24px 20px; }
      .roi-tiers-section { padding: 60px 20px; }
      .roi-packages-grid { grid-template-columns: 1fr; }
      .roi-cta-section { padding: 80px 20px; }
      .roi-stat-grid { grid-template-columns: 1fr 1fr; }
      .roi-share-url { max-width: 200px; }
    }
    @media (max-width: 480px) {
      .roi-nav-links .roi-nav-link:not(.roi-nav-link--cta):not(.roi-nav-link--active) { display: none; }
      .roi-packages-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
<div class="roi-page">

  <!-- NAV -->
  <nav class="roi-nav">
    <a href="/" class="roi-nav-brand">Autovyne</a>
    <div class="roi-nav-links">
      <a href="/" class="roi-nav-link">Home</a>
      <a href="/roi" class="roi-nav-link roi-nav-link--active">ROI Calculator</a>
      <a href="/signup" class="roi-nav-link roi-nav-link--cta">Sign Up -></a>
    </div>
  </nav>

  <!-- HERO -->
  <section class="roi-hero">
    <div class="roi-hero-inner">
      <div class="roi-badge">AI Lead Recovery Calculator</div>
      <h1>See Exactly What <span class="accent">AI Automation</span> Can Recover</h1>
      <p class="roi-hero-sub">Enter your real numbers. We'll project your 12-month recovery — and show you exactly when automation pays for itself.</p>
      <div class="roi-share-row">
                <div class="roi-share-url" id="share-url" title="Click to copy">autovyne.com/roi</div>
        <button class="roi-copy-btn" id="copy-btn" onclick="copyShareUrl()">Copy Link</button>
      </div>
    </div>
  </section>

  <!-- CALCULATOR -->
  <section class="roi-calc-section">
    <div class="roi-calc-inner">

      <!-- Industry Selector -->
      <div class="roi-industry-selector">
        <span class="roi-industry-label">Your industry:</span>
