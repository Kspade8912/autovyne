<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>SMS Compliance - Autovyne</title>
<style>*{box-sizing:border-box}body{margin:0;background:#0a0a0f;color:#e8e8ed;font:14px system-ui,sans-serif}.wrap{max-width:1400px;margin:auto;padding:32px}.card{background:#14141f;border:1px solid #292938;border-radius:12px;padding:24px}.login{max-width:420px;margin:100px auto}input{width:100%;padding:12px;background:#0a0a0f;color:#fff;border:1px solid #39394a;border-radius:8px}button{margin-top:12px;padding:12px 18px;background:#00e87b;border:0;border-radius:8px;font-weight:700}.table-wrap{overflow:auto}table{width:100%;border-collapse:collapse}th,td{text-align:left;padding:10px;border-bottom:1px solid #292938;vertical-align:top}th{color:#8888a0}.yes{color:#00e87b}.no{color:#ff9d66}.consent{min-width:420px;font-size:12px;color:#aaa}.error{color:#ff6b6b}</style></head>
<body><div class="wrap">
<% if (!authorized) { %><div class="card login"><h1>SMS Compliance Records</h1><% if(error){ %><p class="error"><%= error %></p><% } %><form method="POST"><input type="password" name="key" placeholder="Admin key" required><button>Open Records</button></form></div>
<% } else { %><h1>SMS Consent Records</h1><p>Internal Twilio verification and consent proof. <%= records.length %> recent records.</p><% if(error){ %><p class="error"><%= error %></p><% } %><div class="card table-wrap"><table><thead><tr><th>Recorded</th><th>Consented</th><th>Phone</th><th>Source</th><th>IP</th><th>User Agent</th><th>Exact Consent Text</th></tr></thead><tbody>
<% records.forEach(function(r){ %><tr><td><%= new Date(r.recorded_at).toISOString() %></td><td class="<%= r.consented ? 'yes':'no' %>"><%= r.consented ? 'YES':'NO' %><% if(r.consented_at){ %><br><small><%= new Date(r.consented_at).toISOString() %></small><% } %></td><td><%= r.phone || '-' %></td><td><%= r.form_source %><br><small><%= r.source_record_type || '' %> <%= r.source_record_id || '' %></small></td><td><%= r.ip_address || '-' %></td><td><%= r.user_agent || '-' %></td><td class="consent"><%= r.consent_text %></td></tr><% }); %>
</tbody></table></div><% } %></div></body></html>
