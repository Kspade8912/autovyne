<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Login - Autovyne</title>
  <style>
    *{box-sizing:border-box}body{margin:0;min-height:100vh;background:#08080d;color:#eff2f7;font:15px 'Space Grotesk',system-ui,sans-serif}.wrap{width:min(1120px,calc(100% - 32px));margin:0 auto;padding:64px 0}.card{background:#12141c;border:1px solid rgba(255,255,255,.08);border-radius:20px;padding:30px;box-shadow:0 24px 90px rgba(0,0,0,.32)}.login{max-width:460px;margin:80px auto}.badge{display:inline-block;color:#00e87b;background:rgba(0,232,123,.1);border:1px solid rgba(0,232,123,.22);border-radius:999px;padding:5px 12px;font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:.08em}h1{font-size:clamp(2rem,5vw,3.4rem);line-height:1.05;margin:16px 0 10px;letter-spacing:-.05em}.sub{color:#8a8f9e;line-height:1.65}.err{margin:16px 0;color:#ff9d9d;background:rgba(255,107,107,.12);border:1px solid rgba(255,107,107,.24);border-radius:12px;padding:12px}label{display:block;color:#8a8f9e;font-size:12px;text-transform:uppercase;letter-spacing:.08em;font-weight:800;margin:20px 0 8px}input{width:100%;padding:13px 14px;border-radius:12px;border:1px solid rgba(255,255,255,.12);background:#0a0c12;color:#fff}button,.btn{display:inline-block;border:0;border-radius:11px;padding:12px 16px;background:#00e87b;color:#05070a;font-weight:900;text-decoration:none;cursor:pointer}.btn-dark{background:#202432;color:#eff2f7}.actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:24px}.tile{display:block;background:#12141c;border:1px solid rgba(255,255,255,.08);border-radius:18px;padding:24px;text-decoration:none;color:#eff2f7}.tile:hover{border-color:rgba(0,232,123,.45);transform:translateY(-1px)}.tile small{display:inline-block;color:#00e87b;text-transform:uppercase;letter-spacing:.08em;font-size:11px;font-weight:900;margin-bottom:12px}.tile strong{display:block;font-size:1.2rem;margin-bottom:8px}.tile span{color:#8a8f9e;font-size:.92rem;line-height:1.55}.hub{display:grid;grid-template-columns:1.35fr .65fr;gap:18px;align-items:stretch}.checklist{display:grid;gap:10px;margin-top:18px}.check{padding:12px 14px;border-radius:14px;background:rgba(255,255,255,.035);border:1px solid rgba(255,255,255,.06);color:#cdd3df}.check b{color:#eff2f7}@media(max-width:820px){.grid,.hub{grid-template-columns:1fr}.wrap{padding:36px 0}}
  </style>
</head>
<body>
<% if (!authorized) { %>
  <main class="wrap login">
    <section class="card">
      <span class="badge">Master Admin</span>
      <h1>Autovyne Admin Login</h1>
      <p class="sub">Use your Autovyne admin username and password to open the account command center, analytics, and SMS compliance proof.</p>
      <% if (error) { %><div class="err"><%= error %></div><% } %>
      <form method="POST" action="/admin/login">
        <label for="username">Username</label>
        <input id="username" name="username" type="text" autocomplete="username" required autofocus>
        <label for="password">Password</label>
        <input id="password" name="password" type="password" autocomplete="current-password" required>
        <button type="submit" style="width:100%;margin-top:16px">Log In</button>
      </form>
    </section>
  </main>
<% } else { %>
  <main class="wrap">
    <section class="hub">
      <div class="card">
        <span class="badge">Logged In</span>
        <h1>Autovyne Admin Hub</h1>
        <p class="sub">Your control center for customer accounts, automation status, lead activity, analytics, and SMS compliance proof. Customer portal access stays separate at `/portal`.</p>
        <div class="actions">
          <a class="btn" href="/admin/accounts">Open Account Command Center</a>
          <a class="btn btn-dark" href="/admin/launch">Launch Checklist</a>
          <a class="btn btn-dark" href="/admin/legal-audits">Legal Audits</a>
          <a class="btn btn-dark" href="/admin/questions">Support Queue</a>
          <a class="btn btn-dark" href="/admin/analytics">View Analytics</a>
          <a class="btn btn-dark" href="/admin/integrations">Integration Health</a>
          <form method="POST" action="/admin/logout"><button class="btn-dark" type="submit">Log Out</button></form>
        </div>
      </div>
      <div class="card">
        <span class="badge">Admin Flow</span>
        <div class="checklist">
          <div class="check"><b>1. Account</b><br>Create or update the customer record.</div>
          <div class="check"><b>2. Automations</b><br>Turn on AI calling, SMS, CRM, and workflow services.</div>
      <div class="check"><b>3. Proof</b><br>Check SMS consent, legal audits, and activity before messaging.</div>
        </div>
      </div>
    </section>
    <section class="grid">
      <a class="tile" href="/admin/accounts"><small>Operations</small><strong>Accounts</strong><span>Create clients, update service status, use quick activity presets, and control what customers see.</span></a>
      <a class="tile" href="/admin/launch"><small>Launch</small><strong>Checklist</strong><span>See payment, AI stack, SMS, support, and account readiness in one owner-friendly view.</span></a>
      <a class="tile" href="/admin/questions"><small>Support</small><strong>Questions</strong><span>Review new questions, set urgency, save owner notes, and track follow-up without losing context.</span></a>
      <a class="tile" href="/admin/analytics"><small>Growth</small><strong>Analytics</strong><span>See page views, form submissions, CTA clicks, and demo engagement.</span></a>
      <a class="tile" href="/admin/legal-audits"><small>Review</small><strong>Legal Audit AI</strong><span>Approve or resolve compliance-sensitive findings before account changes happen.</span></a>
      <a class="tile" href="/admin/compliance"><small>Compliance</small><strong>SMS Proof</strong><span>View Twilio opt-in proof records with consent language, timestamp, IP, and user agent.</span></a>
      <a class="tile" href="/admin/integrations"><small>Launch</small><strong>Integration Health</strong><span>Check OpenAI, HubSpot, n8n, Stripe, Supabase, and Twilio readiness without exposing secrets.</span></a>
    </section>
  </main>
<% } %>
</body>
</html>
