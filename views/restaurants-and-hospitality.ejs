<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <%- include('partials/seo-head') %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <%- themeCSS %>
  <style>
    <%- include('partials/vertical-styles') %>
  </style>
</head>
<body>
<div class="vertical-page">

  <!-- NAV -->
  <nav class="vertical-nav">
    <a href="/" class="nav-brand">Autovyne</a>
    <div class="nav-industries">
      <button class="nav-dropdown-btn" onclick="toggleDropdown(this)">Industries ▾</button>
      <div class="nav-dropdown-menu">
        <a href="/hair-and-beauty" class="nav-dropdown-item">Hair &amp; Beauty</a>
        <a href="/contractors" class="nav-dropdown-item">Contractors</a>
        <a href="/towing-and-automotive" class="nav-dropdown-item">Towing &amp; Automotive</a>
        <a href="/restaurants-and-hospitality" class="nav-dropdown-item nav-dropdown-item--active">Restaurants &amp; Hospitality</a>
        <a href="/medical-and-dental" class="nav-dropdown-item">Medical &amp; Dental</a>
        <a href="/hvac" class="nav-dropdown-item">HVAC</a>
      </div>
    </div>
  </nav>

  <!-- HERO -->
  <section class="vertical-hero">
    <div class="vertical-hero-inner">
      <div class="vertical-badge">For Restaurants, Cafes, Catering &amp; Event Venues</div>
      <h1>Restaurants: Stop Losing <span class="accent">$6K/Month</span> to Missed Reservations</h1>
      <p class="vertical-hero-sub">Every unanswered call during dinner service is a lost table worth $80–$400. Autovyne's AI handles reservations, answers FAQs, and captures catering leads — even during your busiest rush.</p>
      <div class="vertical-proof">
        <div class="proof-item">
          <span class="proof-num">70%</span>
          <span class="proof-label">of diners call to book — not just use OpenTable</span>
        </div>
        <div class="proof-item">
          <span class="proof-num">50%</span>
          <span class="proof-label">of restaurant calls go to voicemail during peak hours</span>
        </div>
        <div class="proof-item">
          <span class="proof-num">$7,200</span>
          <span class="proof-label">avg annual revenue lost to missed reservation calls</span>
        </div>
      </div>
      <div class="hero-cta-wrap">
        <a href="/signup" class="btn-primary btn-large">Start Signup -></a>
      </div>
    </div>
  </section>

  <!-- PAIN POINTS -->
  <section class="pain-section">
    <div class="pain-inner">
      <div class="pain-header">
        <h2>The Revenue You're Leaving on the Table</h2>
        <p>During your busiest moments, you can't answer — and that's exactly when customers are calling.</p>
      </div>
      <div class="pain-grid">
        <div class="pain-card">
          <div class="pain-icon">🍽️</div>
          <h3>Dinner Rush = Missed Calls</h3>
          <p>Your busiest hours (6–9pm Friday/Saturday) are when staff can least afford to answer phones. Every missed call is a $80–$400 table that seats somewhere else tonight.</p>
          <div class="pain-stat">$80–$400 per lost reservation call</div>
        </div>
        <div class="pain-card">
          <div class="pain-icon">🎉</div>
          <h3>Catering Leads Slip Away</h3>
          <p>Corporate catering calls are worth $500–$5,000. If they leave a voicemail and you don't call back in 30 minutes, they've already booked your competitor's catering menu.</p>
          <div class="pain-stat">$500–$5,000 per lost catering inquiry</div>
        </div>
        <div class="pain-card">
          <div class="pain-icon">⭐</div>
          <h3>Bad Experiences Go Unaddressed</h3>
          <p>Without automated post-visit follow-up, unhappy guests post 1-star reviews. Happy guests forget to leave any. You lose the reputation battle by default.</p>
          <div class="pain-stat">1 bad review costs ~10 potential customers</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ROI CALCULATOR -->
  <section class="calc-section">
    <div class="calc-inner">
      <div class="calc-header">
        <h2>Calculate Your Revenue at Risk</h2>
        <p>How many reservations and catering calls are you missing during service?</p>
      </div>

      <div class="calc-grid">
        <div class="calc-card">
          <h3>Your Numbers</h3>
          <div class="calc-field">
            <label>Missed calls per week</label>
            <input type="number" id="calc-missed" value="18" min="1" max="500">
            <div class="calc-range"><span>1</span><span>500</span></div>
            <p class="hint">Calls to voicemail during service, peak hours, closed times</p>
          </div>
          <div class="calc-field">
            <label>Average reservation/order value ($)</label>
            <input type="number" id="calc-ticket" value="140" min="20" max="5000" step="5">
            <div class="calc-range"><span>$20</span><span>$5,000</span></div>
            <p class="hint">Party of 4 @ $35/head = $140; catering = much more</p>
          </div>
          <div class="calc-field">
            <label>Call-to-reservation rate (%)</label>
            <input type="number" id="calc-conversion" value="45" min="5" max="100">
            <div class="calc-range"><span>5%</span><span>100%</span></div>
            <p class="hint">Most callers have real intent — avg 40–60% book</p>
          </div>
        </div>

        <div class="calc-result-card">
          <div class="result-header">
            <h3>Monthly Revenue at Risk</h3>
            <div class="result-big" id="result-monthly">$4,536</div>
            <div class="result-period">from missed calls this month alone</div>
          </div>
          <div class="result-divider"></div>
          <div class="result-annual">
            <div class="result-annual-label">Annual Revenue at Risk</div>
            <div class="result-annual-val" id="result-annual">$54,432</div>
            <div class="result-annual-sub">if nothing changes</div>
          </div>
          <p class="result-assumptions" id="calc-assumptions">
            Based on <strong>18 missed calls/week</strong> × <strong>$140 avg value</strong> × <strong>45% conversion</strong> × 4 weeks
          </p>
        </div>
      </div>

      <div class="assumptions-bar">
        <div class="assumption-item">
          <span class="assumption-val">18 calls/week</span>
          <span class="assumption-label">Avg missed during service</span>
        </div>
        <div class="assumption-item">
          <span class="assumption-val">$140/table</span>
          <span class="assumption-label">Restaurant avg check</span>
        </div>
        <div class="assumption-item">
          <span class="assumption-val">45%</span>
          <span class="assumption-label">Call-to-book rate</span>
        </div>
        <div class="assumption-item">
          <span class="assumption-val">50%</span>
          <span class="assumption-label">Peak hour miss rate</span>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICE TIERS -->
  <section class="tiers-section">
    <div class="tiers-inner">
      <div class="tiers-header">
        <h2>AI Automation Built for Restaurants &amp; Hospitality</h2>
        <p>Everything your small business needs to stop missing leads — one simple package.</p>
      </div>

      <div class="packages-grid">
        <!-- SMB BUNDLE — lead entry point, first position -->
        <div class="package-card package-card--smb">
          <div class="package-badge--smb">Best Value</div>
          <div class="package-tier">SMB Bundle</div>
          <div class="package-price">$299<span class="package-price-sub"> launch / $499 regular</span></div>
          <div class="package-monthly">$149/mo launch / $199/mo regular</div>
          <p class="package-desc">Everything your small business needs to stop missing leads — one simple package. No choosing between features.</p>
          <ul class="package-features">
            <li>AI chatbot (lead capture + qualification)</li>
            <li>AI voice receptionist (call handling + routing)</li>
            <li>Email auto-responders</li>
            <li>Scheduling automation</li>
            <li>Basic CRM workflows</li>
            <li>3 integrations</li>
            <li>Monthly performance report</li>
          </ul>
          <a href="/signup?plan=smb-bundle" class="package-cta package-cta--primary">Sign Up -></a>
        </div>

        <div class="package-card">
          <div class="package-tier">Starter</div>
          <div class="package-price">$299<span class="package-price-sub">/month</span></div>
          <p class="package-desc">Never miss a reservation call or catering inquiry — AI answers, captures details, and notifies you instantly.</p>
          <ul class="package-features">
            <li>AI phone answering for reservations &amp; inquiries</li>
            <li>Instant SMS reply to missed calls</li>
            <li>FAQ auto-response (hours, location, menu)</li>
            <li>Lead notification to your phone</li>
            <li>Call logging &amp; inquiry tracking</li>
          </ul>
          <a href="/signup?plan=starter" class="package-cta package-cta--outline">Start with Starter -></a>
        </div>

        <div class="package-card package-card--featured">
          <div class="package-badge">Most Popular</div>
          <div class="package-tier">Professional</div>
          <div class="package-price">$599<span class="package-price-sub">/month</span></div>
          <p class="package-desc">Everything in Starter plus AI reservation booking, catering intake, and post-visit review capture.</p>
          <ul class="package-features">
            <li>Everything in Starter, plus:</li>
            <li>AI reservation booking (syncs to your system)</li>
            <li>Catering lead intake &amp; qualification</li>
            <li>Reservation reminders (24h + 2h)</li>
            <li>Post-visit review requests (Google, Yelp)</li>
            <li>Priority support &amp; monthly check-in</li>
          </ul>
          <a href="/signup?plan=professional" class="package-cta package-cta--primary">Start Professional -></a>
        </div>

        <div class="package-card">
          <div class="package-tier">Enterprise</div>
          <div class="package-price">$1,199<span class="package-price-sub">/month</span></div>
          <p class="package-desc">Full AI for multi-location restaurants and event venues — handles reservations, private events, and catering at scale.</p>
          <ul class="package-features">
            <li>Everything in Professional, plus:</li>
            <li>Multi-location &amp; event venue management</li>
            <li>Private event inquiry &amp; contract intake</li>
            <li>Custom POS/reservation integration (Toast, OpenTable)</li>
            <li>Dedicated onboarding &amp; quarterly review</li>
            <li>SLA guarantee — 99.5% call answer rate</li>
          </ul>
          <a href="/signup?plan=enterprise" class="package-cta package-cta--outline">Get Enterprise -></a>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section">
    <div class="cta-inner">
      <h2>Start Autovyne for Restaurants</h2>
      <p>Create your portal, pay securely, and Autovyne will start onboarding your AI calling, SMS follow-up, and reservation workflows after payment.</p>
      <div class="cta-actions">
        <a href="/signup" class="btn-primary btn-large">Start Signup -></a>
        <span class="cta-note">Takes 10 minutes. Secure payment activates your portal.</span>
      </div>
      <div class="cta-trust">
        <div class="trust-item"><span class="trust-dot"></span> Secure Stripe checkout</div>
        <div class="trust-item"><span class="trust-dot"></span> Custom for your business</div>
        <div class="trust-item"><span class="trust-dot"></span> Results in 24 hours</div>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="site-footer">
    <div class="footer-inner">
      <div>
        <div class="footer-brand">Autovyne</div>
        <div class="footer-tagline">AI automation for local businesses</div>
      </div>
      <div class="footer-contact">
          <span class="footer-contact-item">kwaun.autovyne@gmail.com</span>
          <span class="footer-contact-item">autovyne.com</span>
          <%- include('partials/legal-links') %>
      </div>
    </div>
  </footer>

</div>

<script>
(function() {
  window.toggleDropdown = function(btn) {
    var menu = btn.nextElementSibling;
    var isOpen = menu.classList.contains('open');
    document.querySelectorAll('.nav-dropdown-menu.open').forEach(function(m) { m.classList.remove('open'); });
    if (!isOpen) menu.classList.add('open');
  };
  document.addEventListener('click', function(e) {
    if (!e.target.closest('.nav-industries')) {
      document.querySelectorAll('.nav-dropdown-menu.open').forEach(function(m) { m.classList.remove('open'); });
    }
  });

  var missedEl = document.getElementById('calc-missed');
  var ticketEl = document.getElementById('calc-ticket');
  var convEl   = document.getElementById('calc-conversion');
  var monthlyEl = document.getElementById('result-monthly');
  var annualEl  = document.getElementById('result-annual');
  var assumptionsEl = document.getElementById('calc-assumptions');

  function fmt(n) { return '$' + Math.round(n).toLocaleString(); }

  function calc() {
    var missed  = parseFloat(missedEl.value) || 0;
    var ticket  = parseFloat(ticketEl.value) || 0;
    var conv    = (parseFloat(convEl.value) || 0) / 100;
    var monthly = missed * ticket * conv * 4;
    var annual  = monthly * 12;
    monthlyEl.textContent = fmt(monthly);
    annualEl.textContent  = fmt(annual);
    assumptionsEl.innerHTML = 'Based on <strong>' + Math.round(missed) + ' missed calls/week</strong> × <strong>' + fmt(ticket) + ' avg value</strong> × <strong>' + Math.round(conv * 100) + '% conversion</strong> × 4 weeks';
  }

  [missedEl, ticketEl, convEl].forEach(function(el) { el.addEventListener('input', calc); });
  calc();
})();
</script>

<%- analyticsSnippet %>
</body>
</html>
