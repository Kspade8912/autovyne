<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <%- include('partials/seo-head') %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <%- themeCSS %>
  <style>
    <%- include('partials/vertical-styles') %>
  </style>
</head>
<body>
<div class="vertical-page">

  <!-- NAV -->
  <nav class="vertical-nav">
    <a href="/" class="nav-brand">Autovyne</a>
    <div class="nav-industries">
      <button class="nav-dropdown-btn" onclick="toggleDropdown(this)">Industries ▾</button>
      <div class="nav-dropdown-menu">
        <a href="/hair-and-beauty" class="nav-dropdown-item nav-dropdown-item--active">Hair &amp; Beauty</a>
        <a href="/contractors" class="nav-dropdown-item">Contractors</a>
        <a href="/towing-and-automotive" class="nav-dropdown-item">Towing &amp; Automotive</a>
        <a href="/restaurants-and-hospitality" class="nav-dropdown-item">Restaurants &amp; Hospitality</a>
        <a href="/medical-and-dental" class="nav-dropdown-item">Medical &amp; Dental</a>
        <a href="/hvac" class="nav-dropdown-item">HVAC</a>
      </div>
    </div>
  </nav>

  <!-- HERO -->
  <section class="vertical-hero">
    <div class="vertical-hero-inner">
      <div class="vertical-badge">For Hair Salons, Spas &amp; Beauty Studios</div>
      <h1>Beauty Businesses: Stop Losing <span class="accent">$5K/Month</span> to Missed Bookings</h1>
      <p class="vertical-hero-sub">Every missed call is a lost appointment worth $80–$400. Autovyne's AI captures every inquiry, books appointments 24/7, and sends automated reminders — so your chair stays full, not empty.</p>
      <div class="vertical-proof">
        <div class="proof-item">
          <span class="proof-num">62%</span>
          <span class="proof-label">of clients won't leave a voicemail — they call a competitor</span>
        </div>
        <div class="proof-item">
          <span class="proof-num">40%</span>
          <span class="proof-label">of no-shows never received a reminder</span>
        </div>
        <div class="proof-item">
          <span class="proof-num">$4,800</span>
          <span class="proof-label">avg annual loss per stylist from no-shows alone</span>
        </div>
      </div>
      <div class="hero-cta-wrap">
        <a href="/signup" class="btn-primary btn-large">Start Signup -></a>
      </div>
    </div>
  </section>

  <!-- PAIN POINTS -->
  <section class="pain-section">
    <div class="pain-inner">
      <div class="pain-header">
        <h2>The Problems Every Salon Owner Knows</h2>
        <p>You're losing revenue in three places — and most owners only see one of them.</p>
      </div>
      <div class="pain-grid">
        <div class="pain-card">
          <div class="pain-icon">📞</div>
          <h3>Missed Calls = Lost Bookings</h3>
          <p>When you're with a client and the phone rings, you lose that caller — permanently. They booked somewhere else before the voicemail beeped.</p>
          <div class="pain-stat">$150–$400 per lost booking</div>
        </div>
        <div class="pain-card">
          <div class="pain-icon">🚫</div>
          <h3>No-Shows Kill Your Revenue</h3>
          <p>A 20% no-show rate on a 6-chair salon costs $800–$1,600 per week. Most have no automated reminder system in place at all.</p>
          <div class="pain-stat">$800–$1,600/week in empty chairs</div>
        </div>
        <div class="pain-card">
          <div class="pain-icon">💬</div>
          <h3>DMs &amp; Texts Go Unanswered</h3>
          <p>Clients expect instant replies on Instagram, SMS, and Google. Every message that waits 4 hours loses to the salon that replied in 4 minutes.</p>
          <div class="pain-stat">73% of clients book the first responder</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ROI CALCULATOR -->
  <section class="calc-section">
    <div class="calc-inner">
      <div class="calc-header">
        <h2>Calculate Your Revenue at Risk</h2>
        <p>Enter your actual numbers. We'll show you what you're leaving on the table.</p>
      </div>

      <div class="calc-grid">
        <div class="calc-card">
          <h3>Your Numbers</h3>
          <div class="calc-field">
            <label>Missed calls per week</label>
            <input type="number" id="calc-missed" value="15" min="1" max="500">
            <div class="calc-range"><span>1</span><span>500</span></div>
            <p class="hint">Calls that go to voicemail or ring unanswered</p>
          </div>
          <div class="calc-field">
            <label>Average booking value ($)</label>
            <input type="number" id="calc-ticket" value="120" min="20" max="2000" step="5">
            <div class="calc-range"><span>$20</span><span>$2,000</span></div>
            <p class="hint">Haircuts $60–$150, color $150–$400, extensions $300–$800</p>
          </div>
          <div class="calc-field">
            <label>Call-to-book rate (%)</label>
            <input type="number" id="calc-conversion" value="40" min="5" max="100">
            <div class="calc-range"><span>5%</span><span>100%</span></div>
            <p class="hint">Industry avg: 35–55% of callers intend to book</p>
          </div>
        </div>

        <div class="calc-result-card">
          <div class="result-header">
            <h3>Monthly Revenue at Risk</h3>
            <div class="result-big" id="result-monthly">$2,880</div>
            <div class="result-period">from missed bookings this month alone</div>
          </div>
          <div class="result-divider"></div>
          <div class="result-annual">
            <div class="result-annual-label">Annual Revenue at Risk</div>
            <div class="result-annual-val" id="result-annual">$34,560</div>
            <div class="result-annual-sub">if nothing changes</div>
          </div>
          <p class="result-assumptions" id="calc-assumptions">
            Based on <strong>15 missed calls/week</strong> × <strong>$120 avg booking</strong> × <strong>40% conversion</strong> × 4 weeks
          </p>
        </div>
      </div>

      <div class="assumptions-bar">
        <div class="assumption-item">
          <span class="assumption-val">15 calls/week</span>
          <span class="assumption-label">Industry avg missed</span>
        </div>
        <div class="assumption-item">
          <span class="assumption-val">$120/booking</span>
          <span class="assumption-label">Beauty avg ticket</span>
        </div>
        <div class="assumption-item">
          <span class="assumption-val">40%</span>
          <span class="assumption-label">Call-to-book rate</span>
        </div>
        <div class="assumption-item">
          <span class="assumption-val">20%</span>
          <span class="assumption-label">Avg no-show rate</span>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICE TIERS -->
  <section class="tiers-section">
    <div class="tiers-inner">
      <div class="tiers-header">
        <h2>AI Automation Built for Beauty</h2>
        <p>Everything your small business needs to stop missing leads — one simple package.</p>
      </div>

      <div class="packages-grid">
        <!-- SMB BUNDLE — lead entry point, first position -->
        <div class="package-card package-card--smb">
          <div class="package-badge--smb">Best Value</div>
          <div class="package-tier">SMB Bundle</div>
          <div class="package-price">$149<span class="package-price-sub">/month</span></div>
          <div class="package-monthly">Monthly subscription</div>
          <p class="package-desc">Everything your small business needs to stop missing leads — one simple package. No choosing between features.</p>
          <ul class="package-features">
            <li>AI chatbot (lead capture + qualification)</li>
            <li>AI voice receptionist (call handling + routing)</li>
            <li>Email auto-responders</li>
            <li>Scheduling automation</li>
            <li>Basic CRM workflows</li>
            <li>3 integrations</li>
            <li>Monthly performance report</li>
          </ul>
          <a href="/signup?plan=smb-bundle" class="package-cta package-cta--primary">Sign Up -></a>
        </div>

        <div class="package-card">
          <div class="package-tier">Starter</div>
          <div class="package-price">$299<span class="package-price-sub">/month</span></div>
          <p class="package-desc">Capture every missed call and web inquiry automatically — no more lost bookings.</p>
          <ul class="package-features">
            <li>AI receptionist answers missed calls 24/7</li>
            <li>Instant SMS reply to missed calls</li>
            <li>Web chat widget for website visitors</li>
            <li>Lead notification to your phone instantly</li>
            <li>Client inquiry logging</li>
          </ul>
          <a href="/signup?plan=starter" class="package-cta package-cta--outline">Start with Starter -></a>
        </div>

        <div class="package-card package-card--featured">
          <div class="package-badge">Most Popular</div>
          <div class="package-tier">Professional</div>
          <div class="package-price">$599<span class="package-price-sub">/month</span></div>
          <p class="package-desc">Everything in Starter plus AI booking and automated reminders that cut no-shows by 60%.</p>
          <ul class="package-features">
            <li>Everything in Starter, plus:</li>
            <li>AI booking — syncs to your calendar</li>
            <li>Automated reminder sequences (48h + 2h)</li>
            <li>Post-appointment review requests</li>
            <li>Instagram &amp; Google DM auto-response</li>
            <li>Priority support &amp; monthly check-in</li>
          </ul>
          <a href="/signup?plan=professional" class="package-cta package-cta--primary">Start Professional -></a>
        </div>

        <div class="package-card">
          <div class="package-tier">Enterprise</div>
          <div class="package-price">$1,199<span class="package-price-sub">/month</span></div>
          <p class="package-desc">Full AI system for multi-location salons — handles scheduling, rebooking, and client comms at scale.</p>
          <ul class="package-features">
            <li>Everything in Professional, plus:</li>
            <li>Multi-location &amp; multi-stylist management</li>
            <li>AI-powered rebooking campaigns</li>
            <li>Custom CRM integration (Vagaro, Mindbody)</li>
            <li>Dedicated onboarding &amp; quarterly review</li>
            <li>SLA guarantee — 99.5% response rate</li>
          </ul>
          <a href="/signup?plan=enterprise" class="package-cta package-cta--outline">Get Enterprise -></a>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section">
    <div class="cta-inner">
      <h2>Start Autovyne for Hair &amp; Beauty</h2>
      <p>Create your portal, pay securely, and Autovyne will start onboarding your AI booking, SMS follow-up, and customer automation after payment.</p>
      <div class="cta-actions">
        <a href="/signup" class="btn-primary btn-large">Start Signup -></a>
        <span class="cta-note">Takes 10 minutes. Secure payment activates your portal.</span>
      </div>
      <div class="cta-trust">
        <div class="trust-item"><span class="trust-dot"></span> Secure Stripe checkout</div>
        <div class="trust-item"><span class="trust-dot"></span> Custom for your business</div>
        <div class="trust-item"><span class="trust-dot"></span> Results in 24 hours</div>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="site-footer">
    <div class="footer-inner">
      <div>
        <div class="footer-brand">Autovyne</div>
        <div class="footer-tagline">AI automation for local businesses</div>
      </div>
      <div class="footer-contact">
          <span class="footer-contact-item">kwaun.autovyne@gmail.com</span>
          <span class="footer-contact-item">autovyne.com</span>
          <%- include('partials/legal-links') %>
      </div>
    </div>
  </footer>

</div>

<script>
(function() {
  // Dropdown toggle
  window.toggleDropdown = function(btn) {
    var menu = btn.nextElementSibling;
    var isOpen = menu.classList.contains('open');
    document.querySelectorAll('.nav-dropdown-menu.open').forEach(function(m) { m.classList.remove('open'); });
    if (!isOpen) menu.classList.add('open');
  };
  document.addEventListener('click', function(e) {
    if (!e.target.closest('.nav-industries')) {
      document.querySelectorAll('.nav-dropdown-menu.open').forEach(function(m) { m.classList.remove('open'); });
    }
  });

  // ROI calculator
  var missedEl = document.getElementById('calc-missed');
  var ticketEl = document.getElementById('calc-ticket');
  var convEl   = document.getElementById('calc-conversion');
  var monthlyEl = document.getElementById('result-monthly');
  var annualEl  = document.getElementById('result-annual');
  var assumptionsEl = document.getElementById('calc-assumptions');

  function fmt(n) { return '$' + Math.round(n).toLocaleString(); }

  function calc() {
    var missed  = parseFloat(missedEl.value) || 0;
    var ticket  = parseFloat(ticketEl.value) || 0;
    var conv    = (parseFloat(convEl.value) || 0) / 100;
    var monthly = missed * ticket * conv * 4;
    var annual  = monthly * 12;
    monthlyEl.textContent = fmt(monthly);
    annualEl.textContent  = fmt(annual);
    assumptionsEl.innerHTML = 'Based on <strong>' + Math.round(missed) + ' missed calls/week</strong> × <strong>' + fmt(ticket) + ' avg booking</strong> × <strong>' + Math.round(conv * 100) + '% conversion</strong> × 4 weeks';
  }

  [missedEl, ticketEl, convEl].forEach(function(el) { el.addEventListener('input', calc); });
  calc();
})();
</script>

<%- analyticsSnippet %>
</body>
</html>
