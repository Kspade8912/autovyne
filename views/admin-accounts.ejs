<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Account Command Center - Autovyne</title>
  <style>
    *{box-sizing:border-box}body{margin:0;background:#08080d;color:#eff2f7;font:14px 'Space Grotesk',system-ui,sans-serif}.wrap{max-width:1400px;margin:0 auto;padding:32px}.top{display:flex;justify-content:space-between;gap:16px;align-items:center;margin-bottom:24px}.sub{color:#8a8f9e}.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:20px}.card{background:#12141c;border:1px solid rgba(255,255,255,.08);border-radius:14px;padding:20px}.stat span,.metric span{display:block;color:#8a8f9e;font-size:12px;text-transform:uppercase;letter-spacing:.08em}.stat strong,.metric strong{display:block;font-size:28px;margin-top:6px}.accent{color:#00e87b}.warn{color:#ffd166}.danger{color:#ff6b6b}.cols{display:grid;grid-template-columns:420px 1fr;gap:18px;align-items:start}.login{max-width:420px;margin:120px auto}.login h1{margin-top:0}label{display:block;color:#8a8f9e;font-size:12px;margin:12px 0 6px}input,select,textarea{width:100%;padding:10px 12px;border-radius:9px;border:1px solid rgba(255,255,255,.12);background:#0a0c12;color:#fff}textarea{min-height:90px;resize:vertical}.checks{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:12px 0}.check{display:flex;gap:8px;align-items:center;background:#0a0c12;border:1px solid rgba(255,255,255,.08);border-radius:9px;padding:9px}.check input{width:auto}.btn{display:inline-block;border:0;border-radius:10px;padding:11px 14px;background:#00e87b;color:#05070a;font-weight:800;cursor:pointer;text-decoration:none}.btn-secondary{background:#202432;color:#eff2f7}.msg{padding:12px;border-radius:10px;margin-bottom:14px}.err{background:rgba(255,107,107,.12);color:#ff9d9d}.ok{background:rgba(0,232,123,.1);color:#00e87b}.table-wrap{overflow:auto}.table{width:100%;border-collapse:collapse}.table th{color:#8a8f9e;text-align:left;text-transform:uppercase;font-size:11px;letter-spacing:.08em;border-bottom:1px solid rgba(255,255,255,.08);padding:9px}.table td{border-bottom:1px solid rgba(255,255,255,.04);padding:10px;vertical-align:top}.pill{display:inline-block;border-radius:999px;padding:3px 9px;background:#202432;color:#cdd3df;font-size:12px}.pill-on{background:rgba(0,232,123,.12);color:#00e87b}.section-title{display:flex;justify-content:space-between;align-items:center;margin:0 0 12px}.section-title h2{font-size:17px;margin:0}.mini{font-size:12px;color:#8a8f9e}.recent{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:18px}.event{padding:10px 0;border-bottom:1px solid rgba(255,255,255,.06)}.event:last-child{border-bottom:0}@media(max-width:980px){.cols,.recent{grid-template-columns:1fr}.grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:600px){.grid{grid-template-columns:1fr}.wrap{padding:20px}}
  </style>
</head>
<body>
<% if (!authorized) { %>
  <div class="wrap login">
    <div class="card">
      <h1>Autovyne Master Login</h1>
      <p class="sub">Full account command center.</p>
      <% if (error) { %><div class="msg err"><%= error %></div><% } %>
      <form method="POST" action="/admin/accounts/login">
        <label>Admin Key</label>
        <input type="password" name="key" required autofocus>
        <button class="btn" style="width:100%;margin-top:14px">Open Command Center</button>
      </form>
    </div>
  </div>
<% } else {
  const accountsList = accounts || [];
  const snap = snapshot || {};
  const activeAccounts = accountsList.filter(a => a.status === 'active').length;
  const totalRecovery = accountsList.reduce((sum, a) => sum + Number((a.metrics || {}).estimated_revenue_recovered || 0), 0);
%>
  <div class="wrap">
    <div class="top">
      <div><h1>Autovyne Command Center</h1><p class="sub">Master view for accounts, onboarding, AI/SMS/CRM status, and recent lead activity.</p></div>
      <div><a class="btn btn-secondary" href="/admin/analytics">Analytics</a> <a class="btn btn-secondary" href="/admin/compliance">SMS Proof</a></div>
    </div>
    <% if (error) { %><div class="msg err"><%= error %></div><% } %>
    <% if (success) { %><div class="msg ok"><%= success %></div><% } %>

    <section class="grid">
      <div class="card stat"><span>Managed Accounts</span><strong class="accent"><%= accountsList.length %></strong></div>
      <div class="card stat"><span>Active Accounts</span><strong><%= activeAccounts %></strong></div>
      <div class="card stat"><span>Recent Leads</span><strong class="warn"><%= (snap.leads || []).length %></strong></div>
      <div class="card stat"><span>Tracked Recovery</span><strong>$<%= totalRecovery.toLocaleString() %></strong></div>
    </section>

    <section class="cols">
      <div class="card">
        <div class="section-title"><h2>Create / Update Account</h2></div>
        <form method="POST" action="/admin/accounts">
          <label>Business Name</label><input name="business_name" required>
          <label>Contact Name</label><input name="contact_name">
          <label>Email</label><input name="email" type="email" required>
          <label>Phone</label><input name="phone">
          <label>Access Code</label><input name="access_code" required placeholder="Give this to the customer">
          <label>Status</label><select name="status"><option value="setup">Setup</option><option value="active">Active</option><option value="paused">Paused</option><option value="needs_attention">Needs Attention</option></select>
          <label>Plan</label><select name="plan"><option value="starter">Starter</option><option value="professional">Professional</option><option value="enterprise">Enterprise</option></select>
          <div class="checks">
            <label class="check"><input type="checkbox" name="ai_calling" value="true"> AI Calling</label>
            <label class="check"><input type="checkbox" name="sms_followup" value="true"> SMS Follow-up</label>
            <label class="check"><input type="checkbox" name="crm_sync" value="true"> CRM Sync</label>
            <label class="check"><input type="checkbox" name="n8n_workflows" value="true"> n8n</label>
            <label class="check"><input type="checkbox" name="openai_qualification" value="true"> OpenAI</label>
          </div>
          <label>Metrics</label>
          <div class="checks">
            <input name="calls_handled" type="number" min="0" placeholder="Calls handled">
            <input name="sms_sent" type="number" min="0" placeholder="SMS sent">
            <input name="crm_leads_synced" type="number" min="0" placeholder="CRM synced">
            <input name="missed_calls_recovered" type="number" min="0" placeholder="Recovered calls">
            <input name="estimated_revenue_recovered" type="number" min="0" placeholder="Revenue recovered">
          </div>
          <label>Internal Notes</label><textarea name="notes"></textarea>
          <button class="btn" style="width:100%;margin-top:14px">Save Account</button>
        </form>
      </div>

      <div class="card">
        <div class="section-title"><h2>Managed Accounts</h2><span class="mini">Give customers `/portal` plus their email/access code.</span></div>
        <div class="table-wrap">
          <table class="table">
            <thead><tr><th>Account</th><th>Status</th><th>Services</th><th>Metrics</th><th>Activity</th></tr></thead>
            <tbody>
            <% accountsList.forEach(function(a) { const s = a.services || {}; const m = a.metrics || {}; %>
              <tr>
                <td><strong><%= a.business_name %></strong><br><span class="mini"><%= a.email %></span></td>
                <td><span class="pill <%= a.status === 'active' ? 'pill-on' : '' %>"><%= a.status %></span><br><span class="mini"><%= a.plan %></span></td>
                <td>
                  <% ['ai_calling','sms_followup','crm_sync','n8n_workflows','openai_qualification'].forEach(function(key){ %>
                    <span class="pill <%= s[key] ? 'pill-on' : '' %>"><%= key.replace(/_/g, ' ') %></span>
                  <% }); %>
                </td>
                <td class="mini">Calls: <%= m.calls_handled || 0 %><br>SMS: <%= m.sms_sent || 0 %><br>CRM: <%= m.crm_leads_synced || 0 %><br>Recovery: $<%= Number(m.estimated_revenue_recovered || 0).toLocaleString() %></td>
                <td><a class="btn btn-secondary" href="/admin/accounts/<%= a.id %>/events">Events</a></td>
              </tr>
            <% }); %>
            <% if (!accountsList.length) { %><tr><td colspan="5" class="sub">No managed accounts yet.</td></tr><% } %>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="recent">
      <div class="card">
        <h2>Add Account Activity</h2>
        <form method="POST" action="/admin/accounts/events">
          <label>Account</label><select name="account_id" required><% accountsList.forEach(function(a){ %><option value="<%= a.id %>"><%= a.business_name %></option><% }); %></select>
          <label>Type</label><input name="event_type" value="update">
          <label>Title</label><input name="title" required placeholder="Example: SMS workflow connected">
          <label>Detail</label><textarea name="detail"></textarea>
          <label class="check"><input type="checkbox" name="visible_to_client" value="true" checked> Show this to customer</label>
          <button class="btn">Add Activity</button>
        </form>
      </div>
      <div class="card">
        <h2>Recent Leads / Questions</h2>
        <% (snap.leads || []).slice(0,6).forEach(function(lead){ %><div class="event"><strong><%= lead.business_name %></strong><p class="mini">Lead · <%= lead.industry %> · $<%= Number(lead.estimated_monthly_loss || 0).toLocaleString() %> estimated monthly loss</p></div><% }); %>
        <% (snap.questions || []).slice(0,6).forEach(function(q){ %><div class="event"><strong><%= q.business_name || q.name %></strong><p class="mini">Question · <%= q.email %> · <%= q.question %></p></div><% }); %>
      </div>
    </section>

    <% if (selectedAccount) { %>
    <section class="card" style="margin-top:18px">
      <h2>Activity for <%= selectedAccount.business_name %></h2>
      <% selectedEvents.forEach(function(e){ %><div class="event"><strong><%= e.title %></strong><p class="mini"><%= e.event_type %> · visible: <%= e.visible_to_client ? 'yes' : 'no' %> · <%= new Date(e.created_at).toLocaleString() %></p><p><%= e.detail || '' %></p></div><% }); %>
    </section>
    <% } %>
  </div>
<% } %>
</body>
</html>
