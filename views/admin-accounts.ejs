<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Account Command Center - Autovyne</title>
  <link rel="stylesheet" href="/css/assistant-widget.css">
  <style>
    *{box-sizing:border-box}body{margin:0;background:#08080d;color:#eff2f7;font:14px 'Space Grotesk',system-ui,sans-serif}.wrap{max-width:1440px;margin:0 auto;padding:30px}.top{display:flex;justify-content:space-between;gap:16px;align-items:flex-start;margin-bottom:22px}.sub,.mini{color:#8a8f9e}.mini{font-size:12px;line-height:1.5}.eyebrow{color:#00e87b;font-size:12px;font-weight:900;text-transform:uppercase;letter-spacing:.1em}.top h1{font-size:clamp(2rem,4vw,3.4rem);line-height:1;margin:8px 0 10px;letter-spacing:-.05em}.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:18px}.card{background:#12141c;border:1px solid rgba(255,255,255,.08);border-radius:18px;padding:20px;box-shadow:0 20px 70px rgba(0,0,0,.24)}.stat span,.metric span{display:block;color:#8a8f9e;font-size:11px;text-transform:uppercase;letter-spacing:.08em;font-weight:800}.stat strong,.metric strong{display:block;font-size:30px;margin-top:6px}.accent{color:#00e87b}.warn{color:#ffd166}.danger{color:#ff6b6b}.cols{display:grid;grid-template-columns:390px 1fr;gap:18px;align-items:start}.login{max-width:440px;margin:120px auto}.login h1{margin-top:0}label{display:block;color:#8a8f9e;font-size:12px;margin:12px 0 6px;font-weight:800;text-transform:uppercase;letter-spacing:.04em}input,select,textarea{width:100%;padding:11px 12px;border-radius:11px;border:1px solid rgba(255,255,255,.12);background:#0a0c12;color:#fff;font:14px inherit}select{cursor:pointer}textarea{min-height:96px;resize:vertical}.checks{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:12px 0}.check{display:flex;gap:8px;align-items:center;background:#0a0c12;border:1px solid rgba(255,255,255,.08);border-radius:10px;padding:10px;color:#cdd3df;text-transform:none;letter-spacing:0;font-size:13px}.check input{width:auto}.btn{display:inline-block;border:0;border-radius:11px;padding:11px 14px;background:#00e87b;color:#05070a;font-weight:900;cursor:pointer;text-decoration:none}.btn-secondary{background:#202432;color:#eff2f7}.btn-ghost{background:transparent;color:#eff2f7;border:1px solid rgba(255,255,255,.14)}.actions{display:flex;gap:10px;flex-wrap:wrap}.msg{padding:12px;border-radius:12px;margin-bottom:14px}.err{background:rgba(255,107,107,.12);color:#ff9d9d}.ok{background:rgba(0,232,123,.1);color:#00e87b}.table-wrap{overflow:auto}.table{width:100%;border-collapse:collapse}.table th{color:#8a8f9e;text-align:left;text-transform:uppercase;font-size:11px;letter-spacing:.08em;border-bottom:1px solid rgba(255,255,255,.08);padding:10px}.table td{border-bottom:1px solid rgba(255,255,255,.04);padding:12px 10px;vertical-align:top}.pill{display:inline-block;border-radius:999px;padding:4px 9px;background:#202432;color:#cdd3df;font-size:12px;margin:2px 2px 2px 0}.pill-on{background:rgba(0,232,123,.12);color:#00e87b}.pill-warn{background:rgba(255,209,102,.12);color:#ffd166}.section-title{display:flex;justify-content:space-between;align-items:flex-start;gap:10px;margin:0 0 14px}.section-title h2{font-size:18px;margin:0}.recent{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:18px}.event{padding:11px 0;border-bottom:1px solid rgba(255,255,255,.06)}.event:last-child{border-bottom:0}.steps{display:grid;gap:8px;margin:12px 0 16px}.step{display:grid;grid-template-columns:28px 1fr;gap:10px;align-items:start;padding:10px;border-radius:12px;background:rgba(255,255,255,.035)}.step-num{display:grid;place-items:center;width:28px;height:28px;border-radius:50%;background:rgba(0,232,123,.12);color:#00e87b;font-weight:900}.form-band{padding:12px;border:1px solid rgba(0,232,123,.16);background:rgba(0,232,123,.055);border-radius:14px;margin:12px 0}.segmented{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:10px 0 14px}.segmented a{padding:10px;border-radius:11px;background:#0a0c12;color:#cdd3df;text-decoration:none;text-align:center;border:1px solid rgba(255,255,255,.08);font-weight:800}.segmented a:hover{border-color:rgba(0,232,123,.45)}.filters{display:grid;grid-template-columns:2fr repeat(3,1fr) auto;gap:10px;align-items:end;margin:0 0 14px;padding:12px;border-radius:14px;background:rgba(255,255,255,.035);border:1px solid rgba(255,255,255,.07)}.filters label{margin:0 0 5px}.health-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:10px 0 14px}.health{padding:12px;border-radius:14px;background:#0a0c12;border:1px solid rgba(255,255,255,.08)}.health strong{display:block;font-size:18px;margin-top:4px}.progress{height:8px;background:#202432;border-radius:999px;overflow:hidden;margin-top:8px}.progress span{display:block;height:100%;background:#00e87b;border-radius:999px}.fold{border:1px solid rgba(255,255,255,.08);border-radius:14px;background:rgba(255,255,255,.025);margin:10px 0;padding:0 12px 12px}.fold summary{cursor:pointer;padding:13px 0;font-weight:900;color:#eff2f7}.assistant{border-color:rgba(0,232,123,.22);background:linear-gradient(135deg,rgba(0,232,123,.08),rgba(255,255,255,.025))}.assistant-answer{white-space:pre-wrap;background:#0a0c12;border:1px solid rgba(0,232,123,.18);border-radius:14px;padding:14px;color:#dfffee;margin-top:12px}.quick-select{margin-top:8px}@media(max-width:980px){.cols,.recent,.filters{grid-template-columns:1fr}.grid,.health-grid{grid-template-columns:repeat(2,1fr)}.top{flex-direction:column}}@media(max-width:640px){.grid,.checks,.segmented,.health-grid{grid-template-columns:1fr}.wrap{padding:18px}.actions{width:100%}.actions .btn{width:100%;text-align:center}}
  </style>
</head>
<body>
<% if (!authorized) { %>
  <div class="wrap login">
    <div class="card">
      <div class="eyebrow">Master Admin</div>
      <h1>Autovyne Admin Login</h1>
      <p class="sub">Use your main admin login first. This protects account controls, compliance proof, and customer activity.</p>
      <% if (error) { %><div class="msg err"><%= error %></div><% } %>
      <form method="POST" action="/admin/accounts/login">
        <label>Admin Key</label>
        <input type="password" name="key" required autofocus>
        <button class="btn" style="width:100%;margin-top:14px">Open Command Center</button>
      </form>
    </div>
  </div>
<% } else {
  const accountsList = accounts || [];
  const visibleAccounts = filteredAccounts || accountsList;
  const activeFilters = filters || { search: '', status: 'all', billing: 'all', readiness: 'all' };
  const snap = snapshot || {};
  const activeAccounts = accountsList.filter(a => a.status === 'active').length;
  const setupAccounts = accountsList.filter(a => a.status === 'setup').length;
  const needsAttention = accountsList.filter(a => a.status === 'needs_attention').length;
  const automaticBilling = accountsList.filter(a => (a.billing_method || 'automatic') === 'automatic').length;
  const readyAccounts = accountsList.filter(a => {
    const s = a.services || {};
    const count = ['ai_calling','sms_followup','crm_sync','n8n_workflows','openai_qualification'].filter(k => s[k]).length;
    return a.status === 'active' && count >= 4;
  }).length;
  const priorityAccounts = accountsList
    .map(a => {
      const s = a.services || {};
      const enabled = ['ai_calling','sms_followup','crm_sync','n8n_workflows','openai_qualification'].filter(k => s[k]).length;
      const reason = a.status === 'needs_attention'
        ? 'Needs review'
        : a.status === 'paused'
          ? 'Paused'
          : enabled === 0
            ? 'Setup not started'
            : a.status === 'setup'
              ? `${enabled}/5 services ready`
              : null;
      return reason ? { account: a, reason, enabled } : null;
    })
    .filter(Boolean)
    .slice(0, 5);
  const setupPercent = accountsList.length ? Math.round((readyAccounts / accountsList.length) * 100) : 0;
  const legalReviewCount = (snap.legalAudits || []).filter(audit => audit.status === 'needs_admin_review').length;
  const reports = opsReports || [];
  const reviewRows = customerReviews || [];
  const latestOpsReport = generatedOpsReport || reports[0] || null;
  const editAccount = selectedEditAccount || null;
  const editMetrics = editAccount ? (editAccount.metrics || {}) : {};
  const formAction = editAccount ? `/admin/accounts/account/${editAccount.id}` : '/admin/accounts';
  const isSelected = (value, current) => String(value) === String(current || '');
%>
  <div class="wrap">
    <div class="top">
      <div>
        <div class="eyebrow">Autovyne Command Center</div>
        <h1>Accounts, automation, and proof in one place.</h1>
        <p class="sub">Use guided controls to update client status, turn services on, add portal-visible activity, and check lead/compliance records without heavy manual typing.</p>
      </div>
      <div class="actions">
        <a class="btn btn-secondary" href="/admin">Admin Hub</a>
        <a class="btn btn-secondary" href="/admin/legal-audits">Legal Audits</a>
        <a class="btn btn-secondary" href="/admin/questions">Questions</a>
        <a class="btn btn-secondary" href="/admin/analytics">Analytics</a>
        <a class="btn btn-secondary" href="/admin/compliance">SMS Proof</a>
      </div>
    </div>
    <% if (error) { %><div class="msg err"><%= error %></div><% } %>
    <% if (success) { %><div class="msg ok"><%= success %></div><% } %>

    <section class="grid">
      <div class="card stat"><span>Managed Accounts</span><strong class="accent"><%= accountsList.length %></strong></div>
      <div class="card stat"><span>Active</span><strong><%= activeAccounts %></strong></div>
      <div class="card stat"><span>In Setup</span><strong class="warn"><%= setupAccounts %></strong></div>
      <a class="card stat" href="/admin/accounts?status=needs_attention" style="text-decoration:none;color:inherit"><span>Needs Attention</span><strong class="<%= needsAttention ? 'danger' : '' %>"><%= needsAttention %></strong><p class="mini">Open accounts under review.</p></a>
    </section>

    <section class="grid">
      <div class="card stat"><span>Automatic Billing</span><strong><%= automaticBilling %></strong><p class="mini">Stripe monthly accounts.</p></div>
      <div class="card stat"><span>Launch Ready</span><strong class="accent"><%= readyAccounts %></strong><p class="mini">Active with most automation on.</p></div>
      <div class="card stat"><span>Filtered View</span><strong><%= visibleAccounts.length %></strong><p class="mini">Accounts matching current filters.</p></div>
      <a class="card stat" href="<%= legalReviewCount ? '/admin/legal-audits?status=needs_admin_review' : '/admin/accounts?readiness=review' %>" style="text-decoration:none;color:inherit"><span>Review Queue</span><strong class="<%= legalReviewCount ? 'warn' : setupPercent >= 75 ? 'accent' : 'warn' %>"><%= legalReviewCount || `${setupPercent}%` %></strong><p class="mini"><%= legalReviewCount ? 'Legal Audit AI needs approval.' : 'Open account review queue.' %></p></a>
    </section>

    <section class="card">
      <div class="section-title">
        <div>
          <h2>Owner Brief</h2>
          <p class="mini">Fast daily readout for managing Autovyne by yourself.</p>
        </div>
        <a class="pill <%= needsAttention || legalReviewCount ? 'pill-warn' : 'pill-on' %>" href="<%= legalReviewCount ? '/admin/legal-audits?status=needs_admin_review' : '/admin/accounts?status=needs_attention' %>" style="text-decoration:none"><%= legalReviewCount ? `${legalReviewCount} legal review` : needsAttention ? `${needsAttention} need review` : 'No urgent review' %></a>
      </div>
      <div class="health-grid">
        <div class="health"><span class="mini">Work first</span><strong><%= priorityAccounts[0] ? priorityAccounts[0].account.business_name : legalReviewCount ? 'Legal audits' : 'No urgent account' %></strong><p class="mini"><% if (priorityAccounts[0]) { %><a href="/admin/accounts/<%= priorityAccounts[0].account.id %>/edit" style="color:#00e87b"><%= priorityAccounts[0].reason %></a><% } else if (legalReviewCount) { %><a href="/admin/legal-audits?status=needs_admin_review" style="color:#00e87b">Open Legal Audit AI review queue</a><% } else { %>Everything is in a manageable state.<% } %></p></div>
        <div class="health"><span class="mini">Best next action</span><strong><%= legalReviewCount ? 'Approve audit reviews' : needsAttention ? 'Review flagged accounts' : setupAccounts ? 'Move setup forward' : 'Monitor activity' %></strong><p class="mini"><%= legalReviewCount ? '' : needsAttention ? '' : setupAccounts ? 'Use One-Click Account Controls or quick updates.' : 'Check leads, questions, and Integration Health.' %><% if (legalReviewCount) { %><a href="/admin/legal-audits?status=needs_admin_review" style="color:#00e87b">Open Legal Audits</a><% } else if (needsAttention) { %><a href="/admin/accounts?status=needs_attention" style="color:#00e87b">Use filtered view: Needs attention</a><% } %></p></div>
        <div class="health"><span class="mini">Customer transparency</span><strong><%= priorityAccounts.length %> visible priorities</strong><p class="mini">Use customer-visible updates so portals show real progress.</p></div>
      </div>
      <% if (priorityAccounts.length) { %>
        <div class="table-wrap">
          <table class="table">
            <thead><tr><th>Priority Account</th><th>Reason</th><th>Shortcut</th></tr></thead>
            <tbody>
              <% priorityAccounts.forEach(function(item) { %>
                <tr><td><strong><%= item.account.business_name %></strong><br><span class="mini"><%= item.account.email %></span></td><td><a href="/admin/accounts/<%= item.account.id %>/edit" style="color:#00e87b"><%= item.reason %></a></td><td><a class="btn btn-ghost" href="/admin/accounts/<%= item.account.id %>/edit">Review Account</a></td></tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>

    <section class="card assistant">
      <div class="section-title">
        <div>
          <h2>Autonomous Daily Ops Report</h2>
          <p class="mini">Generates the owner brief Autovyne should follow today: what can run automatically, what needs approval, what to audit, and what to prep before cold calling.</p>
        </div>
        <form method="POST" action="/admin/accounts/ops-report">
          <button class="btn" type="submit">Generate Daily Report</button>
        </form>
      </div>
      <% if (latestOpsReport) {
        const reportMetrics = latestOpsReport.metrics || {};
        const reportPriorities = latestOpsReport.priorities || [];
        const reportManual = latestOpsReport.manual_support || [];
        const reportAudit = latestOpsReport.audit_tasks || [];
        const reportCold = latestOpsReport.cold_calling_tasks || [];
      %>
        <div class="health-grid">
          <div class="health"><span class="mini">Accounts</span><strong><%= reportMetrics.accounts_total || 0 %></strong><p class="mini"><%= reportMetrics.accounts_active || 0 %> active, <%= reportMetrics.accounts_setup || 0 %> in setup, <%= reportMetrics.accounts_review || 0 %> review.</p></div>
          <div class="health"><span class="mini">Priority Items</span><strong class="<%= reportPriorities.length ? 'warn' : 'accent' %>"><%= reportPriorities.length %></strong><p class="mini"><%= latestOpsReport.summary %></p></div>
          <div class="health"><span class="mini">Manual Support</span><strong class="<%= reportManual.length ? 'warn' : 'accent' %>"><%= reportManual.length %></strong><p class="mini">Items the AI should not complete without approval.</p></div>
        </div>
        <% if (latestOpsReport.ai_narrative) { %>
          <div class="assistant-answer"><%= latestOpsReport.ai_narrative %></div>
        <% } %>
        <% if (reportPriorities.length) { %>
          <div class="table-wrap" style="margin-top:12px">
            <table class="table">
              <thead><tr><th>Priority</th><th>Why it matters</th><th>Open</th></tr></thead>
              <tbody>
                <% reportPriorities.slice(0, 6).forEach(function(item) { %>
                  <tr>
                    <td><span class="pill <%= item.severity === 'high' ? 'pill-warn' : '' %>"><%= item.severity %></span><br><strong><%= item.title %></strong></td>
                    <td class="mini"><%= item.detail %></td>
                    <td><a class="btn btn-ghost" href="<%= item.href || '/admin/accounts' %>">Review</a></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } %>
        <div class="health-grid" style="margin-top:12px">
          <div class="health"><span class="mini">Audit watch</span><p class="mini"><%= reportAudit.slice(0, 2).join(' ') || 'No audit tasks generated.' %></p></div>
          <div class="health"><span class="mini">Cold call prep</span><p class="mini"><%= reportCold.slice(0, 2).join(' ') || 'No outreach tasks generated.' %></p></div>
          <div class="health"><span class="mini">Generated</span><p class="mini"><%= latestOpsReport.created_at ? new Date(latestOpsReport.created_at).toLocaleString() : 'This session' %></p></div>
        </div>
      <% } else { %>
        <p class="mini">No autonomous report has been generated yet. Click the button once each morning before outreach.</p>
      <% } %>
    </section>

    <section class="card assistant">
      <div class="section-title">
        <div>
          <h2>Autovyne Admin AI</h2>
          <p class="mini">Ask for a plain-English update, next steps, risk check, or what to work on first. It can advise, but it cannot change accounts or send messages.</p>
        </div>
      </div>
      <form method="POST" action="/admin/accounts/assistant">
        <label>Optional Guided Question</label>
        <select class="quick-select" onchange="this.form.assistant_question.value=this.value">
          <option value="">Choose a guide or type below</option>
          <option value="Give me a simple daily briefing of what needs my attention first.">Daily briefing</option>
          <option value="Which accounts look stuck or need review, and what should I do next?">Find stuck accounts</option>
          <option value="Summarize billing, SMS consent, and automation risks before I start outreach.">Risk check</option>
          <option value="Explain my current account activity like I am managing this by myself for the first time.">Explain activity simply</option>
        </select>
        <label>Your Question</label>
        <textarea name="assistant_question" rows="3" placeholder="Example: What should I work on today?"><%= assistantQuestion || '' %></textarea>
        <button class="btn" type="submit" style="margin-top:12px">Ask Admin AI</button>
      </form>
      <% if (assistantResponse) { %><div class="assistant-answer"><%= assistantResponse %></div><% } %>
    </section>

    <section class="cols">
      <div class="card">
        <div class="section-title">
          <div>
            <h2><%= editAccount ? `Editing ${editAccount.business_name}` : 'Guided Account Setup' %></h2>
            <p class="mini"><%= editAccount ? 'Update this account without changing the portal code unless you enter a new one.' : 'Use this to create a new account or update an existing email.' %></p>
          </div>
        </div>
        <div class="form-band">
          <strong>Need a sales demo account?</strong>
          <p class="mini">Create or refresh a clean HVAC demo account with full-stack services, example metrics, visible portal activity, and a sample control request.</p>
          <form method="POST" action="/admin/accounts/demo-account">
            <button class="btn btn-secondary" type="submit">Create / Refresh Demo Account</button>
          </form>
        </div>
        <div class="steps">
          <div class="step"><span class="step-num">1</span><div><strong>Identify the customer</strong><p class="mini">Business name, email, phone, and portal code.</p></div></div>
          <div class="step"><span class="step-num">2</span><div><strong>Choose status and billing</strong><p class="mini">Setup, active, paused, or needs attention.</p></div></div>
          <div class="step"><span class="step-num">3</span><div><strong>Pick the automation bundle</strong><p class="mini">Presets turn on the right service switches for you.</p></div></div>
        </div>
        <% if (editAccount) { %>
          <div class="msg ok">You are editing an existing customer account. Leave portal access code blank to keep the current code.</div>
        <% } %>
        <form method="POST" action="<%= formAction %>">
          <details class="fold" open>
            <summary>Customer Basics</summary>
            <label>Business Name</label><input name="business_name" required placeholder="Example: Smith Auto Repair" value="<%= editAccount ? editAccount.business_name : '' %>">
            <label>Contact Name</label><input name="contact_name" placeholder="Owner or manager name" value="<%= editAccount ? (editAccount.contact_name || '') : '' %>">
            <label>Email</label><input name="email" type="email" required placeholder="customer@email.com" value="<%= editAccount ? editAccount.email : '' %>">
            <label>Phone</label><input name="phone" placeholder="Business phone" value="<%= editAccount ? (editAccount.phone || '') : '' %>">
            <label>Industry AI Profile</label>
            <select name="industry">
              <% Object.keys(industryProfiles || {}).forEach(function(key) { %>
                <option value="<%= key %>" <%= isSelected(key, editAccount && editAccount.industry) ? 'selected' : '' %>><%= industryProfiles[key].label %> - <%= industryProfiles[key].definingTrait %></option>
              <% }); %>
            </select>
            <label>Portal Access Code</label><input name="access_code" <%= editAccount ? '' : 'required' %> placeholder="<%= editAccount ? 'Leave blank to keep current code' : 'Give this code to the customer' %>">
          </details>
          <details class="fold" open>
            <summary>Status, Plan, and Billing</summary>
            <label>Account Status</label>
            <select name="status">
              <option value="setup" <%= isSelected('setup', editAccount && editAccount.status) ? 'selected' : '' %>>Setup - still being prepared</option>
              <option value="active" <%= isSelected('active', editAccount && editAccount.status) ? 'selected' : '' %>>Active - customer is live</option>
              <option value="paused" <%= isSelected('paused', editAccount && editAccount.status) ? 'selected' : '' %>>Paused - temporarily stopped</option>
              <option value="needs_attention" <%= isSelected('needs_attention', editAccount && editAccount.status) ? 'selected' : '' %>>Needs Attention - review required</option>
            </select>
            <label>Plan</label>
            <select name="plan" id="plan-select">
              <option value="smb-bundle" <%= isSelected('smb-bundle', editAccount && editAccount.plan) ? 'selected' : '' %>>SMB Bundle - $149/month</option>
              <option value="starter" <%= isSelected('starter', editAccount && editAccount.plan) ? 'selected' : '' %>>Starter</option>
              <option value="professional" <%= isSelected('professional', editAccount && editAccount.plan) ? 'selected' : '' %>>Professional</option>
              <option value="enterprise" <%= isSelected('enterprise', editAccount && editAccount.plan) ? 'selected' : '' %>>Enterprise</option>
            </select>
            <label>Billing Method</label>
            <select name="billing_method">
              <option value="automatic" <%= isSelected('automatic', editAccount && (editAccount.billing_method || 'automatic')) ? 'selected' : '' %>>Automatic monthly card payments</option>
              <option value="manual" <%= isSelected('manual', editAccount && editAccount.billing_method) ? 'selected' : '' %>>Manual monthly billing</option>
            </select>
          </details>
          <details class="fold" open>
            <summary>Package Services</summary>
            <% const selectedPlanForServices = (editAccount && editAccount.plan) || 'smb-bundle'; const selectedBundle = planServiceBundles[selectedPlanForServices] || planServiceBundles.professional || {}; %>
            <p class="mini" id="plan-service-note"><%= planServiceNotes[selectedPlanForServices] || planServiceNotes.professional %></p>
            <div class="checks" id="plan-service-list">
              <% serviceDefinitions.forEach(function(service) { const included = Boolean(selectedBundle[service.key]); %>
                <div class="check">
                  <span class="pill <%= included ? 'pill-on' : '' %>"><%= included ? 'Included' : 'Not in plan' %></span>
                  <div><strong><%= service.label %></strong><br><span class="mini"><%= service.description %></span></div>
                </div>
              <% }); %>
            </div>
            <p class="mini">Services are selected automatically from the package bought. Change the plan above if the customer upgrades or downgrades.</p>
          </details>
          <details class="fold">
            <summary>Metrics and Notes</summary>
            <label>Live Metrics</label>
            <div class="checks">
              <input name="calls_handled" type="number" min="0" placeholder="Calls handled" value="<%= editMetrics.calls_handled || 0 %>">
              <input name="sms_sent" type="number" min="0" placeholder="Texts sent" value="<%= editMetrics.sms_sent || 0 %>">
              <input name="crm_leads_synced" type="number" min="0" placeholder="Leads tracked" value="<%= editMetrics.crm_leads_synced || 0 %>">
              <input name="missed_calls_recovered" type="number" min="0" placeholder="Recovered calls" value="<%= editMetrics.missed_calls_recovered || 0 %>">
              <input name="estimated_revenue_recovered" type="number" min="0" placeholder="Revenue recovered" value="<%= editMetrics.estimated_revenue_recovered || 0 %>">
            </div>
            <label>Notes Preset</label>
            <select onchange="this.form.notes.value=this.value">
              <option value="">Choose a note preset</option>
              <option value="Customer is paid and waiting for automation setup.">Paid and waiting for setup</option>
              <option value="Needs billing review before additional setup work.">Needs billing review</option>
              <option value="Text consent must be verified before text follow-up.">Verify text consent</option>
              <option value="Ready for launch-ready review after service checks.">Ready for launch review</option>
            </select>
            <label>Internal Notes</label><textarea name="notes" placeholder="Only Autovyne admins can see this."><%= editAccount ? (editAccount.notes || '') : '' %></textarea>
          </details>
          <button class="btn" style="width:100%;margin-top:14px"><%= editAccount ? 'Save Account Changes' : 'Save Account' %></button>
          <% if (editAccount) { %><a class="btn btn-ghost" style="width:100%;text-align:center;margin-top:10px" href="/admin/accounts">Cancel Editing</a><% } %>
        </form>
      </div>

      <div class="card">
        <div class="section-title">
          <div>
            <h2>Managed Accounts</h2>
            <p class="mini"><%= automaticBilling %> account(s) on automatic monthly billing. Give customers `/portal` plus their email and access code.</p>
          </div>
        </div>
        <form class="filters" method="GET" action="/admin/accounts">
          <div>
            <label>Search</label>
            <input name="search" placeholder="Business, owner, email, phone, plan" value="<%= activeFilters.search || '' %>">
          </div>
          <div>
            <label>Status</label>
            <select name="status">
              <option value="all" <%= activeFilters.status === 'all' ? 'selected' : '' %>>All</option>
              <option value="setup" <%= activeFilters.status === 'setup' ? 'selected' : '' %>>Setup</option>
              <option value="active" <%= activeFilters.status === 'active' ? 'selected' : '' %>>Active</option>
              <option value="paused" <%= activeFilters.status === 'paused' ? 'selected' : '' %>>Paused</option>
              <option value="needs_attention" <%= activeFilters.status === 'needs_attention' ? 'selected' : '' %>>Needs attention</option>
            </select>
          </div>
          <div>
            <label>Billing</label>
            <select name="billing">
              <option value="all" <%= activeFilters.billing === 'all' ? 'selected' : '' %>>All</option>
              <option value="automatic" <%= activeFilters.billing === 'automatic' ? 'selected' : '' %>>Automatic</option>
              <option value="manual" <%= activeFilters.billing === 'manual' ? 'selected' : '' %>>Manual</option>
            </select>
          </div>
          <div>
            <label>Readiness</label>
            <select name="readiness">
              <option value="all" <%= activeFilters.readiness === 'all' ? 'selected' : '' %>>All</option>
              <option value="ready" <%= activeFilters.readiness === 'ready' ? 'selected' : '' %>>Launch ready</option>
              <option value="setup" <%= activeFilters.readiness === 'setup' ? 'selected' : '' %>>In setup</option>
              <option value="review" <%= activeFilters.readiness === 'review' ? 'selected' : '' %>>Review</option>
            </select>
          </div>
          <button class="btn" type="submit">Filter</button>
        </form>
        <div class="segmented">
          <a href="#quick-action">Quick Update</a>
          <a href="#accounts-table">Accounts</a>
          <a href="#recent">Leads & Questions</a>
        </div>
        <div class="table-wrap" id="accounts-table">
          <table class="table">
            <thead><tr><th>Account</th><th>Status</th><th>Billing</th><th>Services</th><th>Metrics</th><th>Actions</th></tr></thead>
            <tbody>
            <% visibleAccounts.forEach(function(a) { const s = a.services || {}; const m = a.metrics || {}; const p = a.preferences || {}; const comm = p.communication || {}; const cal = p.calendar || {}; const follow = p.followup || {}; const updatePref = (comm.update_channels || ['portal']).map(function(channel){ return channel === 'sms' ? 'text' : channel; }).join(', '); const enabled = ['ai_calling','sms_followup','crm_sync','n8n_workflows','openai_qualification'].filter(k => s[k]).length; const pct = Math.round((enabled / 5) * 100); %>
              <tr>
                <td><strong><%= a.business_name %></strong><br><span class="mini"><%= a.email %><br><%= a.phone || 'No phone saved' %><br>Updates: <%= updatePref || 'portal' %><br>Calendar: <%= cal.provider_label || 'Portal calendar' %><br>Follow-up: <%= follow.style_label || 'Owner review' %></span></td>
                <td><% if (a.status === 'needs_attention') { %><a class="pill pill-warn" href="/admin/accounts/<%= a.id %>/edit" style="text-decoration:none">needs attention review</a><% } else { %><span class="pill <%= a.status === 'active' ? 'pill-on' : '' %>"><%= a.status.replace(/_/g, ' ') %></span><% } %><br><span class="mini"><%= a.plan %></span></td>
                <td><span class="pill <%= (a.billing_method || 'automatic') === 'automatic' ? 'pill-on' : '' %>"><%= (a.billing_method || 'automatic') === 'manual' ? 'manual monthly' : 'automatic monthly' %></span></td>
                <td>
                  <% [['ai_calling','Calls'],['sms_followup','Texts'],['crm_sync','Leads'],['n8n_workflows','Bookings'],['openai_qualification','Review']].forEach(function(item){ %>
                    <span class="pill <%= s[item[0]] ? 'pill-on' : '' %>"><%= item[1] %></span>
                  <% }); %>
                  <div class="progress"><span style="width:<%= pct %>%"></span></div>
                </td>
                <td class="mini">Calls: <%= m.calls_handled || 0 %><br>Texts: <%= m.sms_sent || 0 %><br>Leads: <%= m.crm_leads_synced || 0 %><br>Recovered: $<%= Number(m.estimated_revenue_recovered || 0).toLocaleString() %></td>
                <td>
                  <div class="actions">
                    <a class="btn btn-ghost" href="/admin/accounts/<%= a.id %>/edit">Edit</a>
                    <a class="btn btn-ghost" href="/admin/accounts/<%= a.id %>/events">Events</a>
                  </div>
                </td>
              </tr>
            <% }); %>
            <% if (!visibleAccounts.length) { %><tr><td colspan="6" class="sub"><%= accountsList.length ? 'No accounts match these filters.' : 'No managed accounts yet.' %></td></tr><% } %>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="recent" id="customer-reviews">
      <div class="card">
        <div class="section-title">
          <div>
            <h2>Verified Homepage Reviews</h2>
            <p class="mini">Replace fake/static testimonials with reviews from signed-up customers who actually used Autovyne. Only approved reviews show publicly.</p>
          </div>
        </div>
        <form method="POST" action="/admin/accounts/reviews">
          <label>Connected Account</label>
          <select name="account_id">
            <option value="">No account selected</option>
            <% accountsList.forEach(function(a){ %><option value="<%= a.id %>"><%= a.business_name %></option><% }); %>
          </select>
          <label>Business Name</label>
          <input name="business_name" placeholder="Used if no account is selected">
          <label>Reviewer Name</label>
          <input name="reviewer_name" placeholder="Example: Kwaun, owner">
          <label>Reviewer Role</label>
          <input name="reviewer_role" placeholder="Example: Owner">
          <label>Rating</label>
          <select name="rating">
            <option value="">No rating</option>
            <option value="5">5 / 5</option>
            <option value="4">4 / 5</option>
            <option value="3">3 / 5</option>
            <option value="2">2 / 5</option>
            <option value="1">1 / 5</option>
          </select>
          <label>Customer Quote</label>
          <textarea name="quote" required placeholder="Paste the exact review the customer gave permission to use."></textarea>
          <label>Outcome Summary</label>
          <textarea name="outcome_summary" placeholder="Example: Calls, bookings, or support experience they specifically mentioned."></textarea>
          <label>Public Status</label>
          <select name="approved">
            <option value="false">Pending - do not show yet</option>
            <option value="true">Approved - show on homepage</option>
          </select>
          <button class="btn" style="margin-top:14px">Save Review</button>
        </form>
      </div>

      <div class="card">
        <div class="section-title"><h2>Review Queue</h2><p class="mini">Approved rows power the public homepage proof section.</p></div>
        <% if (reviewRows.length) { %>
          <% reviewRows.slice(0, 8).forEach(function(review) { %>
            <div class="event">
              <strong><%= review.business_name %></strong>
              <p class="mini"><%= review.status %><%= review.rating ? ` - ${review.rating}/5` : '' %><%= review.reviewer_name ? ` - ${review.reviewer_name}` : '' %></p>
              <p class="mini"><%= review.quote %></p>
              <% if (review.outcome_summary) { %><p class="mini"><%= review.outcome_summary %></p><% } %>
              <form method="POST" action="/admin/accounts/reviews/<%= review.id %>/status" style="margin-top:8px">
                <select name="status">
                  <option value="pending" <%= review.status === 'pending' ? 'selected' : '' %>>Pending</option>
                  <option value="approved" <%= review.status === 'approved' ? 'selected' : '' %>>Approved</option>
                </select>
                <button class="btn btn-secondary" style="margin-top:8px">Update Status</button>
              </form>
            </div>
          <% }); %>
        <% } else { %>
          <p class="mini">No customer reviews saved yet. The homepage will show an honest verified-review empty state.</p>
        <% } %>
      </div>
    </section>

    <section class="recent" id="quick-action">
      <div class="card">
        <div class="section-title"><h2>One-Click Account Controls</h2><p class="mini">Use guided operations when you want to move an account forward without editing every field.</p></div>
        <form method="POST" action="/admin/accounts/operation">
          <label>Account</label>
          <select name="account_id" required>
            <% accountsList.forEach(function(a){ %><option value="<%= a.id %>"><%= a.business_name %></option><% }); %>
          </select>
          <label>Operation</label>
          <select name="operation" required>
            <option value="start_setup">Start setup - portal active, services being prepared</option>
            <option value="sms_crm_ready">Mark text + lead tracker ready</option>
            <option value="launch_full_stack">Launch full stack - mark all services active</option>
            <option value="billing_review">Needs billing review</option>
            <option value="pause_service">Pause service</option>
          </select>
          <label>Visibility</label>
          <select name="visible_to_client">
            <option value="true">Show in customer portal</option>
            <option value="false">Internal only</option>
          </select>
          <button class="btn" style="margin-top:14px">Run Account Operation</button>
          <p class="mini">Text-related operations still require consent proof before any actual text outreach.</p>
        </form>
      </div>

      <div class="card">
        <div class="section-title"><h2>Quick Customer Update</h2><p class="mini">Choose a preset instead of typing from scratch.</p></div>
        <form method="POST" action="/admin/accounts/quick-action">
          <label>Account</label>
          <select name="account_id" required>
            <% accountsList.forEach(function(a){ %><option value="<%= a.id %>"><%= a.business_name %></option><% }); %>
          </select>
          <label>Update Type</label>
          <select name="quick_action" required>
            <option value="onboarding_started">Onboarding started</option>
            <option value="payment_confirmed">Payment confirmed</option>
            <option value="portal_activated">Portal activated</option>
            <option value="business_profile_received">Business profile reviewed</option>
            <option value="scripts_approved">Scripts and rules approved</option>
            <option value="calendar_connected">Booking or routing path connected</option>
            <option value="ai_calling_connected">Call follow-up connected</option>
            <option value="sms_ready">Text follow-up ready</option>
            <option value="crm_connected">Lead tracker connected</option>
            <option value="hubspot_connected">Lead hub connected</option>
            <option value="n8n_connected">Booking and follow-up flow connected</option>
            <option value="openai_review_ready">Lead review ready</option>
            <option value="twilio_verified">Text compliance verified</option>
            <option value="launch_ready">Launch-ready check complete</option>
            <option value="customer_approval_received">Customer launch approval received</option>
            <option value="monitoring_started">Launch monitoring started</option>
            <option value="needs_review">Needs internal review</option>
          </select>
          <label>Visibility</label>
          <select name="visible_to_client">
            <option value="true">Show in customer portal</option>
            <option value="false">Internal only</option>
          </select>
          <button class="btn" style="margin-top:14px">Add Preset Update</button>
        </form>
      </div>

      <div class="card">
        <div class="section-title"><h2>Custom Activity</h2><p class="mini">Use this when a preset does not fit.</p></div>
        <form method="POST" action="/admin/accounts/events">
          <label>Account</label><select name="account_id" required><% accountsList.forEach(function(a){ %><option value="<%= a.id %>"><%= a.business_name %></option><% }); %></select>
          <label>Type</label>
          <select name="event_type">
            <option value="update">General update</option>
            <option value="onboarding">Onboarding</option>
            <option value="ai_calling">Call follow-up</option>
            <option value="sms">Text updates</option>
            <option value="crm">Lead tracker</option>
            <option value="workflow">Booking and follow-up flow</option>
            <option value="openai">Lead review</option>
            <option value="portal">Portal</option>
            <option value="launch">Launch</option>
            <option value="billing">Billing</option>
            <option value="review">Review needed</option>
          </select>
          <label>Title</label><input name="title" required placeholder="Short customer-friendly title">
          <label>Detail Preset</label>
          <select onchange="const parts=this.value.split('|'); if(parts[0]) this.form.title.value=parts[0]; if(parts[1]) this.form.detail.value=parts[1];">
            <option value="">Choose a preset</option>
            <option value="Setup progress update|Autovyne is still connecting the required automation pieces and will update this portal as each area is ready.">Setup progress</option>
            <option value="Billing review needed|This account needs a billing review before additional service changes are made.">Billing review</option>
            <option value="Customer action needed|Autovyne needs updated information from the customer before the next setup step.">Customer action needed</option>
            <option value="Launch check complete|Autovyne completed the latest launch check and will continue monitoring the account.">Launch check complete</option>
          </select>
          <label>Detail</label><textarea name="detail" placeholder="What changed, in plain English."></textarea>
          <label>Visibility</label>
          <select name="visible_to_client">
            <option value="true">Show in customer portal</option>
            <option value="false">Internal only</option>
          </select>
          <button class="btn">Add Custom Activity</button>
        </form>
      </div>
    </section>

    <section class="recent" id="recent">
      <div class="card" id="client-requests">
        <div class="section-title"><h2>Client Action Requests</h2><a class="btn btn-ghost" href="/admin/legal-audits?status=needs_admin_review">Review Legal Audits</a></div>
        <% (snap.clientRequests || []).slice(0,6).forEach(function(r){ %>
          <div class="event">
            <strong><%= r.business_name %></strong>
            <p class="mini"><%= String(r.request_type || '').replace(/_/g, ' ') %> - <%= r.priority %> - <a href="/admin/legal-audits?status=needs_admin_review" style="color:#00e87b"><%= String(r.status || '').replace(/_/g, ' ') %> review</a><% if (r.subject_phone) { %> - <%= r.subject_phone %><% } %></p>
            <p class="mini"><%= r.reason || 'No note provided.' %></p>
            <div class="actions" style="margin-top:8px">
              <a class="btn btn-ghost" href="/admin/accounts/<%= r.account_id %>/events">Account Activity</a>
              <a class="btn btn-ghost" href="/admin/legal-audits?status=needs_admin_review">Legal Review</a>
            </div>
            <form method="POST" action="/admin/accounts/client-requests/<%= r.id %>/status" style="margin-top:10px">
              <label>Status</label>
              <select name="status">
                <option value="submitted" <%= r.status === 'submitted' ? 'selected' : '' %>>Submitted</option>
                <option value="in_review" <%= r.status === 'in_review' ? 'selected' : '' %>>In review</option>
                <option value="completed" <%= r.status === 'completed' ? 'selected' : '' %>>Completed</option>
                <option value="denied" <%= r.status === 'denied' ? 'selected' : '' %>>Denied</option>
              </select>
              <label>Admin note</label>
              <textarea name="admin_note" placeholder="What did you do or verify?"><%= r.admin_note || '' %></textarea>
              <button class="btn" style="margin-top:8px">Update Request</button>
            </form>
          </div>
        <% }); %>
        <% if (!(snap.clientRequests || []).length) { %><p class="mini">No client action requests yet.</p><% } %>
      </div>
      <div class="card">
        <h2>Recent Leads</h2>
        <% (snap.leads || []).slice(0,6).forEach(function(lead){ %><div class="event"><strong><%= lead.business_name %></strong><p class="mini">Lead - <%= lead.industry %> - $<%= Number(lead.estimated_monthly_loss || 0).toLocaleString() %> estimated monthly loss</p></div><% }); %>
        <% if (!(snap.leads || []).length) { %><p class="mini">No recent leads yet.</p><% } %>
      </div>
      <div class="card">
        <div class="section-title"><h2>Recent Questions</h2><a class="btn btn-ghost" href="/admin/questions">Open Queue</a></div>
        <% (snap.questions || []).slice(0,6).forEach(function(q){ %><div class="event"><strong><%= q.business_name || q.name %></strong><p class="mini">Question - <%= q.email %> - <%= q.status || 'new' %> - <%= q.question %></p></div><% }); %>
        <% if (!(snap.questions || []).length) { %><p class="mini">No recent questions yet.</p><% } %>
      </div>
    </section>

    <% if (selectedAccount) { %>
    <section class="card" style="margin-top:18px">
      <h2>Activity for <%= selectedAccount.business_name %></h2>
      <% selectedEvents.forEach(function(e){ %><div class="event"><strong><%= e.title %></strong><p class="mini"><%= e.event_type %> - visible: <%= e.visible_to_client ? 'yes' : 'no' %> - <%= new Date(e.created_at).toLocaleString() %></p><p><%= e.detail || '' %></p></div><% }); %>
      <% if (!selectedEvents.length) { %><p class="mini">No activity has been recorded for this account yet.</p><% } %>
    </section>
    <% } %>
  </div>
<% } %>
<script>
  (function() {
    const planSelect = document.getElementById('plan-select');
    const list = document.getElementById('plan-service-list');
    const note = document.getElementById('plan-service-note');
    if (!planSelect || !list || !note) return;

    const serviceDefinitions = <%- JSON.stringify(typeof serviceDefinitions !== 'undefined' ? serviceDefinitions : []) %>;
    const planServiceBundles = <%- JSON.stringify(typeof planServiceBundles !== 'undefined' ? planServiceBundles : {}) %>;
    const planServiceNotes = <%- JSON.stringify(typeof planServiceNotes !== 'undefined' ? planServiceNotes : {}) %>;

    function renderPlanServices() {
      const plan = planSelect.value || 'professional';
      const bundle = planServiceBundles[plan] || planServiceBundles.professional || {};
      note.textContent = planServiceNotes[plan] || planServiceNotes.professional || '';
      list.innerHTML = serviceDefinitions.map(function(service) {
        const included = Boolean(bundle[service.key]);
        return [
          '<div class="check">',
          '<span class="pill ' + (included ? 'pill-on' : '') + '">' + (included ? 'Included' : 'Not in plan') + '</span>',
          '<div><strong>' + service.label + '</strong><br><span class="mini">' + service.description + '</span></div>',
          '</div>'
        ].join('');
      }).join('');
    }

    planSelect.addEventListener('change', renderPlanServices);
    renderPlanServices();
  })();
</script>
<% if (authorized) { %>
  <%- include('partials/assistant-widget', {
    widgetId: 'admin-ai-widget',
    widgetTitle: 'Autovyne Admin AI',
    widgetSubtitle: 'Owner-level guidance across accounts, requests, and audits.',
    widgetEndpoint: '/admin/accounts/assistant.json',
    widgetLevel: 'admin',
    widgetPrompts: [
      'Give me a simple daily briefing of what needs my attention first.',
      'Which accounts or requests are under review?',
      'What legal audit items need approval?',
      'Summarize billing, consent, and automation risks.'
    ]
  }) %>
  <script src="/js/assistant-widget.js"></script>
<% } %>
</body>
</html>
