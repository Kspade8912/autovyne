<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <%- include('partials/seo-head') %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <%- themeCSS %>
  <style>
    .three-col{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
    .intake-form select{width:100%;padding:14px 16px;border:1px solid rgba(255,255,255,.12);border-radius:14px;background:rgba(255,255,255,.05);color:#fff;font:inherit}
    .intake-form select option{background:#10131c;color:#fff}
    @media(max-width:820px){.three-col{grid-template-columns:1fr}}
  </style>
</head>
<body>
  <%- include('partials/nav') %>
  <main class="intake-container">
    <div class="intake-header">
      <div class="hero-badge">Questions &amp; Support</div>
      <h1>What do you want to automate?</h1>
      <p class="intake-sub">Ask about onboarding, call follow-up, text updates, lead tracking, bookings, or an account flow you want built.</p>
    </div>
    <section class="value-grid three-col" style="margin-bottom:28px">
      <article class="value-card"><h3>Onboarding Help</h3><p>Ask what Autovyne needs from you before call follow-up, text updates, lead tracking, or booking support can go live.</p></article>
      <article class="value-card"><h3>Account Support</h3><p>Use this for billing, portal access, service status, or setup questions. Urgent items are reviewed first.</p></article>
      <article class="value-card"><h3>Safe Follow-Up</h3><p>Text replies only happen where consent is recorded. Email remains the default support path.</p></article>
    </section>
    <% if (submitted) { %>
      <div class="success-card"><h2>Question received.</h2><p>We will follow up at the email you provided. If this affects billing, privacy, SMS consent, or automation rules, Autovyne will review it before making changes.</p></div>
    <% } else { %>
      <% if (error) { %><div class="form-error"><%= error %></div><% } %>
      <form class="intake-form" method="POST">
        <input type="text" name="_honey" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px;">
        <input type="hidden" name="_form_loaded_at" id="form-loaded-at" value="0">
        <div class="form-row two-col">
          <div class="form-group"><label for="name">Your Name <span class="required">*</span></label><input id="name" name="name" required></div>
          <div class="form-group"><label for="business_name">Business Name</label><input id="business_name" name="business_name"></div>
        </div>
        <div class="form-row two-col">
          <div class="form-group"><label for="email">Email <span class="required">*</span></label><input type="email" id="email" name="email" required></div>
          <div class="form-group"><label for="phone">Phone</label><input type="tel" id="phone" name="phone"></div>
        </div>
        <div class="form-row three-col">
          <div class="form-group">
            <label for="category">What is this about?</label>
            <select id="category" name="category">
              <option value="general">General question</option>
              <option value="signup">Signing up</option>
              <option value="billing">Billing or subscription</option>
              <option value="onboarding">Onboarding/setup</option>
              <option value="ai_calling">Call follow-up</option>
              <option value="sms">Text follow-up</option>
              <option value="crm">Lead tracking or booking flow</option>
              <option value="support">Support</option>
            </select>
          </div>
          <div class="form-group">
            <label for="urgency">How soon?</label>
            <select id="urgency" name="urgency">
              <option value="normal">Normal</option>
              <option value="soon">Soon</option>
              <option value="urgent">Urgent</option>
            </select>
          </div>
          <div class="form-group">
            <label for="contact_preference">Best reply method</label>
            <select id="contact_preference" name="contact_preference">
              <option value="email">Email</option>
              <option value="phone">Phone call</option>
              <option value="sms">Text message, if I opt in</option>
            </select>
          </div>
        </div>
        <div class="sms-consent">
          <input type="checkbox" id="sms_consent" name="sms_consent" value="true">
          <label for="sms_consent">By checking this box, I consent to receive SMS messages from Autovyne related to my account, audit request, onboarding, missed-call automation, and service updates. Message frequency varies. Message and data rates may apply. Reply STOP to opt out and HELP for help. Consent is not a condition of purchase. View our <a href="/privacy" target="_blank">Privacy Policy</a> and <a href="/sms-terms" target="_blank">SMS Terms</a>.</label>
        </div>
        <div class="form-row form-group"><label for="question">Question <span class="required">*</span></label><textarea id="question" name="question" rows="7" required placeholder="Tell us what you need help with..."></textarea></div>
        <button class="btn-primary btn-large btn-full" type="submit">Submit Question</button>
      </form>
    <% } %>
  </main>
  <%- include('partials/footer') %>
  <script>document.getElementById('form-loaded-at')?.setAttribute('value', Date.now());</script>
</body>
</html>
