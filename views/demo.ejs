<script>
// ── SAFE MATH ─────────────────────────────────────────────────────────────────
function safeCalc(fn) {
  try {
    const result = fn();
    if (typeof result !== 'number' || isNaN(result) || !isFinite(result)) return 0;
    return result;
  } catch(e) {
    console.error('[safeCalc]', e);
    return 0;
  }
}

function finiteNumber(value, fallback, min, max) {
  const parsed = Number(value);
  if (!Number.isFinite(parsed)) return fallback;
  return Math.min(max, Math.max(min, parsed));
}

function normalizeModel() {
  const previous = [leads, ticket, missed, conversion];
  leads = finiteNumber(leads, 60, 1, 1000);
  ticket = finiteNumber(ticket, 250, 1, 50000);
  missed = finiteNumber(missed, 25, 0, 95);
  conversion = finiteNumber(conversion, 20, 1, 95);

  const corrected = previous.some((value, index) => value !== [leads, ticket, missed, conversion][index]);
  const status = document.getElementById('calc-status');
  if (status) status.textContent = corrected ? 'Unsafe values were replaced with valid calculator limits.' : '';
}

function fmt(n) {
  n = finiteNumber(n, 0, -Number.MAX_SAFE_INTEGER, Number.MAX_SAFE_INTEGER);
  if (n >= 1000000) return '$' + (n / 1000000).toFixed(1) + 'M';
  if (n >= 100000) return '$' + Math.round(n / 1000) + 'K';
  if (n >= 10000) return '$' + (n / 1000).toFixed(1) + 'K';
  return '$' + Math.round(n).toLocaleString();
}

function fmtPct(n) {
  n = finiteNumber(n, 0, -1000000, 1000000);
  return Math.max(0, Math.round(n)) + '%';
}

