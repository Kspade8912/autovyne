  const missedRate = safeCalc(() => missed / 100);
  const convRate = safeCalc(() => conversion / 100);

  const revenueAtRisk = safeCalc(() => leads * ticket * missedRate * 12);
  const recovered = safeCalc(() => leads * ticket * missedRate * convRate * 12);
  const cost = ANNUAL_COST;
  const netSavings = safeCalc(() => recovered - cost);
  const roiPct = safeCalc(() => cost > 0 ? ((recovered - cost) / cost) * 100 : 0);

  return { revenueAtRisk, recovered, cost, netSavings, roiPct };
}

function updateKPIs() {
  const roi = calcROI();
  document.getElementById('kpi-risk').textContent = fmt(roi.revenueAtRisk);
  document.getElementById('kpi-recovered').textContent = fmt(roi.recovered);
  document.getElementById('kpi-cost').textContent = fmt(roi.cost);
  document.getElementById('kpi-savings').textContent = fmt(roi.netSavings);
  document.getElementById('kpi-roi').textContent = fmtPct(roi.roiPct);
  // Color ROI based on value
  const roiEl = document.getElementById('kpi-roi');
  roiEl.className = 'kpi-value ' + (roi.roiPct >= 100 ? 'kpi-value--accent' : 'kpi-value--warn');

  // Update tracker (12-month annual view from current slider values)
  updateRevenueTracker();
}

function updateRevenueTracker() {
  const roi = calcROI();
  // Without = revenue NOT at risk (answered + converted)
  const withoutAnnual = safeCalc(() => leads * (1 - missed/100) * (conversion/100) * ticket * 12);
  const withAnnual = safeCalc(() => (leads * (1 - missed/100) * (conversion/100) * ticket * 12) + roi.recovered);

  const withoutDisplay = fmt(withoutAnnual);
  const withDisplay = fmt(withAnnual);

  document.getElementById('tracker-without').textContent = withoutDisplay;
  document.getElementById('tracker-with').textContent = withDisplay;
  document.getElementById('tracker-without-sub').textContent = 'annual (no missed calls)';
  document.getElementById('tracker-with-sub').textContent = 'annual (with AI recovery)';

  const delta = withAnnual - withoutAnnual;
  const deltaEl = document.getElementById('tracker-delta');
  deltaEl.textContent = '+' + fmt(delta) + ' more revenue';
  deltaEl.classList.toggle('hide', delta <= 0);
}

// ── CHART ─────────────────────────────────────────────────────────────────────
function drawChart() {
  const canvas = document.getElementById('chart-canvas');
  if (!canvas) return;

  const rect = canvas.getBoundingClientRect();
  if (!rect || rect.width === 0 || rect.height === 0) {
    return;
  }

  const dpr = window.devicePixelRatio || 1;
  canvas.width = rect.width * dpr;
  canvas.height = rect.height * dpr;

  const ctx = canvas.getContext('2d');
  if (!ctx) return;
  ctx.scale(dpr, dpr);
  const W = rect.width;
  const H = rect.height;

  // Clear
  ctx.clearRect(0, 0, W, H);

  // Build monthly data
  const missedRate = safeCalc(() => missed / 100);
  const convRate = safeCalc(() => conversion / 100);
  const monthlyWithout = [];
  const monthlyWith = [];

  for (let m = 1; m <= 12; m++) {
    const without = safeCalc(() => leads * ticket * (1 - missedRate) * convRate);
    const recovered = safeCalc(() => leads * ticket * missedRate * convRate);
    const withAI = safeCalc(() => without + recovered);
    monthlyWithout.push(without);
    monthlyWith.push(withAI);
  }

  // Find max for scaling
  const maxVal = Math.max(1, safeCalc(() => Math.max(
    monthlyWithout.reduce((a, b) => a + b, 0),
    monthlyWith.reduce((a, b) => a + b, 0),
    1
  )));

  // Chart area
  const padL = 52, padR = 16, padT = 16, padB = 32;
  const chartW = W - padL - padR;
  const chartH = H - padT - padB;

  // Y-axis labels
  ctx.fillStyle = '#7878a0';
  ctx.font = '11px JetBrains Mono, monospace';
  ctx.textAlign = 'right';
  ctx.textBaseline = 'middle';

  const ySteps = 4;
  for (let i = 0; i <= ySteps; i++) {
    const val = (maxVal / ySteps) * i;
    const y = padT + chartH - (i / ySteps) * chartH;
    ctx.fillText(fmt(val), padL - 6, y);
    // Grid line
    if (i > 0) {
      ctx.strokeStyle = 'rgba(255,255,255,0.05)';
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(padL, y);
      ctx.lineTo(padL + chartW, y);
      ctx.stroke();
    }
  }

  // Bar layout
  const n = 12;
  const groupW = chartW / n;
  const barW = groupW * 0.35;
  const gap = groupW * 0.05;
  const barOffset = (groupW - barW * 2 - gap) / 2;

  for (let i = 0; i < n; i++) {
    const x = padL + i * groupW + barOffset;
    const cumulativeWithout = monthlyWithout.slice(0, i + 1).reduce((a, b) => a + b, 0);
    const cumulativeWith = monthlyWith.slice(0, i + 1).reduce((a, b) => a + b, 0);

    const hWithout = safeCalc(() => (cumulativeWithout / maxVal) * chartH);
    const hWith = safeCalc(() => (cumulativeWith / maxVal) * chartH);

    const baseY = padT + chartH;

    // Without (red, stacked bars)
    ctx.fillStyle = '#ef4444';
    ctx.fillRect(x, baseY - hWithout, barW, hWithout);

    // With (green, stacked on top of without)
    ctx.fillStyle = '#22c55e';
    ctx.fillRect(x + barW + gap, baseY - hWith, barW, hWith);

    // X-axis month labels
    ctx.fillStyle = '#7878a0';
    ctx.font = '10px JetBrains Mono, monospace';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'top';
    ctx.fillText('M' + (i + 1), x + barW, baseY + 6);
  }
}

// Redraw chart on any slider change
let chartRAF = null;
function scheduleChartRedraw() {
  if (chartRAF) cancelAnimationFrame(chartRAF);
  chartRAF = requestAnimationFrame(drawChart);
}

// ── SLIDER BINDING ────────────────────────────────────────────────────────────
function bindSlider(id, fillId, valId, fmtFn, onUpdate) {
  const slider = document.getElementById(id);
  const fill = document.getElementById(fillId);
  const valEl = document.getElementById(valId);
  if (!slider || !fill || !valEl) return;

  slider.addEventListener('input', function() {
    const min = finiteNumber(slider.min, 0, -Number.MAX_SAFE_INTEGER, Number.MAX_SAFE_INTEGER);
    const max = finiteNumber(slider.max, min + 1, min + 1, Number.MAX_SAFE_INTEGER);
    const v = finiteNumber(slider.value, min, min, max);
    slider.value = v;
    const pct = ((v - min) / (max - min)) * 100;
    fill.style.width = pct + '%';
    valEl.textContent = fmtFn(v);
    if (onUpdate) onUpdate(v);
    updateKPIs();
    scheduleChartRedraw();
  });

  // Init fill
  const min = finiteNumber(slider.min, 0, -Number.MAX_SAFE_INTEGER, Number.MAX_SAFE_INTEGER);
  const max = finiteNumber(slider.max, min + 1, min + 1, Number.MAX_SAFE_INTEGER);
  const initialValue = finiteNumber(slider.value, min, min, max);
  const initPct = ((initialValue - min) / (max - min)) * 100;
  fill.style.width = initPct + '%';
  valEl.textContent = fmtFn(initialValue);
}

function setSlider(id, fillId, valId, value, fmtFn) {
  const slider = document.getElementById(id);
  const fill = document.getElementById(fillId);
  const valEl = document.getElementById(valId);
  if (!slider) return;
  const min = finiteNumber(slider.min, 0, -Number.MAX_SAFE_INTEGER, Number.MAX_SAFE_INTEGER);
  const max = finiteNumber(slider.max, min + 1, min + 1, Number.MAX_SAFE_INTEGER);
  const safeValue = finiteNumber(value, min, min, max);
  slider.value = safeValue;
  const pct = ((safeValue - min) / (max - min)) * 100;
  if (fill) fill.style.width = pct + '%';
  if (valEl) valEl.textContent = fmtFn(safeValue);
}

// ── INIT SLIDERS ──────────────────────────────────────────────────────────────
function initSliders() {
  bindSlider('slider-leads', 'fill-leads', 'val-leads',
    v => Math.round(v).toLocaleString(),
    v => { leads = v; });

  bindSlider('slider-ticket', 'fill-ticket', 'val-ticket',
    v => '$' + Math.round(v).toLocaleString(),
    v => { ticket = v; });

  bindSlider('slider-missed', 'fill-missed', 'val-missed',
    v => Math.round(v) + '%',
    v => { missed = v; });

  bindSlider('slider-conversion', 'fill-conversion', 'val-conversion',
    v => Math.round(v) + '%',
    v => { conversion = v; });
}

// ── URL PARAMS ────────────────────────────────────────────────────────────────
function loadURLParams() {
  const params = new URLSearchParams(window.location.search);
  if (params.has('leads')) leads = finiteNumber(params.get('leads'), leads, 1, 1000);
  if (params.has('ticket')) ticket = finiteNumber(params.get('ticket'), ticket, 1, 50000);
  if (params.has('missed')) missed = finiteNumber(params.get('missed'), missed, 0, 95);
  if (params.has('conversion')) conversion = finiteNumber(params.get('conversion'), conversion, 1, 95);

  setSlider('slider-leads', 'fill-leads', 'val-leads', leads, v => Math.round(v).toLocaleString());
  setSlider('slider-ticket', 'fill-ticket', 'val-ticket', ticket, v => '$' + Math.round(v).toLocaleString());
  setSlider('slider-missed', 'fill-missed', 'val-missed', missed, v => Math.round(v) + '%');
  setSlider('slider-conversion', 'fill-conversion', 'val-conversion', conversion, v => Math.round(v) + '%');
}

// ── INDUSTRY PRESET ───────────────────────────────────────────────────────────
document.getElementById('industry-select').addEventListener('change', function() {
  const key = this.value;
  if (PRESETS[key]) {
    const p = PRESETS[key];
    leads = p.leads;
    ticket = p.ticket;
    missed = p.missed;
    conversion = p.conversion;

    setSlider('slider-leads', 'fill-leads', 'val-leads', leads, v => Math.round(v).toLocaleString());
    setSlider('slider-ticket', 'fill-ticket', 'val-ticket', ticket, v => '$' + Math.round(v).toLocaleString());
    setSlider('slider-missed', 'fill-missed', 'val-missed', missed, v => Math.round(v) + '%');
    setSlider('slider-conversion', 'fill-conversion', 'val-conversion', conversion, v => Math.round(v) + '%');

    updateKPIs();
    scheduleChartRedraw();
  }
  // Reset simulation on industry change
  window.resetSim();
});

// ── SIMULATOR (existing logic, adapted) ──────────────────────────────────────
let state = {
  playing: false, speed: 1, currentMonth: 0,
  startTime: null, pausedElapsed: 0,
  totalDurationMs: BASE_DURATION_MS,
  missedCalls: 0, lostLeads: 0, lostRevenue: 0,
  answeredCalls: 0, bookedAppts: 0, capturedRevenue: 0,
  events: [], eventIndex: 0, monthlyStats: []
};
let rafId = null;

function generateEvents(vertical) {
  const v = VERTICALS[vertical] || VERTICALS['hvac'];
  const events = [];
  const monthDuration = BASE_DURATION_MS / 12;
  let nameIndex = 0;
  const mRate = missed / 100;
  const cRate = conversion / 100;

  for (let m = 0; m < 12; m++) {
    const monthStart = m * monthDuration;
    const callsThisMonth = leads + Math.floor((Math.random() - 0.5) * leads * 0.2);
    const displayCalls = Math.min(callsThisMonth, 14);

    for (let i = 0; i < displayCalls; i++) {
      const t = monthStart + (i / displayCalls) * monthDuration * 0.9 + Math.random() * monthDuration * 0.05;
      const name = v.callerNames[nameIndex % v.callerNames.length];
      nameIndex++;
      const isMissed = Math.random() < mRate;

      events.push({
        time: t, month: m + 1, name, isMissed,
        missedReason: v.missedReasons[Math.floor(Math.random() * v.missedReasons.length)],
        captureAction: v.captureActions[Math.floor(Math.random() * v.captureActions.length)],
        ticket: ticket * (0.85 + Math.random() * 0.30),
        converted: Math.random() < cRate,
        callerType: v.callerType,
        captureRate: v.captureRate
      });
    }
  }
  events.sort((a, b) => a.time - b.time);
  return events;
}

function simTime() {
  if (!state.playing || !state.startTime) return state.pausedElapsed;
  return state.pausedElapsed + (performance.now() - state.startTime) * state.speed;
}

function tick() {
  if (!state.playing) return;
  const elapsed = simTime();
  const month = Math.min(12, Math.floor((elapsed / BASE_DURATION_MS) * 12));

  while (state.eventIndex < state.events.length && state.events[state.eventIndex].time <= elapsed) {
    processEvent(state.events[state.eventIndex]);
    state.eventIndex++;
  }

  if (month !== state.currentMonth) {
    for (let m = state.currentMonth + 1; m <= month; m++) activateMonth(m);
    state.currentMonth = month;
  }

  updateScrubber(Math.round((elapsed / BASE_DURATION_MS) * 12));
  document.getElementById('status-without').textContent = month < 12 ? '● RUNNING — Month ' + (month || 1) : '● COMPLETE';
  document.getElementById('status-with').textContent = month < 12 ? '● AI ACTIVE — Month ' + (month || 1) : '● COMPLETE';

  if (elapsed >= BASE_DURATION_MS) { finishSim(); return; }
  rafId = requestAnimationFrame(tick);
}

function processEvent(evt) {
  const v = VERTICALS[document.getElementById('industry-select').value] || VERTICALS['hvac'];
  const timeStr = MONTH_NAMES[(evt.month - 1) % 12];

  if (evt.isMissed) {
    state.missedCalls++;
    state.lostLeads++;
    const lostRev = safeCalc(() => evt.ticket * (conversion / 100));
    state.lostRevenue += lostRev;

    addFeedEvent('feed-without', { icon: '📵', type: 'danger', name: evt.callerType + ': ' + evt.name, detail: 'Missed call — ' + evt.missedReason, time: timeStr });

    state.answeredCalls++;
    if (Math.random() < evt.captureRate) {
      state.bookedAppts++;
      state.capturedRevenue += safeCalc(() => evt.ticket * (conversion / 100));
      addFeedEvent('feed-with', { icon: '✅', type: 'accent', name: 'AI answered: ' + evt.name, detail: evt.captureAction, time: timeStr });
    } else {
      addFeedEvent('feed-with', { icon: '🤖', type: 'neutral', name: 'AI answered: ' + evt.name, detail: 'Follow-up sent — awaiting response', time: timeStr });
    }
  } else {
    if (evt.converted) {
      addFeedEvent('feed-without', { icon: '📞', type: 'neutral', name: 'Call answered: ' + evt.name, detail: 'Booked manually', time: timeStr });
      addFeedEvent('feed-with', { icon: '📞', type: 'neutral', name: 'Call answered: ' + evt.name, detail: 'AI confirmed appointment', time: timeStr });
    }
  }
  updateCounters();
}

function updateCounters() {
  document.getElementById('stat-missed').textContent = state.missedCalls.toLocaleString();
  document.getElementById('stat-lost-leads').textContent = state.lostLeads.toLocaleString();
  document.getElementById('stat-lost-revenue').textContent = '$' + Math.round(state.lostRevenue).toLocaleString();
  document.getElementById('stat-answered').textContent = state.answeredCalls.toLocaleString();
  document.getElementById('stat-booked').textContent = state.bookedAppts.toLocaleString();
  document.getElementById('stat-captured-revenue').textContent = '$' + Math.round(state.capturedRevenue).toLocaleString();
}

function addFeedEvent(feedId, { icon, type, name, detail, time }) {
  const feed = document.getElementById(feedId);
  const empty = feed.querySelector('.feed-empty');
  if (empty) empty.remove();
  const el = document.createElement('div');
  el.className = 'feed-event feed-event--' + type;
  el.innerHTML = '<span class="feed-icon">' + icon + '</span><div class="feed-text"><div class="feed-name">' + name + '</div><div class="feed-detail">' + detail + '</div></div><span class="feed-time">' + time + '</span>';
  feed.insertBefore(el, feed.firstChild);
  const events = feed.querySelectorAll('.feed-event');
  if (events.length > 30) events[events.length - 1].remove();
}

function activateMonth(m) {
  if (m < 1 || m > 12) return;
  for (let i = 1; i < m; i++) {
    const bar = document.getElementById('mcb-' + i);
    const lbl = document.getElementById('mcl-' + i);
    if (bar) { bar.classList.remove('active'); bar.classList.add('done'); }
    if (lbl) { lbl.classList.remove('active'); lbl.classList.add('done'); }
  }
  const bar = document.getElementById('mcb-' + m);
  const lbl = document.getElementById('mcl-' + m);
  if (bar) bar.classList.add('active');
  if (lbl) lbl.classList.add('active');
  document.getElementById('progress-detail').textContent = 'Simulating Month ' + m + ' of 12 — ' + MONTH_NAMES[m - 1];
}

function updateScrubber(month) {
  const input = document.getElementById('scrubber-input');
  const fill = document.getElementById('scrubber-fill');
  const label = document.getElementById('scrubber-label');
  input.value = month;
  fill.style.width = (month / 12 * 100) + '%';
  label.textContent = month === 0 ? 'Start' : (month === 12 ? 'Year End' : 'Month ' + month + ' of 12');
  for (let i = 0; i <= 12; i++) {
    const el = document.getElementById('sm-' + i);
    if (el) el.classList.toggle('current', i === month);
  }
}

function finishSim() {
  state.playing = false;
  state.pausedElapsed = BASE_DURATION_MS;
  state.currentMonth = 12;
  for (let i = 1; i <= 12; i++) {
    const bar = document.getElementById('mcb-' + i);
    const lbl = document.getElementById('mcl-' + i);
    if (bar) { bar.classList.remove('active'); bar.classList.add('done'); }
    if (lbl) { lbl.classList.remove('active'); lbl.classList.add('done'); }
  }
  updateScrubber(12);
  document.getElementById('progress-detail').textContent = 'Year complete!';
  document.getElementById('status-without').textContent = '● COMPLETE';
  document.getElementById('status-with').textContent = '● COMPLETE';
  const playBtn = document.getElementById('play-btn');
  playBtn.classList.remove('playing');
  playBtn.querySelector('.play-icon').textContent = '▶';
  playBtn.querySelector('.play-text').textContent = 'Replay';
  showFinalSummary();
  if (rafId) { cancelAnimationFrame(rafId); rafId = null; }
}

function showFinalSummary() {
  const v = VERTICALS[document.getElementById('industry-select').value] || VERTICALS['hvac'];
  document.getElementById('final-industry-note').textContent = v.label + ' — 12-month simulation';
  document.getElementById('final-missed').textContent = state.missedCalls.toLocaleString();
  document.getElementById('final-answered').textContent = state.answeredCalls.toLocaleString();
  document.getElementById('final-booked').textContent = state.bookedAppts.toLocaleString();
  document.getElementById('final-recovered').textContent = '$' + Math.round(state.capturedRevenue).toLocaleString();
  document.getElementById('final-summary').classList.add('visible');
  document.getElementById('final-summary').scrollIntoView({ behavior: 'smooth', block: 'start' });
}

// ── CONTROLS ──────────────────────────────────────────────────────────────────
window.togglePlay = function() {
  if (state.currentMonth >= 12) { resetSim(); setTimeout(() => startPlay(), 100); return; }
  if (state.playing) pauseSim(); else startPlay();
};

function startPlay() {
  if (state.events.length === 0) {
    state.events = generateEvents(document.getElementById('industry-select').value);
  }
  state.playing = true;
  state.startTime = performance.now();
  const playBtn = document.getElementById('play-btn');
  playBtn.classList.add('playing');
  playBtn.querySelector('.play-icon').textContent = '⏸';
  playBtn.querySelector('.play-text').textContent = 'Pause';
  rafId = requestAnimationFrame(tick);
}

function pauseSim() {
  state.playing = false;
  state.pausedElapsed = simTime();
  state.startTime = null;
  if (rafId) { cancelAnimationFrame(rafId); rafId = null; }
  const playBtn = document.getElementById('play-btn');
  playBtn.classList.remove('playing');
  playBtn.querySelector('.play-icon').textContent = '▶';
  playBtn.querySelector('.play-text').textContent = 'Resume';
}

window.resetSim = function() {
  if (rafId) { cancelAnimationFrame(rafId); rafId = null; }
  state = {
    playing: false, speed: state.speed, currentMonth: 0, startTime: null, pausedElapsed: 0,
    totalDurationMs: BASE_DURATION_MS,
    missedCalls: 0, lostLeads: 0, lostRevenue: 0,
    answeredCalls: 0, bookedAppts: 0, capturedRevenue: 0,
    events: [], eventIndex: 0, monthlyStats: []
  };
  const playBtn = document.getElementById('play-btn');
  playBtn.classList.remove('playing');
  playBtn.querySelector('.play-icon').textContent = '▶';
  playBtn.querySelector('.play-text').textContent = 'Play Year';
  updateScrubber(0);
  document.getElementById('feed-without').innerHTML = '<div class="feed-empty"><div class="empty-icon">📵</div><div>Hit Play to start the simulation</div></div>';
  document.getElementById('feed-with').innerHTML = '<div class="feed-empty"><div class="empty-icon">🤖</div><div>AI is standing by...</div></div>';
  for (let i = 1; i <= 12; i++) {
    const bar = document.getElementById('mcb-' + i);
    const lbl = document.getElementById('mcl-' + i);
    if (bar) bar.classList.remove('active', 'done');
    if (lbl) lbl.classList.remove('active', 'done');
  }
  document.getElementById('progress-detail').textContent = 'Click Play to begin';
  document.getElementById('status-without').textContent = '● IDLE';
  document.getElementById('status-with').textContent = '● IDLE';
  document.getElementById('final-summary').classList.remove('visible');
  document.getElementById('stat-missed').textContent = '0';
  document.getElementById('stat-lost-leads').textContent = '0';
  document.getElementById('stat-lost-revenue').textContent = '$0';
  document.getElementById('stat-answered').textContent = '0';
  document.getElementById('stat-booked').textContent = '0';
  document.getElementById('stat-captured-revenue').textContent = '$0';
  document.getElementById('tracker-without').textContent = '$0';
  document.getElementById('tracker-with').textContent = '$0';
  document.getElementById('tracker-without-sub').textContent = '—';
  document.getElementById('tracker-with-sub').textContent = '—';
  document.getElementById('tracker-delta').classList.add('hide');
};

window.setSpeed = function(speed) {
  const wasPlaying = state.playing;
  if (wasPlaying) pauseSim();
  state.speed = speed;
  document.querySelectorAll('.speed-btn').forEach(btn => {
    btn.classList.toggle('active', parseInt(btn.dataset.speed) === speed);
  });
  if (wasPlaying) startPlay();
};

window.scrubTo = function(month) {
  const wasPlaying = state.playing;
  if (wasPlaying) pauseSim();
  month = parseInt(month);
  window.resetSim();
  if (month === 0) return;
  state.events = generateEvents(document.getElementById('industry-select').value);
  const targetTime = (month / 12) * BASE_DURATION_MS;
  for (let i = 0; i < state.events.length; i++) {
    if (state.events[i].time > targetTime) break;
    processEventSilent(state.events[i]);
    state.eventIndex = i + 1;
  }
  state.currentMonth = month;
  state.pausedElapsed = targetTime;
  for (let m = 1; m <= month; m++) {
    const bar = document.getElementById('mcb-' + m);
    const lbl = document.getElementById('mcl-' + m);
    if (bar) { bar.classList.remove('active'); bar.classList.add('done'); }
    if (lbl) { lbl.classList.remove('active'); lbl.classList.add('done'); }
  }
  updateScrubber(month);
  document.getElementById('progress-detail').textContent = month === 12 ? 'Year complete!' : 'Jumped to Month ' + month + ' of 12 — ' + MONTH_NAMES[month - 1];
  document.getElementById('status-without').textContent = month < 12 ? '● PAUSED — Month ' + month : '● COMPLETE';
  document.getElementById('status-with').textContent = month < 12 ? '● AI PAUSED — Month ' + month : '● COMPLETE';
  updateCounters();
  if (month === 12) showFinalSummary();
};

function processEventSilent(evt) {
  if (evt.isMissed) {
    state.missedCalls++;
    state.lostLeads++;
    state.lostRevenue += safeCalc(() => evt.ticket * (conversion / 100));
    state.answeredCalls++;
    if (Math.random() < evt.captureRate) {
      state.bookedAppts++;
      state.capturedRevenue += safeCalc(() => evt.ticket * (conversion / 100));
    }
  }
}

// ── INIT ──────────────────────────────────────────────────────────────────────
(function init() {
  loadURLParams();
  initSliders();
  updateKPIs();

  // Draw chart after a brief delay to ensure layout is complete
  requestAnimationFrame(() => {
    requestAnimationFrame(() => {
      drawChart();
    });
  });

  // Redraw chart on window resize
  window.addEventListener('resize', () => {
    scheduleChartRedraw();
  });

  const chartWrap = document.querySelector('.chart-wrap');
  if (chartWrap && 'ResizeObserver' in window) {
    new ResizeObserver(scheduleChartRedraw).observe(chartWrap);
  }
})();
</script>
</body>
</html>
