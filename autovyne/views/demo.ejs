  },
  'medical-and-dental': {
    label: 'Medical & Dental',
    callerNames: ['Patricia H.','Barbara C.','Linda W.','Susan M.','Dorothy T.','Sandra L.','Carol F.','Ruth S.','Sharon B.','Margaret P.','Kathleen N.','Christine G.','Deborah A.','Virginia E.','Joyce O.','Evelyn D.','Frances J.','Helen R.','Shirley K.','Anna V.'],
    missedReasons: ['in with a patient — unavailable','front desk overwhelmed','after clinic hours','all lines busy','nobody at the desk'],
    captureActions: ['AI answered — new patient intake started','AI answered — cleaning appointment booked','AI answered — check-up scheduled next week','AI answered — pain consult — same-day slot given','AI answered — X-ray appointment confirmed'],
    leads: 60,
    ticket: 220,
    missedPct: 30,
    conversion: 50,
    captureRate: 0.60,
    callerType: 'Patient'
  }
};

const MONTH_NAMES = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
// Duration for a full 12-month simulation at 1x speed (ms)
const BASE_DURATION_MS = 60000; // 60 seconds at 1x

// ── STATE ─────────────────────────────────────────────────────────────────────
let state = {
  playing: false,
  speed: 1,
  currentMonth: 0,          // 0..12
  startTime: null,
  pausedElapsed: 0,
  totalDurationMs: BASE_DURATION_MS,
  // Cumulative counters
  missedCalls: 0,
  lostLeads: 0,
  lostRevenue: 0,
  answeredCalls: 0,
  bookedAppts: 0,
  capturedRevenue: 0,
  // Event queues (pre-generated at start)
  events: [],
  eventIndex: 0,
  // Per-month stats for final summary
  monthlyStats: []
};

let rafId = null;
let lastEventTime = 0;

// ── GENERATE EVENTS ───────────────────────────────────────────────────────────
function generateEvents(vertical) {
  const v = VERTICALS[vertical];
  const events = [];
  const totalMs = BASE_DURATION_MS; // always generate at 1x time scale

  // Spread events across 12 months (each month is totalMs/12 ms)
  const monthDuration = totalMs / 12;
  let nameIndex = 0;

  for (let m = 0; m < 12; m++) {
    const monthStart = m * monthDuration;
    // Events per month ≈ leads per month (scaled for readability, max 15 visible)
    const callsThisMonth = v.leads + Math.floor((Math.random() - 0.5) * v.leads * 0.2);
    const displayCalls = Math.min(callsThisMonth, 14); // cap for feed readability

    // Spread within the month
    for (let i = 0; i < displayCalls; i++) {
      const t = monthStart + (i / displayCalls) * monthDuration * 0.9 + Math.random() * monthDuration * 0.05;
      const name = v.callerNames[nameIndex % v.callerNames.length];
      nameIndex++;
      const isMissed = Math.random() * 100 < v.missedPct;

      events.push({
        time: t,
        month: m + 1,
        name,
        isMissed,
        missedReason: v.missedReasons[Math.floor(Math.random() * v.missedReasons.length)],
        captureAction: v.captureActions[Math.floor(Math.random() * v.captureActions.length)],
        ticket: v.ticket * (0.85 + Math.random() * 0.30),
        converted: Math.random() * 100 < v.conversion,
        callerType: v.callerType
      });
    }
  }
  events.sort((a, b) => a.time - b.time);
  return events;
}

function simTime() {
  // Returns elapsed simulation time (at 1x) in ms
  if (!state.playing || !state.startTime) return state.pausedElapsed;
  return state.pausedElapsed + (performance.now() - state.startTime) * state.speed;
}

// ── RENDER LOOP ───────────────────────────────────────────────────────────────
function tick() {
  if (!state.playing) return;

  const elapsed = simTime(); // ms at 1x scale
  const month = Math.min(12, Math.floor((elapsed / BASE_DURATION_MS) * 12));

  // Process events
  while (state.eventIndex < state.events.length && state.events[state.eventIndex].time <= elapsed) {
    processEvent(state.events[state.eventIndex]);
    state.eventIndex++;
  }

  // Update month display
  if (month !== state.currentMonth) {
    for (let m = state.currentMonth + 1; m <= month; m++) {
      activateMonth(m);
    }
    state.currentMonth = month;
  }

  // Update scrubber
  const progress = Math.min(1, elapsed / BASE_DURATION_MS);
  updateScrubber(Math.round(progress * 12));

  // Update status indicators
  const v = VERTICALS[document.getElementById('industry-select').value];
  const simHour = Math.floor((elapsed / BASE_DURATION_MS) * 8760); // hours in year
  document.getElementById('status-without').textContent = month < 12 ? `● RUNNING — Month ${month || 1}` : '● COMPLETE';
  document.getElementById('status-with').textContent    = month < 12 ? `● AI ACTIVE — Month ${month || 1}` : '● COMPLETE';

  // Check if done
  if (elapsed >= BASE_DURATION_MS) {
    finishSim();
    return;
  }

  rafId = requestAnimationFrame(tick);
}

function processEvent(evt) {
  const v = VERTICALS[document.getElementById('industry-select').value];
  const simHour = evt.time / BASE_DURATION_MS * 8760;
  const timeStr = formatSimTime(evt.month);

  if (evt.isMissed) {
    // LEFT panel: missed call
    state.missedCalls++;
    const lostRevFromThisCall = evt.converted ? evt.ticket * (v.missedPct / 100) : 0;
    const missedLeadRevenue = evt.ticket * (v.conversion / 100);
    state.lostRevenue += missedLeadRevenue * (v.captureRate);
    state.lostLeads++;

    addFeedEvent('feed-without', {
      icon: '📵',
      type: 'danger',
      name: `${evt.callerType}: ${evt.name}`,
      detail: `Missed call — ${evt.missedReason}`,
      time: timeStr
    });

    // RIGHT panel: AI captures it
    state.answeredCalls++;
    const willBook = Math.random() < v.captureRate;
    if (willBook) {
      state.bookedAppts++;
      state.capturedRevenue += evt.ticket * (v.conversion / 100);
      addFeedEvent('feed-with', {
        icon: '✅',
        type: 'accent',
        name: `AI answered: ${evt.name}`,
        detail: evt.captureAction,
        time: timeStr
      });
    } else {
      addFeedEvent('feed-with', {
        icon: '🤖',
        type: 'neutral',
        name: `AI answered: ${evt.name}`,
        detail: `Follow-up message sent — awaiting response`,
        time: timeStr
      });
    }
  } else {
    // LEFT: normal answered call
    if (evt.converted) {
      addFeedEvent('feed-without', {
        icon: '📞',
        type: 'neutral',
        name: `Call answered: ${evt.name}`,
        detail: `Booked manually — ${v.callerType.toLowerCase()} converted`,
        time: timeStr
      });
    }
    // RIGHT: same call, both handled the same (this was answered regardless)
    // Only emit for the left if it was a successful conversion — right gets it too
    if (evt.converted) {
      addFeedEvent('feed-with', {
        icon: '📞',
        type: 'neutral',
        name: `Call answered: ${evt.name}`,
        detail: `AI confirmed appointment — follow-up queued`,
        time: timeStr
      });
    }
  }

  // Update counters in DOM
  updateCounters();
}

function updateCounters() {
  document.getElementById('stat-missed').textContent = state.missedCalls.toLocaleString();
  document.getElementById('stat-lost-leads').textContent = state.lostLeads.toLocaleString();
  document.getElementById('stat-lost-revenue').textContent = '$' + Math.round(state.lostRevenue).toLocaleString();
  document.getElementById('stat-answered').textContent = state.answeredCalls.toLocaleString();
  document.getElementById('stat-booked').textContent = state.bookedAppts.toLocaleString();
  document.getElementById('stat-captured-revenue').textContent = '$' + Math.round(state.capturedRevenue).toLocaleString();

  // Tracker
  const v = VERTICALS[document.getElementById('industry-select').value];
  // Without = base revenue (calls that were answered and converted)
  const baseMonthly = v.leads * (1 - v.missedPct/100) * (v.conversion/100) * v.ticket;
  const withoutRevMonthly = baseMonthly;
  const withRevMonthly = baseMonthly + (v.leads * (v.missedPct/100) * v.captureRate * (v.conversion/100) * v.ticket);
  const monthsElapsed = state.currentMonth || 1;
  const withoutTotal = withoutRevMonthly * monthsElapsed;
  const withTotal = withRevMonthly * monthsElapsed;

  document.getElementById('tracker-without').textContent = '$' + Math.round(withoutTotal).toLocaleString();
  document.getElementById('tracker-with').textContent = '$' + Math.round(withTotal).toLocaleString();
  document.getElementById('tracker-without-sub').textContent = `across ${monthsElapsed} month${monthsElapsed !== 1 ? 's' : ''}`;
  document.getElementById('tracker-with-sub').textContent = `across ${monthsElapsed} month${monthsElapsed !== 1 ? 's' : ''}`;

  const delta = withTotal - withoutTotal;
  const deltaEl = document.getElementById('tracker-delta');
  deltaEl.textContent = '+$' + Math.round(delta).toLocaleString() + ' more revenue';
  deltaEl.classList.toggle('hide', delta <= 0);
}

function addFeedEvent(feedId, { icon, type, name, detail, time }) {
  const feed = document.getElementById(feedId);
  // Remove empty state if present
  const empty = feed.querySelector('.feed-empty');
  if (empty) empty.remove();

  const el = document.createElement('div');
  el.className = `feed-event feed-event--${type}`;
  el.innerHTML = `
    <span class="feed-icon">${icon}</span>
    <div class="feed-text">
      <div class="feed-name">${name}</div>
      <div class="feed-detail">${detail}</div>
    </div>
    <span class="feed-time">${time}</span>
  `;

  // Insert at top (feed is column-reverse)
  feed.insertBefore(el, feed.firstChild);

  // Keep feed manageable — remove old events if too many
  const events = feed.querySelectorAll('.feed-event');
  if (events.length > 30) {
    events[events.length - 1].remove();
  }
}

function formatSimTime(month) {
  return MONTH_NAMES[(month - 1) % 12];
}

function activateMonth(m) {
  if (m < 1 || m > 12) return;
  // Previous months done
  for (let i = 1; i < m; i++) {
    const bar = document.getElementById('mcb-' + i);
    const lbl = document.getElementById('mcl-' + i);
    if (bar) { bar.classList.remove('active'); bar.classList.add('done'); }
    if (lbl) { lbl.classList.remove('active'); lbl.classList.add('done'); }
  }
  // Current month active
  const bar = document.getElementById('mcb-' + m);
  const lbl = document.getElementById('mcl-' + m);
  if (bar) { bar.classList.add('active'); }
  if (lbl) { lbl.classList.add('active'); }
  document.getElementById('progress-detail').textContent = `Simulating Month ${m} of 12 — ${MONTH_NAMES[m-1]}`;
}

function updateScrubber(month) {
  const input = document.getElementById('scrubber-input');
  const fill = document.getElementById('scrubber-fill');
  const label = document.getElementById('scrubber-label');
  input.value = month;
  fill.style.width = (month / 12 * 100) + '%';
  label.textContent = month === 0 ? 'Start' : (month === 12 ? 'Year End' : `Month ${month} of 12`);

  // Update label highlights
  for (let i = 0; i <= 12; i++) {
    const el = document.getElementById('sm-' + i);
    if (el) el.classList.toggle('current', i === month);
  }
}

function finishSim() {
  state.playing = false;
  state.pausedElapsed = BASE_DURATION_MS;
  state.currentMonth = 12;

  // Final cleanup of month bars
  for (let i = 1; i <= 12; i++) {
    const bar = document.getElementById('mcb-' + i);
    const lbl = document.getElementById('mcl-' + i);
    if (bar) { bar.classList.remove('active'); bar.classList.add('done'); }
    if (lbl) { lbl.classList.remove('active'); lbl.classList.add('done'); }
  }
  updateScrubber(12);
  document.getElementById('progress-detail').textContent = 'Year complete!';
  document.getElementById('status-without').textContent = '● COMPLETE';
  document.getElementById('status-with').textContent = '● COMPLETE';

  const playBtn = document.getElementById('play-btn');
  playBtn.classList.remove('playing');
  playBtn.querySelector('.play-icon').textContent = '▶';
  playBtn.querySelector('.play-text').textContent = 'Replay';

  // Show final summary
  showFinalSummary();
  if (rafId) { cancelAnimationFrame(rafId); rafId = null; }
}

function showFinalSummary() {
  const v = VERTICALS[document.getElementById('industry-select').value];
  document.getElementById('final-industry-note').textContent = `${v.label} — 12-month simulation complete`;
  document.getElementById('final-missed').textContent = state.missedCalls.toLocaleString();
  document.getElementById('final-answered').textContent = state.answeredCalls.toLocaleString();
  document.getElementById('final-booked').textContent = state.bookedAppts.toLocaleString();
  document.getElementById('final-recovered').textContent = '$' + Math.round(state.capturedRevenue).toLocaleString();
  document.getElementById('final-summary').classList.add('visible');
  document.getElementById('final-summary').scrollIntoView({ behavior: 'smooth', block: 'start' });
}

// ── CONTROLS ──────────────────────────────────────────────────────────────────
window.togglePlay = function() {
  if (state.currentMonth >= 12) {
    // Replay
    resetSim();
    setTimeout(() => startPlay(), 100);
    return;
  }
  if (state.playing) {
    pauseSim();
  } else {
    startPlay();
  }
};

function startPlay() {
  if (state.events.length === 0) {
    // First play — generate events
    state.events = generateEvents(document.getElementById('industry-select').value);
  }
  state.playing = true;
  state.startTime = performance.now();
  const playBtn = document.getElementById('play-btn');
  playBtn.classList.add('playing');
  playBtn.querySelector('.play-icon').textContent = '⏸';
  playBtn.querySelector('.play-text').textContent = 'Pause';
  rafId = requestAnimationFrame(tick);
}

function pauseSim() {
  state.playing = false;
  state.pausedElapsed = simTime();
  state.startTime = null;
  if (rafId) { cancelAnimationFrame(rafId); rafId = null; }
  const playBtn = document.getElementById('play-btn');
  playBtn.classList.remove('playing');
  playBtn.querySelector('.play-icon').textContent = '▶';
  playBtn.querySelector('.play-text').textContent = 'Resume';
}

window.resetSim = function() {
  if (rafId) { cancelAnimationFrame(rafId); rafId = null; }
  state = {
    playing: false,
    speed: state.speed,
    currentMonth: 0,
    startTime: null,
    pausedElapsed: 0,
    totalDurationMs: BASE_DURATION_MS,
    missedCalls: 0, lostLeads: 0, lostRevenue: 0,
    answeredCalls: 0, bookedAppts: 0, capturedRevenue: 0,
    events: [],
    eventIndex: 0,
    monthlyStats: []
  };

  const playBtn = document.getElementById('play-btn');
  playBtn.classList.remove('playing');
  playBtn.querySelector('.play-icon').textContent = '▶';
  playBtn.querySelector('.play-text').textContent = 'Play Year';

  // Reset counters
  updateCounters();
  updateScrubber(0);

  // Reset feeds
  document.getElementById('feed-without').innerHTML = '<div class="feed-empty"><div class="empty-icon">📵</div><div>Hit Play to start the simulation</div></div>';
  document.getElementById('feed-with').innerHTML = '<div class="feed-empty"><div class="empty-icon">🤖</div><div>AI is standing by...</div></div>';

  // Reset month bars
  for (let i = 1; i <= 12; i++) {
    const bar = document.getElementById('mcb-' + i);
    const lbl = document.getElementById('mcl-' + i);
    if (bar) { bar.classList.remove('active', 'done'); }
    if (lbl) { lbl.classList.remove('active', 'done'); }
  }
  document.getElementById('progress-detail').textContent = 'Click Play to begin';
  document.getElementById('status-without').textContent = '● IDLE';
  document.getElementById('status-with').textContent = '● IDLE';
  document.getElementById('final-summary').classList.remove('visible');

  // Reset counters to 0
  document.getElementById('stat-missed').textContent = '0';
  document.getElementById('stat-lost-leads').textContent = '0';
  document.getElementById('stat-lost-revenue').textContent = '$0';
  document.getElementById('stat-answered').textContent = '0';
  document.getElementById('stat-booked').textContent = '0';
  document.getElementById('stat-captured-revenue').textContent = '$0';
  document.getElementById('tracker-without').textContent = '$0';
  document.getElementById('tracker-with').textContent = '$0';
  document.getElementById('tracker-without-sub').textContent = '—';
  document.getElementById('tracker-with-sub').textContent = '—';
  document.getElementById('tracker-delta').classList.add('hide');
};

window.setSpeed = function(speed) {
  const wasPlaying = state.playing;
  if (wasPlaying) pauseSim();
  state.speed = speed;
  document.querySelectorAll('.speed-btn').forEach(btn => {
    btn.classList.toggle('active', parseInt(btn.dataset.speed) === speed);
  });
  if (wasPlaying) startPlay();
};

window.scrubTo = function(month) {
  // Pause, jump to month
  const wasPlaying = state.playing;
  if (wasPlaying) pauseSim();

  month = parseInt(month);
  // Reset sim state
  window.resetSim();

  if (month === 0) return;

  // Fast-forward by processing all events up to that month
  state.events = generateEvents(document.getElementById('industry-select').value);
  const targetTime = (month / 12) * BASE_DURATION_MS;

  // Process all events up to target time silently
  for (let i = 0; i < state.events.length; i++) {
    if (state.events[i].time > targetTime) break;
    processEventSilent(state.events[i]);
    state.eventIndex = i + 1;
  }

  state.currentMonth = month;
  state.pausedElapsed = targetTime;

  // Update month bars
  for (let m = 1; m <= month; m++) {
    const bar = document.getElementById('mcb-' + m);
    const lbl = document.getElementById('mcl-' + m);
    if (bar) { bar.classList.remove('active'); bar.classList.add('done'); }
    if (lbl) { lbl.classList.remove('active'); lbl.classList.add('done'); }
  }
  if (month < 12) {
    const bar = document.getElementById('mcb-' + month);
    if (bar) { bar.classList.add('active'); bar.classList.remove('done'); }
  }

  updateScrubber(month);
  document.getElementById('progress-detail').textContent = month === 12 ? 'Year complete!' : `Jumped to Month ${month} of 12 — ${MONTH_NAMES[month-1]}`;
  document.getElementById('status-without').textContent = month < 12 ? `● PAUSED — Month ${month}` : '● COMPLETE';
  document.getElementById('status-with').textContent    = month < 12 ? `● AI PAUSED — Month ${month}` : '● COMPLETE';
  updateCounters();

  if (month === 12) showFinalSummary();
};

// Process event silently (no DOM feed update) for scrubber seek
function processEventSilent(evt) {
  const v = VERTICALS[document.getElementById('industry-select').value];
  if (evt.isMissed) {
    state.missedCalls++;
    state.lostLeads++;
    const missedLeadRevenue = evt.ticket * (v.conversion / 100);
    state.lostRevenue += missedLeadRevenue * v.captureRate;
    state.answeredCalls++;
    if (Math.random() < v.captureRate) {
      state.bookedAppts++;
      state.capturedRevenue += evt.ticket * (v.conversion / 100);
    }
  }
}

// Industry change resets sim
document.getElementById('industry-select').addEventListener('change', function() {
  window.resetSim();
});

// ── INIT ──────────────────────────────────────────────────────────────────────
updateCounters();
</script>
</body>
</html>
